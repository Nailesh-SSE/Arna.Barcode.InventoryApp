    //         ShowError($"Failed to export excel: {ex.Message}");
    //     }
    //     finally
    //     {
    //         isExporting = false;
    //         StateHasChanged();
    //     }
    // }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }
    #endregion

    #region Item Management
    private async Task ShowItemModal(OutwardModel outward)
    {
        try
        {
            if (CanCreate(Route))
            {
                disableitemfields = false;
            }
            else
            {
                disableitemfields = true;
            }
            selectedOutward = outward;
            itemList = (await OutwardService.GetOutwardDetailsByOutwardIdAsync(outward.Id)).OrderByDescending(x => x.Id).ToList();
            newItem = new OutWardItemModel();
            barcodeErrorMessage = string.Empty;
            isScanning = false;
            InitializeItemEditContext();

            await itemModal.ShowAsync();

            // Give the modal time to render before focusing
            await Task.Delay(150);

            if (selectedOutward.IsFinished == false)
            {
                if (barcodeInput.Element.HasValue)
                {
                    await barcodeInput.Element.Value.FocusAsync();
                }
            }
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task AddItemToList()
    {
        if (isItemSaveBtnLoading) return;
        try
        {
            isItemSaveBtnLoading = true;
            barcodeErrorMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(newItem.BarcodeNo))
            {
                barcodeErrorMessage = "Please enter a barcode.";
                return;
            }

            if (selectedOutward == null)
            {
                barcodeErrorMessage = "No outward selected.";
                return;
            }

            var validationResult = await OutwardService.ValidateBarcodeForOutwardAsync(newItem.BarcodeNo, selectedOutward.Id);

            if (!validationResult.IsValid)
            {
                barcodeErrorMessage = validationResult.ErrorMessage;
                return;
            }

            var userid = Convert.ToInt32(CurrentUserId);
            var item = await OutwardService.AddOutwardItemAsync(selectedOutward.Id, newItem.BarcodeNo, userid);

            if (item != null)
            {
                itemList.Add(item);
                itemList = itemList.OrderByDescending(x => x.Id).ToList();
                newItem = new OutWardItemModel();
                InitializeItemEditContext();

                isScanning = false;
                StateHasChanged();

                if (barcodeInput.Element.HasValue)
                {
                    await barcodeInput.Element.Value.FocusAsync();
                }
            }
            else
            {
                ShowError("Connectivity issue happened, operation failed");
            }
        }
        catch (Exception ex)
        {
            if (ex.Message == "No available items in this box.")
            {
                barcodeErrorMessage = ex.Message;
            }
            else
            {
                barcodeErrorMessage = "Connectivity issue happened, operation failed";
            }
        }
        finally
        {
            isItemSaveBtnLoading = false;
        }
    }

    private async Task RemoveItem(OutWardItemModel item)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove item with barcode {item.BarcodeNo}?");
            if (!confirmed) return;

            var userid = Convert.ToInt32(CurrentUserId);
            var result = await OutwardService.DeleteOutwardItemAsync(item.Id, item.BarcodeNo, userid);

            if (result)
            {
                itemList.Remove(item);
                StateHasChanged();
            }
            else
            {
                ShowError("Connectivity issue happened, operation failed");
            }
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task HideItemModal()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;
        await itemModal.HideAsync();
        selectedOutward = null;
        itemList.Clear();
    }
    #endregion

    #region Camera Logic

    private async Task StartCameraScan()
    {
        if (isScanning) return;

        try
        {
            isScanning = true;
            dotNetHelper?.Dispose();
            dotNetHelper = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync("manageScanner.start", dotNetHelper);
        }
        catch (Exception)
        {
            isScanning = false;
            ShowError("Could not start camera");
        }
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string scannedBarcode)
    {
        barcodeErrorMessage = string.Empty;
        if (dotNetHelper == null) return;

        if (string.IsNullOrWhiteSpace(scannedBarcode))
            return;

        newItem.BarcodeNo = scannedBarcode;

        isScanning = false;

        StateHasChanged();

        await AddItemToList();
        StateHasChanged();
    }

    #endregion

    #region Validation & Helpers
    private void ValidateBillToCompany()
    {
        messageStore.Clear(() => outward.BillToCompanyId);
        if (outward.BillToCompanyId == 0)
        {
            messageStore.Add(() => outward.BillToCompanyId, "Please select a Bill To company");
        }
        editContext.NotifyValidationStateChanged();
    }
    private void OnBillToCompanySelected((int? Id, string Name) selected)
    {
        outward.BillToCompanyId = selected.Id ?? 0;
        ValidateBillToCompany();
    }
    private void ValidatePlatform()
    {
        messageStore.Clear(() => outward.PlatformId);
        if (outward.PlatformId == 0)
        {
            messageStore.Add(() => outward.PlatformId, "Please select a Platform");
        }
        editContext.NotifyValidationStateChanged();
    }
    private void OnPlatformSelected((int? Id, string Name) selected)
    {
        outward.PlatformId = selected.Id ?? 0;
        ValidatePlatform();
    }
    private void ShowError(string message)
    {
        errorMessage = message;
        showErrorMessage = true;
        StateHasChanged();

        errorTimer?.Dispose();
        errorTimer = new System.Threading.Timer(_ =>
        {
            showErrorMessage = false;
            errorMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    public async ValueTask DisposeAsync()
    {
        errorTimer?.Dispose();

        try
        {
            await JSRuntime.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }
    }

    public async Task CloseCamera()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;

        if (barcodeInput.Element.HasValue)
        {
            await barcodeInput.Element.Value.FocusAsync();
        }
    }
    #endregion
}

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<script>
    let html5QrcodeScanner;

    window.manageScanner = {
        start: (dotNetHelper) => {
            if (html5QrcodeScanner) { return; }

            html5QrcodeScanner = new Html5Qrcode("reader");

            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrcodeScanner.start({ facingMode: "environment" }, config,
                (decodedText, decodedResult) => {
                    // SUCCESS:
                    // 1. Stop the camera immediately so it doesn't scan twice
                    // 2. Clear the variable and DOM
                    // 3. Send result to C#
                    window.manageScanner.stop().then(() => {
                        dotNetHelper.invokeMethodAsync('OnBarcodeScanned', decodedText)
                            .catch(err => console.log("Blazor component disposed", err));
                    });
                },
                (errorMessage) => {
                    // ignore errors
                })
            .catch(err => {
                console.error("Error starting scanner", err);
                alert("Could not start camera. Permissions?");
            });
        },

        stop: () => {
            return new Promise((resolve, reject) => {
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        html5QrcodeScanner.clear();
                        html5QrcodeScanner = null;
                        document.getElementById("reader").innerHTML = "";
                        resolve();
                    }).catch(err => {
                        console.log("Error stopping scanner", err);
                        html5QrcodeScanner = null;
                        resolve();
                    });
                } else {
                    resolve();
                }
            });
        },
        forceStop: () => {
            if (!html5QrcodeScanner) return;

            try
            {
                html5QrcodeScanner.stop();
                html5QrcodeScanner.clear();
            }
            catch (e)
            {
                console.warn("Scanner stop error", e);
            }

            html5QrcodeScanner = null;

            const reader = document.getElementById("reader");
            if (reader) reader.innerHTML = "";
        }
    };
</script>