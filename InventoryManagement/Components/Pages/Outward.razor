@page "/outward"
@implements IAsyncDisposable
@inject IOutwardService OutwardService
@inject ICompanyService CompanyService
@inject IPlatformService PlatformService
@inject IJSRuntime JSRuntime
@inherits InventoryManagement.Components.Auth.AuthComponentBase
<PageTitle>Outward Management</PageTitle>

@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    <div class="container-fluid">
        @if (showErrorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <Icon Name="IconName.ExclamationTriangle" /> @errorMessage
            </div>
        }

        <div class="row mb-3">
            <div class="col">
                <h3><Icon Name="IconName.ArrowUpCircle" /> Outward Management</h3>
            </div>
            <div class="col-auto">
                @if (CanCreate(Route))
                {
                    <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                        <Icon Name="IconName.Plus" /> Add New Outward
                    </Button>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center">
                <Spinner Type="SpinnerType.Border" />
            </div>
        }
        else
        {
            <Grid TItem="OutwardModel" Class="table table-hover table-bordered table-striped" Data="outwards" AllowPaging="true" PageSize="10" AllowSorting="true"
                  Responsive="true" AllowFiltering=true>

                <GridColumn TItem="OutwardModel" HeaderText="No." Sortable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center" Filterable=false>
                    @(outwards.IndexOf(context) + 1)
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Outward No" PropertyName="OutwardNo" SortString="OutwardNo" SortKeySelector="item => item.OutwardNo" FilterTextboxWidth="80">
                    @context.OutwardNo
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Outward Date" PropertyName="OutwardDateOnly" SortString="OutwardDateOnly" SortKeySelector="item => item.OutwardDateOnly" FilterTextboxWidth="130">
                    @context.OutwardDate.ToString("dd/MM/yyyy hh:mm tt")
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Bill To Company" PropertyName="BillToCompanyName" SortString="BillToCompanyName" SortKeySelector="item => item.BillToCompanyName" FilterTextboxWidth="80">
                    @context.BillToCompanyName
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Platform" PropertyName="platformName" SortString="platformName" SortKeySelector="item => item.platformName" FilterTextboxWidth="80">
                    @context.platformName
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Status" PropertyName="IsActive" SortString="IsActive" SortKeySelector="item => item.IsActive" Sortable=false>
                    @if (context.IsActive)
                    {
                        <Badge Color="BadgeColor.Success">Active</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Danger">Inactive</Badge>
                    }
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Actions" Filterable=false>
                    <div class="d-flex gap-1">
                        @if (CanCreate(Route))
                        {
                            <LoadingButton Class="text-nowrap" Color="ButtonColor.Success" Size="ButtonSize.Small" onclick="() => ShowItemModal(context)">
                                @if (context.IsFinished)
                                {
                                    <Icon Name="IconName.Eye" />
                                    @: &nbsp;View Item
                                }
                                else
                                {
                                    <Icon Name="IconName.PlusCircle" />
                                    @: &nbsp;Add Item
                                }
                            </LoadingButton>
                        }
                        else
                        {
                            <LoadingButton Class="text-nowrap" Color="ButtonColor.Success" Size="ButtonSize.Small" onclick="() => ShowItemModal(context)">
                                <Icon Name="IconName.Eye" />View Item
                            </LoadingButton>
                        }
                        @if (CanEdit(Route))
                        {
                            <Button Class="text-nowrap" Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                                <Icon Name="IconName.PencilSquare" />Edit
                            </Button>
                        }
                        @if (context.IsFinished)
                        {
                            <LoadingButton Class="text-nowrap" Color="ButtonColor.Primary" Size="ButtonSize.Small" onclick="() => GeneratePdf(context)">
                                <Icon Name="IconName.FilePdf" />Pdf
                            </LoadingButton>
                        }
                    </div>
                </GridColumn>
            </Grid>
        }
    </div>
}

@* --- Add/Edit Outward Modal --- *@
<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="SaveOutward">
            <DataAnnotationsValidator />
            <fieldset disabled="@disablefields">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Outward Date <span class="text-danger">*</span></label>
                        <InputDate class="form-control" @bind-Value="DatePart" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <ValidationMessage For="@(() => outward.OutwardDate)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Outward Time</label>
                        <input type="time" class="form-control" @bind="TimePart" required />
                    </div>

                </div>
                <fieldset disabled="@isEditMode">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Bill To Company <span class="text-danger">*</span></label>
                            <DropDown TItem="CompanyModel"
                                      Items="@billCompanies.Where(c=>c.IsActive || c.Id == outward.BillToCompanyId)"
                                      SelectedId="@outward.BillToCompanyId"
                                      ValueSelector="x => x.Id"
                                      TextSelector="x => x.Name"
                                      Placeholder="-- Select Company --"
                                      OnValueChanged="OnBillToCompanySelected" />
                            <ValidationMessage For="@(() => outward.BillToCompanyId)" />

                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Platform <span class="text-danger">*</span></label>
                            <DropDown TItem="PlatformModel"
                                      Items="@platforms.Where(p=>p.IsActive || p.Id == outward.PlatformId)"
                                      SelectedId="@outward.PlatformId"
                                      ValueSelector="x => x.Id"
                                      TextSelector="x => x.Name"
                                      Placeholder="-- Select Platform --"
                                      OnValueChanged="OnPlatformSelected" />
                            <ValidationMessage For="@(() => outward.PlatformId)" />
                        </div>
                    </div>
                </fieldset>

                <div class="mt-3 ">
                    <label class="form-label">Remarks</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="outward.Remarks" />
                </div>

            </fieldset>
            @if (outward.Id > 0)
            {
                <div class="mb-3">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="outward.IsActive" id="isActive" disabled="@disablefields" />
                        <label class="form-check-label" for="isActive">Active</label>
                    </div>
                </div>
            }
            <div class="text-end mt-3">
                <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                <Button Color="ButtonColor.Primary" Type="ButtonType.Submit" disabled="@disablefields"> @(outward.Id > 0 ? "Update" : "Next")</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

<Modal @ref="itemModal" Title="@($"Manage Items - {selectedOutward?.OutwardNo}")" Size="ModalSize.Large" OnHidden="HideItemModal" UseStaticBackdrop>
    <BodyTemplate>
        @if (selectedOutward != null)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <EditForm EditContext="@itemEditContext" OnValidSubmit="AddItemToList">
                        <DataAnnotationsValidator />
                        <fieldset disabled="@disableitemfields">
                            @if (!selectedOutward.IsFinished)
                            {
                                <div class="row">
                                    <div class="col-12 mb-2">
                                        <div class="position-relative">

                                            @if (isScanning)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                                                        title="Close Camera"
                                                        style="z-index: 10;"
                                                        @onclick="CloseCamera">
                                                    <Icon Name="IconName.XCircle" />
                                                </button>
                                            }

                                            <div id="reader" class="border rounded" style="width: 100%;"></div>

                                        </div>
                                    </div>

                                    <div class="col-sm-10">
                                        <label class="form-label">Barcode <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <InputText class="form-control" @bind-Value="newItem.BarcodeNo"
                                                       placeholder="Scan or enter barcode" @ref="barcodeInput" />

                                            <button type="button" class="btn btn-secondary" @onclick="StartCameraScan" disabled="@isScanning">
                                                <Icon Name="IconName.Camera" /> Scan
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => newItem.BarcodeNo)" />
                                    </div>

                                    <div class="col-md-2 d-flex align-items-end ms-auto">
                                        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit" class="w-100">
                                            <Icon Name="IconName.Plus" />
                                        </Button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(barcodeErrorMessage))
                                    {
                                        <div class="text-danger mt-1">@barcodeErrorMessage</div>
                                    }
                                </div>
                            }
                        </fieldset>
                    </EditForm>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        Items List (@itemList.Count) | Total Qty (@itemList.Sum(x => x.Quantity)) | Total Box Qty (@itemList.Count(x => x.Unit == UnitType.BOX.ToString()))
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-bordered table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 5%">#</th>
                                    <th style="width: 15%">Barcode</th>
                                    <th style="width: 45%">Product Name</th>
                                    <th style="width: 10%">Unit</th>
                                    <th>Qty</th>
                                    @if (!selectedOutward.IsFinished && CanDelete(Route))
                                    {
                                        <th style="width: 10%">Action</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (itemList.Any())
                                {
                                    @for (int i = 0; i < itemList.Count(); i++)
                                    {
                                        var index = itemList.Count() - i;
                                        var item = itemList[i];
                                        <tr>
                                            <td>@(index)</td>
                                            <td>@item.BarcodeNo</td>
                                            <td>@item.ProductName</td>
                                            <td>@item.Unit</td>
                                            <td>@item.Quantity</td>
                                            @if (!selectedOutward.IsFinished && CanDelete(Route))
                                            {
                                                <td>
                                                    <fieldset disabled="@disableitemfields">
                                                        <Button Color="ButtonColor.Danger"
                                                                Size="ButtonSize.Small"
                                                                @onclick="() => RemoveItem(item)">
                                                            <Icon Name="IconName.Trash" />
                                                        </Button>
                                                    </fieldset>
                                                </td>
                                            }
                                            else
                                            {
                                                <td></td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            No items added yet. Scan barcode to add items.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <fieldset disabled="@disableitemfields">
                    @if (!selectedOutward.IsFinished)
                    {
                        <LoadingButton Color="ButtonColor.Primary" onclick="() => FinalizeOutward(selectedOutward)">Finish</LoadingButton>
                    }
                    else
                    {
                        <Button Color="ButtonColor.Success" data-bs-toggle="tooltip" title="This outward is already finished">Finished</Button>
                    }
                </fieldset>
                <Button Color="ButtonColor.Secondary" @onclick="HideItemModal">Close</Button>
            </div>
        }
    </BodyTemplate>
</Modal>

@code {
    private Modal modal = default!;
    private Modal itemModal = default!;
    private InputText barcodeInput = default!;

    private List<OutwardModel> outwards = new();
    private List<CompanyModel> billCompanies = new();
    private List<PlatformModel> platforms = new();
    private OutwardModel outward = new();
    private OutwardModel? selectedOutward;

    private EditContext editContext = default!;
    private EditContext itemEditContext = default!;
    private ValidationMessageStore messageStore = default!;

    private OutWardItemModel newItem = new();
    private List<OutWardItemModel> itemList = new();
    private string barcodeErrorMessage = string.Empty;

    private bool isLoading = true;
    private string modalTitle = "Add Outward";
    private bool isEditMode = false;
    private bool disablefields = true;
    private bool disableitemfields = true;

    private bool isScanning = false;

    private bool showErrorMessage = false;
    private string errorMessage = string.Empty;
    private System.Threading.Timer? errorTimer;
    private string Route = "/outward";
    private bool isAdmin = false;
    private bool isItemSaveBtnLoading = false;
    private bool isOutwardSaveBtnLoading = false;
    private bool isExporting = false;

    // Reference for JS Interop
    private DotNetObjectReference<Outward>? dotNetHelper;

    private DateTime DatePart
    {
        get => outward.OutwardDate.Date;
        set => outward.OutwardDate = value.Date + outward.OutwardDate.TimeOfDay;
    }

    private TimeOnly TimePart
    {
        get => TimeOnly.FromDateTime(outward.OutwardDate);
        set => outward.OutwardDate = outward.OutwardDate.Date + value.ToTimeSpan();
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await base.OnInitializedAsync();
        await LoadData();

        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }
        isLoading = false;

    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(outward);
        messageStore = new ValidationMessageStore(editContext);
    }

    private void InitializeItemEditContext()
    {
        itemEditContext = new EditContext(newItem);
    }

    private async Task LoadData()
    {
        try
        {
            isAdmin = IsAdmin() || IsFactoryAdmin();

            outwards = await OutwardService.GetAllOutwardsAsync(isAdmin);
            billCompanies = await CompanyService.GetCompaniesByTypeAsync(CompanyType.BillTo);
            platforms = await PlatformService.GetAllPlatformAsync();
            InitializeEditContext();
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    #region Outward CRUD Operations
    private void ShowAddModal()
    {
        modalTitle = "Add New Outward";
        isEditMode = false;
        disablefields = false;
        outward = new OutwardModel
        {
            OutwardDate = DateTime.Now,
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.Now
        };
        InitializeEditContext();
        modal.ShowAsync();
    }

    private async Task ShowEditModal(OutwardModel editOutward)
    {
        if (CanEdit(Route) == true)
        {
            modalTitle = $"Edit Outward";
            isEditMode = true;
            if (editOutward.IsFinished)
            {
                disablefields = true;
            }
            else
            {
                disablefields = false;
            }
        }
        else
        {
            modalTitle = $"View Outward";
            isEditMode = true;
            disablefields = true;
        }
        outward = new OutwardModel
        {
            Id = editOutward.Id,
            OutwardNo = editOutward.OutwardNo,
            OutwardDate = editOutward.OutwardDate,
            BillToCompanyId = editOutward.BillToCompanyId,
            BillToCompanyName = editOutward.BillToCompanyName,
            PlatformId = editOutward.PlatformId,
            platformName = editOutward.platformName,
            Remarks = editOutward.Remarks,
            IsActive = editOutward.IsActive,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
            UpdatedOn = DateTime.Now
        };
        InitializeEditContext();
        await modal.ShowAsync();
    }

    private async Task SaveOutward()
    {
        if (isOutwardSaveBtnLoading) return;
        try
        {
            isOutwardSaveBtnLoading = true;
            if (!editContext.Validate()) return;
            ValidateBillToCompany();
            ValidatePlatform();
            if (editContext.GetValidationMessages().Any()) return;

            bool result;
            if (isEditMode)
            {
                result = await OutwardService.UpdateOutwardAsync(outward);
                if (result)
                {
                    await HideModal();
                    await LoadData();
                }
                else
                {
                    await HideModal();
                    ShowError("Connectivity issue happened, operation failed");
                }
            }
            else
            {
                var outwardId = await OutwardService.CreateOutwardAsync(outward);
                if (outwardId != 0)
                {
                    await HideModal();
                    await LoadData();
                    outward.Id = outwardId;
                    await ShowItemModal(outward);
                }
                else
                {
                    await HideModal();
                    ShowError("Connectivity issue happened, operation failed");
                }
            }
        }
        catch (Exception)
        {
            await HideModal();
            ShowError("Connectivity issue happened, operation failed");
        }
        finally
        {
            isOutwardSaveBtnLoading = false;
        }
    }

    private async Task DeleteOutward(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this outward?");
            if (!confirmed) return;

            var userid = Convert.ToInt32(CurrentUserId);
            var result = await OutwardService.DeleteOutwardAsync(id, userid);
            if (result)
            {
                await LoadData();
            }
            else
            {
                ShowError("Connectivity issue happened, operation failed");
            }
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task FinalizeOutward(OutwardModel model)
    {
        try
        {
            bool isConfirm = await JSRuntime.InvokeAsync<bool>("confirm", "After This You Can't Scan/Edit Barcode/Item");
            if (isConfirm)
            {
                model.IsFinished = true;
                await OutwardService.UpdateOutwardAsync(model);
                await HideItemModal();
                await LoadData();
            }
        }
        catch (Exception) { }
    }

    private async Task GeneratePdf(OutwardModel model)
    {
        try
        {
            await Task.Delay(100);
            // Get PDF bytes from service
            var pdfBytes = await OutwardService.GeneratePdfAsync(model.Id);

            var safeOutwardNo = model.OutwardNo.Replace("/", "_").Replace("\\", "_").Replace(":", "_");

            var fileName = $"Outward_{safeOutwardNo}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";

            var filePath = Path.Combine(Environment.CurrentDirectory,"wwwroot","exports");

            if (!Directory.Exists(filePath))
                Directory.CreateDirectory(filePath);

            var fullPath = Path.Combine(filePath, fileName);

            await File.WriteAllBytesAsync(fullPath, pdfBytes);

            var downloadUrl = $"/exports/{fileName}";

            await JSRuntime.InvokeVoidAsync("open", downloadUrl, "_blank");
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

