@page "/outward"
@inject IOutwardService OutwardService
@inject ICompanyService CompanyService
@inject IInwardService InwardService

<PageTitle>Outward Management</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><Icon Name="IconName.ArrowUpCircle" /> Outward Management</h3>
        </div>
        <div class="col-auto">
            <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                <Icon Name="IconName.Plus" /> Add New Outward
            </Button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <Grid TItem="OutwardModel"
              Class="table table-hover table-bordered table-striped"
              Data="outwards"
              AllowPaging="true"
              PageSize="10"
              AllowSorting="true"
              Responsive="true">

            <GridColumn TItem="OutwardModel" HeaderText="ID" PropertyName="Id">
                @context.Id
            </GridColumn>

            <GridColumn TItem="OutwardModel" HeaderText="Outward No" PropertyName="OutwardNo">
                @context.OutwardNo
            </GridColumn>

            <GridColumn TItem="OutwardModel" HeaderText="Outward Date" PropertyName="OutwardDate">
                @context.OutwardDate.ToString("dd/MM/yyyy")
            </GridColumn>

            <GridColumn TItem="OutwardModel" HeaderText="Bill To Company" PropertyName="BillToCompanyId">
                @(billCompanies.FirstOrDefault(c => c.Id == context.BillToCompanyId)?.Name ?? "N/A")
            </GridColumn>

            <GridColumn TItem="OutwardModel" HeaderText="Status" PropertyName="IsActive">
                @if (context.IsActive)
                {
                    <Badge Color="BadgeColor.Success">Active</Badge>
                }
                else
                {
                    <Badge Color="BadgeColor.Danger">Inactive</Badge>
                }
            </GridColumn>

            <GridColumn TItem="OutwardModel" HeaderText="Actions">
                @* <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="() => ViewDetails(context.Id)">
                    <Icon Name="IconName.Eye" /> View
                </Button> *@
                <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ShowItemModal(context)">
                    <Icon Name="IconName.PlusCircle" /> Add Items
                </Button>
               <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                    <Icon Name="IconName.PencilSquare" /> Edit
                </Button> 
                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteOutward(context.Id)">
                    <Icon Name="IconName.Trash" /> Delete
                </Button>
            </GridColumn>
        </Grid>
    }
</div>

<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="SaveOutward">
            <DataAnnotationsValidator />
            
            <div class="row">
                @* <div class="col-md-4 mb-3">
                    <label class="form-label">Outward No <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="outward.OutwardNo" />
                    <ValidationMessage For="@(() => outward.OutwardNo)" />
                </div> *@

                <div class="col-md-4 mb-3">
                    <label class="form-label">Outward Date <span class="text-danger">*</span></label>
                    <InputDate class="form-control" @bind-Value="outward.OutwardDate" />
                    <ValidationMessage For="@(() => outward.OutwardDate)" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Bill To Company <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="outward.BillToCompanyId" @oninput="(e) => HandleBillToCompanyChangeAsync(Convert.ToInt32(e.Value))">
                        <option value="0">-- Select Company --</option>
                        @foreach (var company in billCompanies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => outward.BillToCompanyId)" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Remarks</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="outward.Remarks" />
            </div>

            <div class="mb-3">
                <InputCheckbox @bind-Value="outward.IsActive" /> Active
            </div>


            <div class="text-end mt-3">
                <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>


<Modal @ref="itemModal" Title="Add Items" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm EditContext="@itemEditContext" OnValidSubmit="AddItemToOutward">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row mb-3">
                <div class="col-md-8">
                    <label class="form-label">Barcode</label>
                    <InputNumber class="form-control" @bind-Value="newItem.BarcodeNo" />
                    <ValidationMessage For="@(() => newItem.BarcodeNo)" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">
                        <Icon Name="IconName.Plus" /> Add
                    </Button>
                </div>
            </div>
        </EditForm>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Barcode</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                 @if (itemList.Any())
                {
                    @foreach (var item in itemList)
                    {
                        <tr>
                            <td>@item.BarcodeNo</td>
                            <td>@item.ProductId</td>
                            <td>@item.Quantity</td>
                            <td>
                                @* <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => RemoveItem(item)">
                                    <Icon Name="IconName.Trash" /> Remove
                                </Button> *@
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center text-muted">No items added yet.</td></tr>
                } 
            </tbody>
        </table>

        <div class="text-end">
            <Button Color="ButtonColor.Secondary" @onclick="HideItemModal">Cancel</Button>
            <Button Color="ButtonColor.Success" @onclick="SaveOutwardItems">Save Items</Button>
        </div>
    </BodyTemplate>
</Modal>

@code {
    private Modal modal = default!;
    private List<OutwardModel> outwards = new();
    private List<CompanyModel> billCompanies = new();
    private OutwardModel outward = new();
    private List<Core.Entities.OutwardDetail> outwardDetails = new();
    private List<int> selectedBarcodeItemIds = new();

    private Modal itemModal = default!;
    private EditContext itemEditContext;
    private OutwardDetailModel newItem = new();
    private List<OutWardItem> itemList = new();
    private int selectedOutwardIdForItems;

    private bool isLoading = true;
    private string modalTitle = "Add Outward";
    private bool isEditMode = false;
    private EditContext editContext;
    private ValidationMessageStore messageStore;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    private void InitializeEditContext()
    {
        editContext = new EditContext(outward);
        messageStore = new ValidationMessageStore(editContext);
    }
    private async Task LoadData()
    {
        isLoading = true;
        outwards = (await OutwardService.GetAllOutwardsAsync()).ToList();
        billCompanies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.BillTo)).ToList();
        // outwardDetails=
        InitializeEditContext();
        isLoading = false;
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Outward";
        isEditMode = false;
        outward = new OutwardModel { OutwardDate = DateTime.Now, IsActive = true };
        outwardDetails = new List<OutwardDetail>();
        InitializeEditContext();
        modal.ShowAsync();
    }

    private async Task ShowItemModal(OutwardModel outward)
    {
        modalTitle = "Add Outward";
        isEditMode = false;
        selectedOutwardIdForItems = outward.Id;
        itemList ??= (await OutwardService.GetOutwardDetailsByOutwardIdAsync(outward.Id)).ToList();
        newItem = new OutwardDetailModel();
        itemEditContext = new EditContext(newItem);
        messageStore = new ValidationMessageStore(itemEditContext);
        await itemModal.ShowAsync();
    }


    private async Task ShowEditModal(OutwardModel editOutward)
    {
        modalTitle = "Edit Outward";
        isEditMode = true;
        outward = new OutwardModel
        {
            Id = editOutward.Id,
            OutwardNo = editOutward.OutwardNo,
            OutwardDate = editOutward.OutwardDate,
            BillToCompanyId = editOutward.BillToCompanyId,
            InvoiceNo = editOutward.InvoiceNo,
            InvoiceDate = editOutward.InvoiceDate,
            ChallanNo = editOutward.ChallanNo,
            Remarks = editOutward.Remarks,
            IsActive = editOutward.IsActive
        };
        InitializeEditContext();
        var details = await OutwardService.GetOutwardDetailsByOutwardIdAsync(editOutward.Id);
        // outwardDetails = details.ToList();

        modal.ShowAsync();
    }

    private void AddOutwardDetail()
    {
        outwardDetails.Add(new Core.Entities.OutwardDetail { Unit = "PCS", Quantity = 1 });
    }

    private void RemoveOutwardDetail(int index)
    {
        outwardDetails.RemoveAt(index);
    }

    private async Task SaveOutward()
    {
        try
        {
            if (!editContext.Validate()) return;
            // outward.OutwardDetails = outwardDetails;
            // if (!outwardDetails.Any())
            // {
            //     Toast notification removed
            //     return;
            // }
            await ValidateBillToCompany();
            if (editContext.GetValidationMessages().Any())
                return;
            if (isEditMode)
            {
                await OutwardService.UpdateOutwardAsync(outward);
            }
            else
            {
                await OutwardService.CreateOutwardAsync(outward, selectedBarcodeItemIds);
            }

            await HideModal();
            await LoadData();
        }
        catch (Exception ex)
        {
        }
    }

    private async Task DeleteOutward(int id)
    {
        try
        {
            await OutwardService.DeleteOutwardAsync(id);
            await LoadData();
        }
        catch (Exception ex)
        {
        }
    }
    private async Task SaveOutwardItems()
    {
        // await OutwardService.SaveOutwardItemsAsync(selectedOutwardIdForItems, itemList);
        await itemModal.HideAsync();
        await LoadData();
    }




    private async Task AddItemToOutward()
    {
        try
        {

        if (newItem.BarcodeNo == "0")
            return;

        // Add the item to the list
        itemList.Add(new OutWardItem
        {
            BarcodeNo = newItem.BarcodeNo,
            ProductId = newItem.ProductId,
            Quantity = newItem.Quantity > 0 ? newItem.Quantity : 1,
            Unit = "PCS",
            OutwardId = selectedOutwardIdForItems
        });

        // Reset input form
        newItem = new OutwardDetailModel();
        itemEditContext = new EditContext(newItem);

        // Trigger re-render
        StateHasChanged();
        }
        catch(Exception ex)
        {
            
        }
    }

    private async Task HideItemModal()
    {
        await itemModal.HideAsync();
    }
    private void ViewDetails(int id)
    {
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }

    private async Task ValidateBillToCompany()
    {
        messageStore.Clear(() => outward.BillToCompanyId);
        if (outward.BillToCompanyId == 0)
        {
            messageStore.Add(() => outward.BillToCompanyId, "Please select Bill To company");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task HandleBillToCompanyChangeAsync(int id)
    {
        outward.BillToCompanyId = id;
        ValidateBillToCompany();
    }
}