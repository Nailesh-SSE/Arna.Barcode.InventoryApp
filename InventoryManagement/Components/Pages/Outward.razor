@page "/outward"
@implements IAsyncDisposable
@inject IOutwardService OutwardService
@inject ICompanyService CompanyService
@inject IPlatformService PlatformService
@inject IJSRuntime JSRuntime
@inherits InventoryManagement.Components.Auth.AuthComponentBase
<PageTitle>Outward Management</PageTitle>

@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    <div class="container-fluid">
        @if (showErrorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <Icon Name="IconName.ExclamationTriangle" /> @errorMessage
            </div>
        }

        <div class="row mb-3">
            <div class="col">
                <h3><Icon Name="IconName.ArrowUpCircle" /> Outward Management</h3>
            </div>
            <div class="col-auto">
                @if (CanCreate(Route))
                {
                    <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                        <Icon Name="IconName.Plus" /> Add New Outward
                    </Button>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center">
                <Spinner Type="SpinnerType.Border" />
            </div>
        }
        else
        {
            <Grid TItem="OutwardModel" Class="table table-hover table-bordered table-striped" Data="outwards" AllowPaging="true" PageSize="10" AllowSorting="true"
                  Responsive="true">

                <GridColumn TItem="OutwardModel" HeaderText="Sr. No." Sortable="false" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
                    @(outwards.IndexOf(context) + 1)
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Outward No" PropertyName="OutwardNo">
                    @context.OutwardNo
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Outward Date" PropertyName="OutwardDate">
                    @context.OutwardDate.ToString("dd/MM/yyyy")
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Bill To Company" PropertyName="BillToCompanyId">
                    @(billCompanies.FirstOrDefault(c => c.Id == context.BillToCompanyId)?.Name ?? "N/A")
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Platform" PropertyName="PlatformId">
                    @(platforms.FirstOrDefault(p => p.Id == context.PlatformId)?.Name ?? "N/A")
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Status" PropertyName="IsActive">
                    @if (context.IsActive)
                    {
                        <Badge Color="BadgeColor.Success">Active</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Danger">Inactive</Badge>
                    }
                </GridColumn>

                <GridColumn TItem="OutwardModel" HeaderText="Actions">
                    @if (CanEdit(Route))
                    {
                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ShowItemModal(context)">
                            @if (context.IsFinished)
                            {
                                <Icon Name="IconName.Eye" />
                                @: &nbsp;View Item
                            }
                            else
                            {
                                <Icon Name="IconName.PlusCircle" />
                                @: &nbsp;Add Item
                            }
                        </Button>
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                            <Icon Name="IconName.Eye"/> View
                        </Button>
                    }
                </GridColumn>
            </Grid>
        }
    </div>

    @* --- Add/Edit Outward Modal --- *@
    <Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
        <BodyTemplate>
            <EditForm EditContext="@editContext" OnValidSubmit="SaveOutward">
                <DataAnnotationsValidator />
                <fieldset disabled="@isEditMode">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Outward Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="outward.OutwardDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="@(() => outward.OutwardDate)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Bill To Company <span class="text-danger">*</span></label>
                            <DropDown TItem="CompanyModel"
                                      Items="@billCompanies"
                                      SelectedId="@outward.BillToCompanyId"
                                      ValueSelector="x => x.Id"
                                      TextSelector="x => x.Name"
                                      Placeholder="-- Select Company --"
                                      OnValueChanged="OnBillToCompanySelected" />
                            <ValidationMessage For="@(() => outward.BillToCompanyId)" />
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Platform <span class="text-danger">*</span></label>
                        <DropDown TItem="PlatformModel"
                                  Items="@platforms"
                                  SelectedId="@outward.PlatformId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Platform --"
                                  OnValueChanged="OnPlatformSelected" />
                        <ValidationMessage For="@(() => outward.PlatformId)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="outward.Remarks" />
                    </div>

                    @if (outward.Id > 0)
                    {
                        <div class="mb-3">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="outward.IsActive" id="isActive" />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                    }
                    <div class="text-end mt-3">
                        <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit"> @(outward.Id > 0 ? "Update" : "Next")</Button>
                    </div>
                </fieldset>
            </EditForm>
        </BodyTemplate>
    </Modal>

    <Modal @ref="itemModal" Title="@($"Manage Items - {selectedOutward?.OutwardNo}")" Size="ModalSize.Regular" OnHidden="HideItemModal" UseStaticBackdrop>
        <BodyTemplate>
            @if (selectedOutward != null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <EditForm EditContext="@itemEditContext" OnValidSubmit="AddItemToList">
                            <DataAnnotationsValidator />
                            @if (!selectedOutward.IsFinished)
                            {
                                <div class="row">
                                    <div class="col-12 mb-2">
                                        <div class="position-relative">

                                            @if (isScanning)
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                                                        title="Close Camera"
                                                        style="z-index: 10;"
                                                        @onclick="CloseCamera">
                                                    <Icon Name="IconName.XCircle" />
                                                </button>
                                            }

                                            <div id="reader" class="border rounded" style="width: 100%;"></div>

                                        </div>
                                    </div>

                                    <div class="col-sm-10">
                                        <label class="form-label">Barcode <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <InputText class="form-control" @bind-Value="newItem.BarcodeNo"
                                                       placeholder="Scan or enter barcode" @ref="barcodeInput" />

                                            <button type="button" class="btn btn-secondary" @onclick="StartCameraScan" disabled="@isScanning">
                                                <Icon Name="IconName.Camera" /> Scan
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => newItem.BarcodeNo)" />
                                    </div>

                                    <div class="col-md-2 d-flex align-items-end ms-auto">
                                        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit" class="w-100">
                                            <Icon Name="IconName.Plus" />
                                        </Button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(barcodeErrorMessage))
                                    {
                                        <div class="text-danger mt-1">@barcodeErrorMessage</div>
                                    }
                                </div>
                            }
                        </EditForm>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Items List (@itemList.Count)</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-bordered table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 15%">Barcode</th>
                                        <th style="width: 45%">Product Name</th>
                                        <th style="width: 10%">Unit</th>
                                        @if (!selectedOutward.IsFinished)
                                        {
                                            <th style="width: 10%">Action</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (itemList.Any())
                                    {
                                        @for (int i = 0; i < itemList.Count; i++)
                                        {
                                            var index = i;
                                            var item = itemList[i];
                                            <tr>
                                                <td>@(index + 1)</td>
                                                <td>@item.BarcodeNo</td>
                                                <td>@item.ProductName</td>
                                                <td>@item.Unit</td>
                                                @if (!selectedOutward.IsFinished)
                                                {
                                                    <td>
                                                        <Button Color="ButtonColor.Danger"
                                                                Size="ButtonSize.Small"
                                                                @onclick="() => RemoveItem(item)">
                                                            <Icon Name="IconName.Trash" />
                                                        </Button>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                No items added yet. Scan barcode to add items.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    @if (!selectedOutward.IsFinished)
                    {
                        <Button Color="ButtonColor.Primary" @onclick="() => FinalizeOutward(selectedOutward)">Finish</Button>
                    }
                    else
                    {
                        <Button Color="ButtonColor.Success" data-bs-toggle="tooltip" title="This outward is already finished">Finished</Button>
                    }
                    <Button Color="ButtonColor.Secondary" @onclick="HideItemModal">Close</Button>
                </div>
            }
        </BodyTemplate>
    </Modal>
}
@code {
    private Modal modal = default!;
    private Modal itemModal = default!;
    private InputText barcodeInput = default!;

    private List<OutwardModel> outwards = new();
    private List<CompanyModel> billCompanies = new();
    private List<PlatformModel> platforms = new();
    private OutwardModel outward = new();
    private OutwardModel? selectedOutward;

    private EditContext editContext = default!;
    private EditContext itemEditContext = default!;
    private ValidationMessageStore messageStore = default!;

    private OutWardItemModel newItem = new();
    private List<OutWardItemModel> itemList = new();
    private string barcodeErrorMessage = string.Empty;

    private bool isLoading = true;
    private string modalTitle = "Add Outward";
    private bool isEditMode = false;
    private bool isScanning = false;

    private bool showErrorMessage = false;
    private string errorMessage = string.Empty;
    private System.Threading.Timer? errorTimer;
    private string Route = "/outward";
    // Reference for JS Interop
    private DotNetObjectReference<Outward>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await base.OnInitializedAsync();
        await LoadData();

        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }
        isLoading = false;

    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(outward);
        messageStore = new ValidationMessageStore(editContext);
    }

    private void InitializeItemEditContext()
    {
        itemEditContext = new EditContext(newItem);
    }

    private async Task LoadData()
    {
        try
        {
            outwards = await OutwardService.GetAllOutwardsAsync();
            billCompanies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.BillTo)).ToList();
            platforms = (await PlatformService.GetAllPlatformAsync()).ToList();
            InitializeEditContext();
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    #region Outward CRUD Operations
    private void ShowAddModal()
    {
        modalTitle = "Add New Outward";
        isEditMode = false;
        outward = new OutwardModel
        {
            OutwardDate = DateTime.Now,
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.UtcNow
        };
        InitializeEditContext();
        modal.ShowAsync();
    }

    private async Task ShowEditModal(OutwardModel editOutward)
    {
        modalTitle = "Edit Outward";
        isEditMode = true;
        outward = new OutwardModel
        {
            Id = editOutward.Id,
            OutwardNo = editOutward.OutwardNo,
            OutwardDate = editOutward.OutwardDate,
            BillToCompanyId = editOutward.BillToCompanyId,
            PlatformId = editOutward.PlatformId,
            Remarks = editOutward.Remarks,
            IsActive = editOutward.IsActive,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
            UpdatedOn = DateTime.UtcNow
        };
        InitializeEditContext();
        await modal.ShowAsync();
    }

    private async Task SaveOutward()
    {
        try
        {
            if (!editContext.Validate()) return;
            ValidateBillToCompany();
            ValidatePlatform();
            if (editContext.GetValidationMessages().Any()) return;

            bool result;
            if (isEditMode)
            {
                result = await OutwardService.UpdateOutwardAsync(outward);
                if (result)
                {
                    await HideModal();
                    await LoadData();
                }
                else
                {
                    await HideModal();
                    ShowError("Connectivity issue happened, operation failed");
                }
            }
            else
            {
                var outwardId = await OutwardService.CreateOutwardAsync(outward);
                if (outwardId != 0)
                {
                    await HideModal();
                    await LoadData();
                    outward.Id = outwardId;
                    await ShowItemModal(outward);
                }
                else
                {
                    await HideModal();
                    ShowError("Connectivity issue happened, operation failed");
                }
            }
        }
        catch (Exception)
        {
            await HideModal();
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task DeleteOutward(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this outward?");
            if (!confirmed) return;

            var userid = Convert.ToInt32(CurrentUserId);
            var result = await OutwardService.DeleteOutwardAsync(id, userid);
            if (result)
            {
                await LoadData();
            }
            else
            {
                ShowError("Connectivity issue happened, operation failed");
            }
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task FinalizeOutward(OutwardModel model)
    {
        try
        {
            bool isConfirm = await JSRuntime.InvokeAsync<bool>("confirm", "After This You Can't Scan/Edit Barcode/Item");
            if (isConfirm)
            {
                model.IsFinished = true;
                await OutwardService.UpdateOutwardAsync(model);
                await HideItemModal();
                await LoadData();
            }
        }
        catch (Exception) { }
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }
    #endregion

    #region Item Management
    private async Task ShowItemModal(OutwardModel outward)
    {
        try
        {
            selectedOutward = outward;
            itemList = await OutwardService.GetOutwardDetailsByOutwardIdAsync(outward.Id);
            newItem = new OutWardItemModel();
            barcodeErrorMessage = string.Empty;
            isScanning = false;
            InitializeItemEditContext();

            await itemModal.ShowAsync();

            // Give the modal time to render before focusing
            await Task.Delay(150);

            if (selectedOutward.IsFinished == false)
            {
                if (barcodeInput.Element.HasValue)
                {
                    await barcodeInput.Element.Value.FocusAsync();
                }
            }
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task AddItemToList()
    {
        try
        {
            barcodeErrorMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(newItem.BarcodeNo))
            {
                barcodeErrorMessage = "Please enter a barcode.";
                return;
            }

            if (selectedOutward == null)
            {
                barcodeErrorMessage = "No outward selected.";
                return;
            }

            var validationResult = await OutwardService.ValidateBarcodeForOutwardAsync(newItem.BarcodeNo, selectedOutward.Id);

            if (!validationResult.IsValid)
            {
                barcodeErrorMessage = validationResult.ErrorMessage;
                return;
            }

            var userid = Convert.ToInt32(CurrentUserId);
            var item = await OutwardService.AddOutwardItemAsync(selectedOutward.Id, newItem.BarcodeNo, userid);

            if (item != null)
            {
                itemList.Add(item);
                newItem = new OutWardItemModel();
                InitializeItemEditContext();

                isScanning = false;
                StateHasChanged();

                if (barcodeInput.Element.HasValue)
                {
                    await barcodeInput.Element.Value.FocusAsync();
                }
            }
            else
            {
                ShowError("Connectivity issue happened, operation failed");
            }
        }
        catch (Exception)
        {
            barcodeErrorMessage = "Connectivity issue happened, operation failed";
        }
    }

    private async Task RemoveItem(OutWardItemModel item)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove item with barcode {item.BarcodeNo}?");
            if (!confirmed) return;

            var userid = Convert.ToInt32(CurrentUserId);
            var result = await OutwardService.DeleteOutwardItemAsync(item.Id, item.BarcodeNo, userid);

            if (result)
            {
                itemList.Remove(item);
                StateHasChanged();
            }
            else
            {
                ShowError("Connectivity issue happened, operation failed");
            }
        }
        catch (Exception)
        {
            ShowError("Connectivity issue happened, operation failed");
        }
    }

    private async Task HideItemModal()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;
        await itemModal.HideAsync();
        selectedOutward = null;
        itemList.Clear();
    }
    #endregion

    #region Camera Logic

    private async Task StartCameraScan()
    {
        if (isScanning) return;

        try
        {
            isScanning = true;
            dotNetHelper?.Dispose();
            dotNetHelper = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync("manageScanner.start", dotNetHelper);
        }
        catch (Exception)
        {
            isScanning = false;
            ShowError("Could not start camera");
        }
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string scannedBarcode)
    {
        barcodeErrorMessage = string.Empty;
        if (dotNetHelper == null) return;

        if (string.IsNullOrWhiteSpace(scannedBarcode))
            return;

        newItem.BarcodeNo = scannedBarcode;

        isScanning = false;

        StateHasChanged();

        await AddItemToList();
        StateHasChanged();
    }

    #endregion

    #region Validation & Helpers
    private void ValidateBillToCompany()
    {
        messageStore.Clear(() => outward.BillToCompanyId);
        if (outward.BillToCompanyId == 0)
        {
            messageStore.Add(() => outward.BillToCompanyId, "Please select a Bill To company");
        }
        editContext.NotifyValidationStateChanged();
    }
    private void OnBillToCompanySelected((int? Id, string Name) selected)
    {
        outward.BillToCompanyId = selected.Id ?? 0;
        ValidateBillToCompany();
    }
    private void ValidatePlatform()
    {
        messageStore.Clear(() => outward.PlatformId);
        if (outward.PlatformId == 0)
        {
            messageStore.Add(() => outward.PlatformId, "Please select a Platform");
        }
        editContext.NotifyValidationStateChanged();
    }
    private void OnPlatformSelected((int? Id, string Name) selected)
    {
        outward.PlatformId = selected.Id ?? 0;
        ValidatePlatform();
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        showErrorMessage = true;
        StateHasChanged();

        errorTimer?.Dispose();
        errorTimer = new System.Threading.Timer(_ =>
        {
            showErrorMessage = false;
            errorMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    public async ValueTask DisposeAsync()
    {
        errorTimer?.Dispose();

        try
        {
            await JSRuntime.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }
    }

    public async Task CloseCamera()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;

        if (barcodeInput.Element.HasValue)
        {
            await barcodeInput.Element.Value.FocusAsync();
        }
    }
    #endregion
}

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<script>
    let html5QrcodeScanner;

    window.manageScanner = {
        start: (dotNetHelper) => {
            if (html5QrcodeScanner) { return; }

            html5QrcodeScanner = new Html5Qrcode("reader");

            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrcodeScanner.start({ facingMode: "environment" }, config,
                (decodedText, decodedResult) => {
                    // SUCCESS:
                    // 1. Stop the camera immediately so it doesn't scan twice
                    // 2. Clear the variable and DOM
                    // 3. Send result to C#
                    window.manageScanner.stop().then(() => {
                        dotNetHelper.invokeMethodAsync('OnBarcodeScanned', decodedText)
                            .catch(err => console.log("Blazor component disposed", err));
                    });
                },
                (errorMessage) => {
                    // ignore errors
                })
            .catch(err => {
                console.error("Error starting scanner", err);
                alert("Could not start camera. Permissions?");
            });
        },

        stop: () => {
            return new Promise((resolve, reject) => {
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        html5QrcodeScanner.clear();
                        html5QrcodeScanner = null;
                        document.getElementById("reader").innerHTML = "";
                        resolve();
                    }).catch(err => {
                        console.log("Error stopping scanner", err);
                        html5QrcodeScanner = null;
                        resolve();
                    });
                } else {
                    resolve();
                }
            });
        },
        forceStop: () => {
            if (!html5QrcodeScanner) return;

            try
            {
                html5QrcodeScanner.stop();
                html5QrcodeScanner.clear();
            }
            catch (e)
            {
                console.warn("Scanner stop error", e);
            }

            html5QrcodeScanner = null;

            const reader = document.getElementById("reader");
            if (reader) reader.innerHTML = "";
        }
    };
</script>