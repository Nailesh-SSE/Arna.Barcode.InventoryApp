@page "/form"
@using InventoryManagement.Services
@using System.Security.Claims
@using InventoryManagement.Components.Auth
@inherits AuthComponentBase
@inject IFormMasterService FormService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Form Master</PageTitle>


@if (!IsAdmin())
{
    <div class="container-fluid mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-danger text-center">
                    <h4>Access Denied</h4>
                    <p>You don't have permission to access this page.</p>
                    <Button Color="ButtonColor.Primary" @onclick="GoHome">
                        Go to Home
                    </Button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <div class="container-fluid">
            <div class="row mb-3">
                <div class="col">
                    <h3><Icon Name="IconName.FileEarmarkText" /> Form Master</h3>
                </div>
                <div class="col-auto">
                    @if (CanCreate("/form"))
                    {
                        <Button Color="ButtonColor.Primary"
                                @onclick="ShowAddModal">
                            <Icon Name="IconName.Plus" /> Add New
                        </Button>
                    }
                </div>
            </div>

            @if (formList.Any())
            {
                <Grid TItem="FormMasterModel"
                      Class="table table-hover table-bordered table-striped"
                      Data="formList"
                      AllowPaging="true"
                      PageSize="10"
                      Responsive="true"
                      AllowFiltering="true"
                      AllowSorting="true"
                      @ref="FormGrid">

                    <GridColumn TItem="FormMasterModel" HeaderText="No" Filterable=false>
                        @(formList.IndexOf(context) + 1)
                    </GridColumn>

                    <GridColumn TItem="FormMasterModel" HeaderText="Form Name" PropertyName="FormName" SortString="FormName" SortKeySelector="item => item.FormName" FilterTextboxWidth="100">
                        @context.FormName
                    </GridColumn>

                    <GridColumn TItem="FormMasterModel" HeaderText="Route" PropertyName="Route" SortString="Route" SortKeySelector="item => item.Route" FilterTextboxWidth="100">
                        @context.Route
                    </GridColumn>

                    <GridColumn TItem="FormMasterModel" HeaderText="ParentForm" PropertyName="ParentName" SortString="ParentName" SortKeySelector="item => item.ParentName" FilterTextboxWidth="100">
                        @context.ParentName
                    </GridColumn>

                    <GridColumn TItem="FormMasterModel" HeaderText="DisplayIndex" PropertyName="DisplayIndex" SortString="DisplayIndex" SortKeySelector="item => item.DisplayIndex" FilterTextboxWidth="60">
                        @context.DisplayIndex
                    </GridColumn>

                    <GridColumn TItem="FormMasterModel" HeaderText="Actions" Filterable=false>
                        <div class="d-flex gap-1 justify-content-start">
                            @if (CanEdit(Route))
                            {
                                <Button class="text-nowrap" Color="ButtonColor.Warning"
                                        Size="ButtonSize.Small"
                                        @onclick="() => ShowEditModal(context)">
                                    <Icon Name="IconName.PencilSquare" /> Edit
                                </Button>
                            }
                            @if (CanDelete(Route))
                            {
                                <Button class="text-nowrap" Color="ButtonColor.Danger"
                                        Size="ButtonSize.Small"
                                        @onclick="() => DeleteForm(context.Id)">
                                    <Icon Name="IconName.Trash" /> Delete
                                </Button>
                            }
                        </div>
                    </GridColumn>
                </Grid>
            }
        </div>
    }

}


<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="SaveForm">
            <DataAnnotationsValidator />


            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Form Name <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control"
                               @bind-Value="formModel.FormName"
                               @oninput="(e) => HandleNameChangeAsync(e.Value?.ToString())" />
                    <ValidationMessage For="@(() => formModel.FormName)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Route <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control"
                               @bind-Value="formModel.Route" />
                    <ValidationMessage For="@(() => formModel.Route)" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Parent Form</label>
                    <InputSelect class="form-select" @bind-Value="formModel.ParentId">
                        <option value="0">-- Select Parent Form --</option>
                        @foreach (var form in parentformList)
                        {
                            <option value="@form.Id">@form.FormName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => formModel.ParentId)" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        DisplayIndex <span class="text-danger">*</span>
                    </label>
                    <InputNumber class="form-control"
                                 @bind-Value="formModel.DisplayIndex"
                                 @oninput="HandleDisplayIndexChangeAsync" />
                    <ValidationMessage For="@(() => formModel.DisplayIndex)" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Icon</label>
                    <InputText class="form-control"
                               @bind-Value="formModel.Icon" />
                    <ValidationMessage For="@(() => formModel.Icon)" />
                </div>
            </div>

            @if (formModel.Id > 0)
            {
                <div class="mb-3">
                    <InputCheckbox @bind-Value="formModel.IsActive" /> Active
                </div>
            }

            <div class="text-end">
                <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
            </div>
        </EditForm>
    </BodyTemplate>

</Modal>



@code {
    private Modal modal;
    private bool isEditMode;
    private bool isLoading = true;


    private string modalTitle = "Add Form";
    private string Route = "/form";

    private FormMasterModel formModel = new();
    private List<FormMasterModel> formList = new();
    private List<FormMasterModel> parentformList = new();

    private Grid<FormMasterModel> FormGrid;

    private EditContext editContext;
    private ValidationMessageStore validationMessage;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadForms();
    }

    private async Task LoadForms()
    {
        try
        {
            
            isLoading = true;
            formList = await FormService.GetAllAsync(CurrentUserRoleId);
                if (formList.Any())
                    parentformList = formList.Where(a => a.Route == "#").ToList();
            isLoading = false;
        }
        catch (Exception ex)
        {

            throw;
        }

    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(formModel);
        validationMessage = new ValidationMessageStore(editContext);
    }

    private async Task ShowAddModal()
    {
        modalTitle = "Add Form";
        isEditMode = false;

        formModel = new FormMasterModel
        {
            CreatedBy = UserId
        };

        InitializeEditContext();
        await modal.ShowAsync();
    }

    private async Task ShowEditModal(FormMasterModel model)
    {
        modalTitle = "Edit Form";
        isEditMode = true;

        formModel = new FormMasterModel
        {
            Id = model.Id,
            FormName = model.FormName,
            Route = model.Route,
            DisplayIndex = model.DisplayIndex,
            Icon = model.Icon,
            ParentId = model.ParentId,
            ParentName = model.ParentName,
            IsActive = model.IsActive,
            UpdatedBy = UserId
        };

        InitializeEditContext();
        await modal.ShowAsync();
    }

    private async Task SaveForm()
    {
        if (!editContext.Validate())
            return;

        await ValidateDuplicateNameAsync();
        if (editContext.GetValidationMessages().Any())
            return;

        await ValidateIsDisplayIndexInUseAsync();
        if (editContext.GetValidationMessages().Any())
            return;

        formModel.ParentName = formList.FirstOrDefault(f => f.Id == formModel.ParentId)?.FormName ?? string.Empty;
        if (isEditMode)
            await FormService.UpdateAsync(formModel);
        else
            await FormService.CreateAsync(formModel);

        await HideModal();
        await LoadForms();
        await FormGrid.RefreshDataAsync();
    }

    private async Task DeleteForm(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete?");
        if (!confirm) return;

        await FormService.DeleteAsync(id, UserId);
        await LoadForms();
        await FormGrid.RefreshDataAsync();
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }

    private async Task ValidateDuplicateNameAsync()
    {
        validationMessage.Clear(() => formModel.FormName);

        if (!string.IsNullOrWhiteSpace(formModel.FormName))
        {
            var isUnique = await FormService.IsFormNameUniqueAsync(
                formModel.FormName, formModel.Id);
            if (!isUnique)
                validationMessage.Add(() => formModel.FormName, "Form name already exists");

            editContext.NotifyValidationStateChanged();
        }
    }

    private async Task ValidateDisplayIndexAsync()
    {
        validationMessage.Clear(() => formModel.DisplayIndex);
        if (formModel.DisplayIndex == 0)
        {
            validationMessage.Add(() => formModel.DisplayIndex, "Display index must greter than 0");
        }
        editContext.NotifyValidationStateChanged();
    }
    private async Task ValidateIsDisplayIndexInUseAsync()
    {
        validationMessage.Clear(() => formModel.DisplayIndex);
        var isUnique = await FormService.IsDisplayIndexInUseAsync(
            formModel.DisplayIndex,
            formModel.ParentId,
            formModel.Id);

        if (!isUnique)
        {
            validationMessage.Add(
                () => formModel.DisplayIndex,
                "Display Index already exists");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task HandleNameChangeAsync(string value)
    {
        formModel.FormName = value;
        await ValidateDuplicateNameAsync();
    }
    private async Task HandleDisplayIndexChangeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int index))
        {
            formModel.DisplayIndex = index;
            await ValidateDisplayIndexAsync();
        }
    }
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }

}