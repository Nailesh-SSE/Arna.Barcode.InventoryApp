@page "/form-permission"
@using InventoryManagement.Components.Auth
@attribute [Authorize]
@inherits AuthComponentBase
@inject IRoleService RoleService
@inject IFormPermissionService Service
@inject IFormMasterService FormService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager


<PageTitle>Form Permission</PageTitle>


@if (!IsAdmin())
{
    <div class="container-fluid mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-danger text-center">
                    <h4>Access Denied</h4>
                    <p>You don't have permission to access this page.</p>
                    <Button Color="ButtonColor.Primary" @onclick="GoHome">
                        Go to Home
                    </Button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col"><h3>Form Permission</h3></div>
            <div class="col-auto">
                @if (CanCreate("/form-permission"))
                {
                    <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">Add</Button>
                }
            </div>
        </div>


        <Grid TItem="FormPermissionModel" Class="table table-hover table-bordered table-striped" Data="list" @ref="grid">
            <GridColumn TItem="FormPermissionModel" HeaderText="Role">
                @context.RoleName
            </GridColumn>
            <GridColumn TItem="FormPermissionModel" HeaderText="Form">
                @context.FormName
            </GridColumn>
            <GridColumn TItem="FormPermissionModel" HeaderText="View">
                @context.CanView
            </GridColumn>
            <GridColumn TItem="FormPermissionModel" HeaderText="Create">
                @context.CanCreate
            </GridColumn>
            <GridColumn TItem="FormPermissionModel" HeaderText="Edit">
                @context.CanEdit
            </GridColumn>
            <GridColumn TItem="FormPermissionModel" HeaderText="Delete">
                @context.CanDelete
            </GridColumn>
            <GridColumn TItem="FormPermissionModel" HeaderText="Action">
                @if (CanEdit("/form-permission"))
                {
                    <Button Color="ButtonColor.Warning" @onclick="() => Edit(context)">Edit</Button>
                }
                @if (CanDelete("/form-permission"))
                {
                    <Button Color="ButtonColor.Danger" @onclick="() => Delete(context.Id)">Delete</Button>
                }
            </GridColumn>
        </Grid>
    </div>

}


<Modal @ref="modal" Title="@title">
    <BodyTemplate>
        
        <EditForm Model="@editContext" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="mb-2">
                <label class="form-label">Role</label>
                <DropDown TItem="RoleModel"
                          Items="@roles"
                          SelectedId="@model.Id"
                          ValueSelector="x => x.Id"
                          TextSelector="x => x.Name"
                          Placeholder="-- Select Role--"
                          OnValueChanged="HandleRole" />
                <ValidationMessage For="@(() => model.Id)" />
            </div>


            <div class="mb-2">
                <label class="form-label">Form</label>
                <DropDown TItem="FormPermissionModel"
                          Items="@list"
                          SelectedId="@model.FormId"
                          ValueSelector="x => x.Id"
                          TextSelector="x => x.FormName"
                          Placeholder="-- Select Role--"
                          OnValueChanged="HandleForm" />
                <ValidationMessage For="@(() => model.FormId)" />

            </div>

            <div class="d-flex gap-4 mt-4">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="model.CanView" />
                    <label class="form-check-label">View</label>
                </div>

                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="model.CanCreate" />
                    <label class="form-check-label">Create</label>
                </div>

                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="model.CanEdit" />
                    <label class="form-check-label">Edit</label>
                </div>

                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="model.CanDelete" />
                    <label class="form-check-label">Delete</label>
                </div>
            </div>
            <div class="text-end mt-3">
                <Button Color=ButtonColor.Primary Type="ButtonType.Submit">Save</Button>
            </div>
        </EditForm>
    </BodyTemplate>

</Modal>



@code {
    List<FormPermissionModel> list = new();
    List<FormMasterModel> forms = new();
    public List<RoleModel> roles = new();

    private EditContext editContext { get; set; }
    private ValidationMessageStore validationMessage;

    public FormPermissionModel model = new();
    Modal? modal;
    Grid<FormPermissionModel>? grid;
    string? title;
    private const string Route = "/form-permission";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!CanView(Route))
        {
            NavigationManager.NavigateTo("/access-denied", true);
            return;
        }

        await LoadData();
    }

    public void InitializeEditContextAsync()
    {
        editContext = new EditContext(model);
        validationMessage = new ValidationMessageStore(editContext);
    }

    private async Task LoadData()
    {
        list = await Service.GetAllAsync();
        forms = await FormService.GetAllAsync();
        roles = await RoleService.GetAllRolesAsync();
        InitializeEditContextAsync();
    }

    void ShowAddModal()
    {
        if (User.Identity?.IsAuthenticated == true)
        {
            title = "Add Permission";
            model = new()
            {
                CreatedBy = UserId
            };
            _ = modal?.ShowAsync();
        }
    }

    void Edit(FormPermissionModel m)
    {
        title = "Edit Permission";
        model = m;
        _ = modal?.ShowAsync();
    }

    async Task Save()
    {
        if (await Service.ExistsAsync(model.RoleId, model.FormId, model.Id))
        {
            await JS.InvokeVoidAsync("alert", "Already exists");
            return;
        }

        if (model.Id > 0)
            await Service.UpdateAsync(model);
        else
            await Service.CreateAsync(model);

        if (modal is not null)
            await modal.HideAsync();

        await LoadData();
        if (grid is not null)
            await grid.RefreshDataAsync();
    }

    async Task Delete(int id)
    {
        if (User.Identity?.IsAuthenticated != true)
            return;

        if (await JS.InvokeAsync<bool>("confirm", "Delete?"))
        {
            await Service.DeleteAsync(id, UserId);
            await LoadData();
            await grid!.RefreshDataAsync();
        }
    }
    private async Task HandleRole()
    {

        await ValidateRole();
    }
    private async Task HandleForm()
    {
        await ValidateForm();

    }
    private async Task ValidateRole()
    {
        validationMessage.Clear(() => model.Id);
        if (model.Id <= 0)
        {
            validationMessage.Add(() => model.Id, "Role  is required");
            editContext.NotifyValidationStateChanged();
        }
    }
    private async Task ValidateForm()
    {
        validationMessage.Clear(() => model.FormId);
        if (model.FormId <=0)
        {
            validationMessage.Add(() => model.FormId, "Page is required");
            editContext.NotifyValidationStateChanged();
        }
    }
  
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}