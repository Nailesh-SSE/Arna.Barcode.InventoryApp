@page "/inward"
@inject IInwardService InwardService
@inject ICompanyService CompanyService
@inject IProductService ProductService
@inject ICategoryService CategoryService

<PageTitle>Inward Management</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>Inward Management</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowAddModal">
                Add New Inward
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Inward No</th>
                        <th>Inward Date/Time</th>
                        <th>Ship Company</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var context in inwards)
                    {
                        <tr>
                            <td>@context.Id</td>
                            <td>@context.InwardNo</td>
                            <td>@context.InwardDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td>@(shipCompanies.FirstOrDefault(c => c.Id == context.ShipMentCompanyId)?.Name ?? "N/A")</td>
                            <td>
                                @if (context.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <button class="btn btn-warning btn-sm" @onclick="@(() => ShowEditModal(context))">Edit</button>
                                    <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteInward(context.Id))">Delete</button>
                                    <button class="btn btn-success btn-sm" @onclick="@(() => ShowAddItemModal(context))"> Add Item</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal -->
<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="SaveInward">
            <DataAnnotationsValidator />

            <div class="modal-content-custom">
                <!-- Fixed Header Form -->
                <div class="modal-header-section">
                    <div class="row g-2">
                        <div class="col-12 col-sm-6 col-md-3 no-md-width">
                            <label class="form-label">Inward Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="inward.InwardDate" />
                            <ValidationMessage For="@(() => inward.InwardDate)" />
                        </div>

                        <div class="col-12 col-sm-6 col-md-3 no-md-width">
                            <label class="form-label">Inward Time</label>
                            <input type="time" class="form-control"
                                   value="@inward.InwardTime.ToString(@"hh\:mm")"
                                   @onchange="OnTimeChanged" required />
                        </div>

                        <div class="col-12 col-sm-6 col-md-3 no-md-width">
                            <label class="form-label">Ship Company <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="inward.ShipMentCompanyId">
                                <option value="0">-- Select Company --</option>
                                @foreach (var company in shipCompanies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => inward.ShipMentCompanyId)" />
                        </div>

                        <div class="col-12 col-sm-6 col-md-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" value="@selectedCategoryId" @onchange="OnCategoryChanged">
                                <option value="">-- All Categories --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mt-2">
                        <div class="col-12 col-md-9">
                            <label class="form-label">Remarks</label>
                            <InputText class="form-control" @bind-Value="inward.Remarks" />
                        </div>

                        @if (inward.Id > 0)
                        {
                            <div class="col-12 col-md-3">
                                <label class="form-label d-block text-start">Active</label>
                                <div class="custom-checkbox-wrapper mt-2">
                                    <InputCheckbox id="activeCheck" class="custom-checkbox" @bind-Value="inward.IsActive" />
                                    <label for="activeCheck"></label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

 
                <!-- Fixed Footer -->
                <div class="modal-footer-section">
                    <button type="button" class="btn btn-secondary me-2" @onclick="HideModal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
               
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

<Modal @ref="AdditemModal" Title="@modalTitle" Size="ModalSize.Large">
  <BodyTemplate>
        <EditForm EditContext="@editItemContext" OnValidSubmit="AddInwardItem">
            <DataAnnotationsValidator />

            <!-- Scrollable Product Table -->
            <div class="modal-body-section">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                    <h5 class="mb-0">Inward Items</h5>
                    <button type="button" class="btn btn-success btn-sm" @onclick="AddInwardItem">Add Item</button>
                </div>

                @if (inwardItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                   
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < inwardItems.Count; i++)
                                {
                                    var index = i;
                                    var item = inwardItems[index];
                                    <tr>
                                        <td>
                                            <InputSelect class="form-select form-select-sm" @bind-Value="item.ProductId">
                                                <option value="0">-- Select Product --</option>
                                                @foreach (var product in filteredProducts)
                                                {
                                                    <option value="@product.Id">@product.Name (@product.SKU) - @product.Unit</option>
                                                }
                                            </InputSelect>
                                        </td>
                                        <td>
                                            <InputNumber class="form-control form-control-sm" @bind-Value="item.Quantity" />
                                        </td>
                                        @* <td>
                                            <InputText class="form-control form-control-sm" @bind-Value="item.Unit" />
                                        </td> *@
                                        <td>
                                            <button type="button" class="btn btn-primary btn sm" @onclick="@(() => SaveInwardItem(item))">
                                                Save
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    @onclick="@(() => RemoveInwardItem(index))">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        No items added yet. Click "Add Item" to get started.
                    </div>
                }
            </div>
        </EditForm>
  </BodyTemplate>
</Modal>

@code {
    private List<InwardModel> inwards = new();
    private List<CompanyModel> shipCompanies = new();
    private List<ProductModel> products = new();
    private List<ProductModel> filteredProducts = new();
    private List<CategoryModel> categories = new();
    private InwardModel inward = new();
    private List<InwardItemModel> inwardItems = new();
    private bool isLoading = true;
    private string modalTitle = "Add Inward";
    private bool isEditMode = false;
    private string? selectedCategoryId;
    private Modal modal;
    private Modal AdditemModal;
    private EditContext editContext;
    private EditContext editItemContext;
    private ValidationMessageStore validationMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        inwards = (await InwardService.GetAllAsync()).ToList();
        shipCompanies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.ShipTo)).ToList();
        categories = (await CategoryService.GetAllCategoriesAsync()).ToList();
        products = (await ProductService.GetAllProductsAsync()).ToList();
        filteredProducts = products;

        isLoading = false;
        StateHasChanged();
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(inward);
        editItemContext = new EditContext(inwardItems);
        validationMessage = new ValidationMessageStore(editContext);
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Inward";
        isEditMode = false;
        inward = new InwardModel
        {
            InwardDate = DateTime.Now,
            InwardTime = DateTime.Now.TimeOfDay,
            IsActive = true
        };
        inwardItems = new();
        selectedCategoryId = null;
        filteredProducts = products;
        InitializeEditContext();
        modal.ShowAsync();
    }
    private async Task ShowAddItemModal(InwardModel item)
    {
        modalTitle = "Add Item";   
        inward= item;  
        inwardItems = await InwardService.GetInwardItemsByInwardIdAsync(item.Id);
        InitializeEditContext();
        await AdditemModal.ShowAsync();
    }
    
    private async Task SaveInwardItem(InwardItemModel item)
    {
        item.InwardId = inward.Id;
        inwardItems.Add(new InwardItemModel { Unit = "PCS" });

        inward.InwardItems = inwardItems;
      
       // await ValidateIsProductSelected();
        await InwardService.UpdateAsync(inward);
        StateHasChanged();
      
    }

    private async Task ShowEditModal(InwardModel edit)
    {
        modalTitle = $"Edit Inward {edit.InwardNo}";
        isEditMode = true;
        inward = edit;
        inward.InwardTime = inward.InwardDate.TimeOfDay;
        inwardItems = await InwardService.GetInwardItemsByInwardIdAsync(edit.Id);
        selectedCategoryId = null;
        filteredProducts = products;
        InitializeEditContext();
        modal.ShowAsync();
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategoryId = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedCategoryId))
            filteredProducts = products;
        else
            filteredProducts = products.Where(p => p.CategoryId == int.Parse(selectedCategoryId!)).ToList();
        StateHasChanged();
    }

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out TimeSpan time))
            inward.InwardTime = time;
    }

    
    private void AddInwardItem()
    {
        if (inwardItems.Any())
        {
           // var LastItem = inwardItems.Last();
            if (ValidateAllItems())
            {             
               inwardItems.Add(new InwardItemModel { Unit = "PCS" });
                
            }
        }
        else
        {
            inwardItems.Add(new InwardItemModel { Unit = "PCS" });
            StateHasChanged();

        }
    }
    private bool ValidateAllItems()
    {
        validationMessage.Clear();
        bool isValid = true;

        foreach (var item in inwardItems)
        {
            if (item.ProductId == 0)
            {
                validationMessage.Add(() => item.ProductId, "Product selection is required");
                isValid = false;
            }
        }

        editContext.NotifyValidationStateChanged();
        return isValid;
    }
    private async Task ValidateIsProductSelected()
    {
        var LastItem = inwardItems.Last();
        validationMessage.Clear();
        if ( LastItem.ProductId==0)
        {
            validationMessage.Add(() => LastItem.ProductId, "Product Selection is Required");
            editContext.NotifyValidationStateChanged();
        }
        
    }
    private void RemoveInwardItem(int index)
    {
        inwardItems.RemoveAt(index);
        StateHasChanged();
    }

    private async Task SaveInward()
    {
        inward.InwardDate = inward.InwardDate.Date.Add(inward.InwardTime);
        inward.InwardItems = inwardItems;

        if (isEditMode)
            await InwardService.UpdateAsync(inward);
        else
            await InwardService.CreateAsync(inward);

        await HideModal();
        await LoadData();
    }

    private async Task DeleteInward(int id)
    {
        await InwardService.DeleteAsync(id);
        await LoadData();
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }
}

<style>
    /* ✅ Desktop Layout - Separate Scroll Areas */
    .modal-content-custom {
        display: flex;
        flex-direction: column;
        height: 80vh;
        max-height: 90vh;
        overflow: hidden;
    }

    .modal-header-section {
        flex-shrink: 0;
        overflow: visible;
        padding: 15px;
        background: #fff;
    }

    .modal-body-section {
        flex-grow: 1;
        overflow-y: auto;
        padding: 0 15px 15px 15px;
        min-height: 250px;
    }

    .modal-footer-section {
        flex-shrink: 0;
        padding: 15px;
        border-top: 1px solid #dee2e6;
        background: #fff;
        text-align: right;
    }

    /* ✅ Desktop Scrollbar */
    .modal-body-section::-webkit-scrollbar {
        width: 6px;
    }

    .modal-body-section::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .modal-body-section::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 10px;
    }

        .modal-body-section::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    /* ✅ Mobile Layout - Single Scrollbar for Entire Modal */
    @@media (max-width: 768px) {
        .no-md-width {
            flex: 0 0 auto !important;
            width: 50% !important;
        }
        .modal-content-custom {
            height: 95vh;
            max-height: 95vh;
            overflow-y: auto; /* Single scrollbar for entire modal */
            display: block; /* Change from flex to block for proper scrolling */
        }

        .modal-header-section {
            padding: 12px;
            position: relative;
        }

        .modal-body-section {
            padding: 0 12px 12px 12px;
            overflow: visible; /* Remove individual scrolling */
            min-height: auto;
            flex-grow: 0;
        }

        .modal-footer-section {
            padding: 12px;
            position: relative; /* Remove sticky positioning */
            bottom: auto;
            z-index: auto;
        }
        /* Mobile scrollbar styling */
        .modal-content-custom::-webkit-scrollbar {
            width: 6px;
        }

        .modal-content-custom::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .modal-content-custom::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

            .modal-content-custom::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }

        .table-responsive {
            font-size: 13px;
        }

        .btn-sm {
            font-size: 12px;
            padding: 4px 8px;
        }
        /* Ensure form controls are properly sized on mobile */
        .form-control, .form-select {
            font-size: 14px;
        }
        /* Make table more compact on mobile */
        .table > :not(caption) > * > * {
            padding: 0.4rem 0.3rem;
        }
        /* Ensure table is scrollable horizontally if needed */
        .table-responsive {
            overflow-x: auto;
        }
    }

    @@media (max-width: 576px) {
        .modal-content-custom {
            height: 98vh;
            max-height: 98vh;
        }

        .modal-header-section .row > div {
            margin-bottom: 8px;
        }

        .modal-header-section {
            padding: 10px;
        }

        .modal-body-section {
            padding: 0 10px 10px 10px;
        }

        .modal-footer-section {
            padding: 10px;
        }
            /* Stack buttons on very small screens */
            .modal-footer-section .btn {
                width: 100%;
                margin-bottom: 8px;
            }

            .modal-footer-section .me-2 {
                margin-right: 0 !important;
            }
        /* Ensure table cells don't break layout */
        .table {
            min-width: 400px;
        }
        /* Adjust header spacing */
        h5 {
            font-size: 1.1rem;
        }
    }

    @@media (max-width: 400px) {
        .modal-content-custom {
            height: 100vh;
            max-height: 100vh;
        }
        /* Adjust table for very small screens */
        .table {
            min-width: 350px;
        }
    }

    /* ✅ Custom Checkbox */
    .custom-checkbox-wrapper {
        display: inline-block;
    }

    .custom-checkbox {
        display: none;
    }

        .custom-checkbox + label {
            display: inline-block;
            width: 25px;
            height: 25px;
            border: 2px solid #ccc;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 4px;
            position: relative;
            cursor: pointer;
            vertical-align: middle;
            transition: all 0.2s ease;
        }

        .custom-checkbox:checked + label::after {
            content: '';
            position: absolute;
            left: 7px;
            top: 2px;
            width: 10px;
            height: 15px;
            border: solid green;
            border-width: 0 3px 3px 0;
            transform: rotate(45deg);
        }

        .custom-checkbox + label:hover {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            border-color: #999;
        }
</style>