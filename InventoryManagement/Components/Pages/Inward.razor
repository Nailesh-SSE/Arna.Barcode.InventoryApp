@* @page "/inward"
@inject IInwardService InwardService
@inject ICompanyService CompanyService
@inject IProductService ProductService

<PageTitle>Inward Management</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><Icon Name="IconName.ArrowDownCircle" /> Inward Management</h3>
        </div>
        <div class="col-auto">
            <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                <Icon Name="IconName.Plus" /> Add New Inward
            </Button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <Grid TItem="Core.Entities.Inward"
              Class="table table-hover table-bordered table-striped"
              DataProvider="InwardsDataProvider"
              AllowFiltering="true"
              AllowPaging="true"
              PageSize="10"
              AllowSorting="true"
              Responsive="true">

            <GridColumn TItem="Core.Entities.Inward" HeaderText="ID" PropertyName="Id">
                @context.Id
            </GridColumn>

            <GridColumn TItem="Core.Entities.Inward" HeaderText="Inward No" PropertyName="InwardNo">
                @context.InwardNo
            </GridColumn>

            <GridColumn TItem="Core.Entities.Inward" HeaderText="Inward Date" PropertyName="InwardDate">
                @context.InwardDate.ToString("dd/MM/yyyy")
            </GridColumn>

            <GridColumn TItem="Core.Entities.Inward" HeaderText="Ship Company" PropertyName="ShipMentCompanyId">
                @(context.ShipMentCompany?.Name ?? "N/A")
            </GridColumn>

            <GridColumn TItem="Core.Entities.Inward" HeaderText="Invoice No" PropertyName="InvoiceNo">
                @context.InvoiceNo
            </GridColumn>

            <GridColumn TItem="Core.Entities.Inward" HeaderText="Status" PropertyName="IsActive">
                @if (context.IsActive)
                {
                    <Badge Color="BadgeColor.Success">Active</Badge>
                }
                else
                {
                    <Badge Color="BadgeColor.Danger">Inactive</Badge>
                }
            </GridColumn>

            <GridColumn TItem="Core.Entities.Inward" HeaderText="Actions">
                <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="() => ViewDetails(context.Id)">
                    <Icon Name="IconName.Eye" /> View
                </Button>
                <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                    <Icon Name="IconName.PencilSquare" /> Edit
                </Button>
                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteInward(context.Id)">
                    <Icon Name="IconName.Trash" /> Delete
                </Button>
            </GridColumn>
        </Grid>
    }
</div>

<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <EditForm Model="inward" OnValidSubmit="SaveInward">
            <DataAnnotationsValidator />
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Inward No <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="inward.InwardNo" />
                    <ValidationMessage For="@(() => inward.InwardNo)" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Inward Date <span class="text-danger">*</span></label>
                    <InputDate class="form-control" @bind-Value="inward.InwardDate" />
                    <ValidationMessage For="@(() => inward.InwardDate)" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Ship Company <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="inward.ShipMentCompanyId">
                        <option value="0">-- Select Company --</option>
                        @foreach (var company in shipCompanies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => inward.ShipMentCompanyId)" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Invoice No</label>
                    <InputText class="form-control" @bind-Value="inward.InvoiceNo" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Invoice Date</label>
                    <InputDate class="form-control" @bind-Value="inward.InvoiceDate" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Challan No</label>
                    <InputText class="form-control" @bind-Value="inward.ChallanNo" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Remarks</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="inward.Remarks" />
            </div>

            <div class="mb-3">
                <InputCheckbox @bind-Value="inward.IsActive" /> Active
            </div>

            <hr />

            <h5>Inward Items</h5>
            <div class="mb-3">
                <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="AddInwardItem">
                    <Icon Name="IconName.Plus" /> Add Item
                </Button>
            </div>

            @if (inwardItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < inwardItems.Count; i++)
                            {
                                var index = i;
                                var item = inwardItems[index];
                                <tr>
                                    <td>
                                        <InputSelect class="form-select form-select-sm" @bind-Value="item.ProductId">
                                            <option value="0">-- Select Product --</option>
                                            @foreach (var product in products)
                                            {
                                                <option value="@product.Id">@product.Name (@product.SKU)</option>
                                            }
                                        </InputSelect>
                                    </td>
                                    <td>
                                        <InputNumber class="form-control form-control-sm" @bind-Value="item.Quantity" />
                                    </td>
                                    <td>
                                        <InputText class="form-control form-control-sm" @bind-Value="item.Unit" />
                                    </td>
                                    <td>
                                        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => RemoveInwardItem(index)">
                                            <Icon Name="IconName.Trash" />
                                        </Button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-end mt-3">
                <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>


@code {
    private Modal modal = default!;
    private List<Core.Entities.Inward> inwards = new();
    private List<Company> shipCompanies = new();
    private List<Product> products = new();
    private Core.Entities.Inward inward = new();
    private List<Core.Entities.InwardItem> inwardItems = new();
    private bool isLoading = true;
    private string modalTitle = "Add Inward";
    private bool isEditMode = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        inwards = (await InwardService.GetAllAsync()).ToList();
        shipCompanies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.ShipTo)).ToList();
        products = (await ProductService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private async Task<GridDataProviderResult<Core.Entities.Inward>> InwardsDataProvider(GridDataProviderRequest<Core.Entities.Inward> request)
    {
        if (inwards == null || !inwards.Any())
            return await Task.FromResult(new GridDataProviderResult<Core.Entities.Inward> { Data = new List<Inward>(), TotalCount = 0 });

        return await Task.FromResult(new GridDataProviderResult<Core.Entities.Inward> { Data = inwards, TotalCount = inwards.Count });
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Inward";
        isEditMode = false;
        inward = new Core.Entities.Inward { InwardDate = DateTime.Now, IsActive = true };
        inwardItems = new List<InwardItem>();
        modal.ShowAsync();
    }

    private async Task ShowEditModal(Inward editInward)
    {
        modalTitle = "Edit Inward";
        isEditMode = true;
        inward = new Core.Entities.Inward
        {
            Id = editInward.Id,
            InwardNo = editInward.InwardNo,
            InwardDate = editInward.InwardDate,
            ShipMentCompanyId = editInward.ShipMentCompanyId,
            InvoiceNo = editInward.InvoiceNo,
            InvoiceDate = editInward.InvoiceDate,
            ChallanNo = editInward.ChallanNo,
            Remarks = editInward.Remarks,
            IsActive = editInward.IsActive
        };
        
        var items = await InwardService.GetInwardItemsByInwardIdAsync(editInward.Id);
        inwardItems = items.ToList();
        
        modal.ShowAsync();
    }

    private void AddInwardItem()
    {
        inwardItems.Add(new Core.Entities.InwardItem { Unit = "PCS" });
    }

    private void RemoveInwardItem(int index)
    {
        inwardItems.RemoveAt(index);
    }

    private async Task SaveInward()
    {
        try
        {
            if (!inwardItems.Any())
            {
                // Toast notification removed
                return;
            }

            inward.InwardItems = inwardItems;

            if (isEditMode)
            {
                await InwardService.UpdateAsync(inward);
                // Toast notification removed
            }
            else
            {
                await InwardService.AddAsync(inward);
                // Toast notification removed
            }

            await HideModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            // Toast notification removed
        }
    }

    private async Task DeleteInward(int id)
    {
        try
        {
            await InwardService.DeleteAsync(id);
            // Toast notification removed
            await LoadData();
        }
        catch (Exception ex)
        {
            // Toast notification removed
        }
    }

    private void ViewDetails(int id)
    {
        // Navigate to details page or show details modal
        // Toast notification removed
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }

} *@