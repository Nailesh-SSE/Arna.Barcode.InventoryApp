@using InventoryManagement.Services.DTO
@inject IJSRuntime JS
@implements IAsyncDisposable
<Modal @ref="modal" Title="@Title" Size="ModalSize.ExtraLarge" UseStaticBackdrop OnHidden="@Hide">
    <BodyTemplate>
        <div class="p-2">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                    <button type="button" class="btn-close" @onclick="@(() => successMessage = "")"></button>
                </div>
            }
        </div>
        <fieldset disabled="@DisableFields">
            <div class="col-12 mb-2">
                <div class="position-relative">

                @if (isScanning)
                {
                    <button type="button"
                            class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                            title="Close Camera"
                            style="z-index: 10;"
                            @onclick="CloseCamera">
                        <Icon Name="IconName.XCircle" />
                    </button>
                    <div class="scanner-wrapper">
                        <div id="reader"></div>
                    </div>
                }
            </div>
            @if (CanCreate)
            {
                <!-- BARCODE SECTION -->
                <div class="d-flex align-items-center gap-2 mb-3 flex-nowrap">
                    <InputText class="form-control flex-grow-1"
                               placeholder="Enter Barcode"
                               @bind-Value="ItemsModel.BarCodeNo" />

                    <button type="button"
                            class="btn btn-secondary d-flex align-items-center gap-1"
                            @onclick="StartCameraScan"
                            disabled="@isScanning">
                        <Icon Name="IconName.Camera" /> Scan
                    </button>

                    <Button Class="btn btn-dark" @onclick="HandleBarcode">Validate</Button>
                </div>          
            }       

            <!-- ITEMS TABLE -->
            @if (ItemsList.Any())
            {
                <div class="table-responsive" style="height: 650px; overflow-y: auto;">
                    <table class="table table-bordered table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="col-3 col-md-3">Product <span class="text-danger">*</span></th>
                                <th class="col-2">Ship To </th>
                                <th class="col-1">Unit <span class="text-danger">*</span></th>
                                <th class="col-1">Qty <span class="text-danger">*</span></th>
                                <th class="col-2">Lot No</th>
                                <th class="col-1">Type <span class="text-danger">*</span></th>
                                <th class="col-1">To Stock</th>
                                <th class="col-2">Reason</th>
                                <th class="col-2 text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in ItemsList)
                            {                              
                                    bool isLocked = item.Id > 0 && item.IsTakeInStock;
                                    bool noPermission = !CanCreate;
                                    bool isDisabled = isLocked || noPermission;
                                

                                <tr class="@(isDisabled ? "table-success text-muted disabled-row" : "")"
                                    title="@(isLocked
                                                ? "This item is already taken in stock. You cannot edit it."
                                                : noPermission
                                                    ? "You do not have permission to perform this action."
                                                    : "")">
                                    <!-- PRODUCT -->
                                    @* <td>
                                        <InputSelect class="form-select" @bind-Value="@item.ProductId">
                                            <option value="0">Select</option>
                                            @foreach (var product in ProductList)
                                            {
                                                <option value="@product.Id">@product.SKU</option>
                                            }
                                        </InputSelect>
                                        @if (showValidation && item.ProductId == 0)
                                        {
                                            <small class="text-danger">Required</small>
                                        }
                                    </td> *@
                                    <td>
                                        <SearchableDropdown TItem="ProductModel"
                                                            Items="@ProductList"
                                                            ItemTextSelector="@(p => p.SKU)"
                                                            SelectedText="@item.ProductSearchText"
                                                            Placeholder="Search product..."
                                                            OnItemSelected="@(p => OnProductDropdownSelected(item, p))"
                                                            ShowValidationMessage="@(showValidation && item.ProductId == 0 && IsLastUnsavedItem(item))"
                                                            IsDisabled="@isDisabled" />
                                        @if (showValidation && item.ProductId == 0)
                                        {
                                            <small class="text-danger">Required</small>
                                        }
                                    </td>

                                    <!-- SHIP TO -->
                                    <td>
                                        <InputSelect class="form-select" @bind-Value="@item.ShipToCompanyId" disabled="@isDisabled">
                                            <option value="0">Select</option>
                                            @foreach (var ship in CompanyList)
                                            {
                                                <option value="@ship?.Id">@ship?.Name</option>
                                            }
                                        </InputSelect>
                                        @* @if (showValidation && item.ShipToCompanyId == 0 && IsLastUnsavedItem(item))
                                            {
                                                <small class="text-danger">Required</small>
                                            } *@
                                    </td>

                                    <!-- UNIT -->
                                    <td>
                                        <InputSelect class="form-select" @bind-Value="@item.UnitId" disabled="@isDisabled">
                                            <option value="0">Select</option>
                                            @foreach (var unit in Units)
                                            {
                                                <option value="@unit.Id">@unit.Name</option>
                                            }
                                        </InputSelect>
                                        @if (showValidation && item.UnitId == 0 && IsLastUnsavedItem(item))
                                        {
                                            <small class="text-danger">Required</small>
                                        }
                                    </td>

                                    <!-- QTY (NARROW) -->
                                    <td class="col-1">
                                        <InputNumber class="form-control p-1" min="1" @bind-Value="@item.ReturnQuantity" disabled="@isDisabled" />
                                        @if (showValidation && item.ReturnQuantity <= 0 && IsLastUnsavedItem(item))
                                        {
                                            <small class="text-danger">Min 1</small>
                                        }
                                    </td>

                                    <!-- OUTWARD (WIDER) -->
                                    @* <td style="width:150px;">
                                        <InputSelect class="form-select" @bind-Value="@item.OutwardId">
                                            <option value="0">Select</option>
                                            @foreach (var outward in OutwardList)
                                            {
                                                <option value="@outward?.Id">@outward?.OutwardNo</option>
                                            }
                                        </InputSelect>
                                    </td> *@
                                    <td style="width:100px;">
                                        <SearchableDropdown TItem="OutwardModel"
                                                            Items="OutwardList"
                                                            ItemTextSelector="@(o => o.OutwardNo)"
                                                            SelectedText="@item.OutwardSearchText"
                                                            Placeholder="Search Outward..."
                                                            OnItemSelected="@(o => OnOutwardDropdownSelected(item, o))"
                                                            IsDisabled="@isDisabled" />
                                    </td>

                                    <!-- RETURN TYPE -->
                                    <td>
                                        <InputSelect class="form-select" @bind-Value="@item.ReturnType" disabled="@isDisabled">
                                            <option value="0">Select</option>
                                            @foreach (var type in Enum.GetValues(typeof(ReturnType)))
                                            {
                                                <option value="@((int)type)">@type</option>
                                            }
                                        </InputSelect>
                                        @if (showValidation && item.ReturnType == 0 && IsLastUnsavedItem(item))
                                        {
                                            <small class="text-danger">Required</small>
                                        }
                                    </td>

                                    <!-- TAKE TO STOCK -->
                                    <td>
                                        <InputSelect TValue="bool"
                                                     class="form-select"
                                                     @bind-Value="item.IsTakeInStock"
                                                     disabled="@isDisabled">

                                            <option value="true">Yes</option>
                                            <option value="false">No</option>

                                        </InputSelect>
                                    </td>

                                    <!-- REASON -->
                                    <td class="col-1">
                                        <InputText class="form-control" @bind-Value="@item.ReasonToReturn" disabled="@isDisabled" />
                                    </td>

                                    <!-- ACTION (ONE LINE, TIGHT) -->
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            @if (CanCreate)
                                            {
                                                <Button Class="btn btn-success btn-sm p-1" title="Save"
                                                        @onclick="(() => HandleSubmit(item))" disabled="@isDisabled">
                                                    <Icon Name="IconName.Floppy" />
                                                </Button>
                                            }

                                            @if (item.Id > 0)
                                            {
                                                @if (CanDelete)
                                                {
                                                    <Button Class="btn btn-danger btn-sm p-1" title="Delete"
                                                            @onclick="(() => HandleDelete(item.Id))">
                                                        <Icon Name="IconName.Trash" />
                                                    </Button>
                                                }
                                            }
                                            else
                                            {
                                                <Button Class="btn btn-secondary btn-sm p-1" title="Cancel"
                                                        @onclick="(() => RemoveUnSaveItem(item))">
                                                    <Icon Name="IconName.XCircle" />
                                                </Button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-end mt-3">
                        <button type="button"
                                disabled="@hideAddNewButton"
                                class="btn btn-success "
                                @onclick="HandleAddItem">
                            <i class="bi bi-plus-circle me-1"></i>Add New Item
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-3 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No items added yet. Click "Add Item" to get started.
                </div>
                <div class="text-end mt-3">
                    <button type="button"
                            disabled="@hideAddNewButton"
                            class="btn btn-success "
                            @onclick="HandleAddItem">
                        <i class="bi bi-plus-circle me-1"></i>Add New Item
                    </button>
                </div>
            }
            <div class="text-start mt-3">
                <button type="button" class="btn btn-secondary me-2" @onclick="HandleClose">Close</button>
            </div>
        </div>
        </fieldset>
    </BodyTemplate>
</Modal>

@code {
    private Modal modal = new();
    [Parameter] public string Title { get; set; } = "Sale Return";
    private Grid<SaleReturnItemsModel> ItemsGrid { get; set; }
    private string? errorMessage { get; set; }
    private string? successMessage { get; set; }
    private bool showValidation = false;
    private bool hideAddNewButton = false;
    private bool isScanning = false;
    private DotNetObjectReference<SaleReturnItemsFormModal>? dotNetHelper;
    private InputText barcodeInput = default!;

    // private EditContext editContext;
    // private ValidationMessageStore? validationMessage;

    [Parameter] public SaleReturnModel? SelectedSaleReturn { get; set; }
    [Parameter] public SaleReturnItemsModel ItemsModel { get; set; } = new();
    [Parameter] public List<SaleReturnItemsModel?> ItemsList { get; set; } = new();
    [Parameter] public OperationResponse? ResponseDto { get; set; } = new();

    [Parameter] public List<ProductModel?> ProductList { get; set; } = new();
    [Parameter] public List<CompanyModel?> CompanyList { get; set; } = new();
    [Parameter] public List<OutwardModel?> OutwardList { get; set; } = new();

    private System.Threading.Timer? errorTimer;
    public List<UnitModel> Units => CommonUtils.UnitList;
    [Parameter] public bool CanCreate { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public EventCallback<SaleReturnItemsModel> OnSave { get; set; }
    [Parameter] public EventCallback<OperationResponse> OnSaveResponse { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback AddItemRow { get; set; }
    [Parameter] public EventCallback OnBarcodeVal { get; set; }
    [Parameter] public EventCallback<SaleReturnItemsModel> RemoveItemRow { get; set; }
    
    [Parameter] public bool DisableFields { get; set; }
    
    // protected override void OnParametersSet()
    // {
    //     InitializeEditContext();
    // }

    // private void InitializeEditContext()
    // {
    //     editContext = new EditContext(ItemsModel);
    //     validationMessage = new ValidationMessageStore(editContext);

    // }
    private bool IsLastUnsavedItem(SaleReturnItemsModel item)
    {
        return item.Id == 0;
    }
    public async Task Show()
    {
        ResetUiState();
        var mo = ItemsModel;
        if (ItemsList == null || ItemsList.Count == 0)
        {
            await AddItemRow.InvokeAsync();
        }
        await modal.ShowAsync();
    }

    private async Task HandleSubmit(SaleReturnItemsModel item)
    {
        await ClearMessages();

        if (!ValidateSaleReturnItem(item))
        {
            StateHasChanged();
            return;
        }

        await OnSave.InvokeAsync(item);

        // successMessage = item.Id == 0
        //     ? "Sale return item added successfully."
        //     : "Sale return item updated successfully.";

        showValidation = false;
        hideAddNewButton = false;
        StateHasChanged();
    }

    private async Task HandleDelete(int itemId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete this item?");

        if (!confirmed) return;
        if (itemId == 0)
        {
            return;
        }
        await OnDelete.InvokeAsync(itemId);

    }
    public async Task HandleResponse(OperationResponse ResponseDto)
    {
        if (ResponseDto.IsSuccess)
        {
            successMessage = ResponseDto.Message;
            _ = AutoHideAlertAsync();
        }
        else
        {
            errorMessage = ResponseDto.Message;
            _ = AutoHideAlertAsync();
        }
    }
    private void ShowSuccessMessage(string message)
    {

        successMessage = message;
        _ = AutoHideAlertAsync();
    }
    private void ShowErrorMessage(string message)
    {
        errorMessage = message;
        _ = AutoHideAlertAsync();
    }
    private async Task AutoHideAlertAsync()
    {
        await Task.Delay(4500);
        errorMessage = string.Empty;
        successMessage = string.Empty;
        await InvokeAsync(StateHasChanged);
    }
    private async Task HandleAddItem()
    {
        await ClearMessages();

        var hasBlankRow = ItemsList.Any(item =>
            item.Id == 0 &&
            (item.ProductId == 0 ||
             item.UnitId == 0 ||
             item.ReturnQuantity <= 0 ||
             item.ReturnType == 0));

        if (hasBlankRow)
        {
            showValidation = true;
            return;
        }

        showValidation = false;
        hideAddNewButton = true;

        await AddItemRow.InvokeAsync();
    }
    private async Task ValidateBarcode(string? barcode)
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowErrorMessage("Barcode is required.");
            return;
        }

        barcode = barcode.Trim();
        if (barcode.Length != 16)
        {
            ShowErrorMessage("Barcode must be exactly 16 characters .");
            return;
        }
    }
    private bool ValidateSaleReturnItem(SaleReturnItemsModel item)
    {
        showValidation = true;

        if (item.ProductId == 0)
        {
            ShowErrorMessage("Product is required.");
            return false;
        }

        if (item.ReturnQuantity <= 0)
        {
            ShowErrorMessage("Return quantity must be greater than 0.");
            return false;
        }

        if (item.UnitId == 0)
        {
            ShowErrorMessage("Unit is required.");
            return false;
        }

        if (item.ReturnType == 0)
        {
            ShowErrorMessage("Return Type Required");
            return false;
        }
        errorMessage = "";
        return true;
    }
    private void OnProductDropdownSelected(SaleReturnItemsModel saleReturnItem, ProductModel product)
    {
        ClearMessages();

        if (product is null)
        {
            saleReturnItem.ProductSearchText = "";
            saleReturnItem.ProductId = 0;
            return;
        }

        saleReturnItem.ProductId = product.Id;
        saleReturnItem.ProductSearchText = product.SKU;
    }
    private void OnOutwardDropdownSelected(SaleReturnItemsModel saleReturnItem, OutwardModel outward)
    {
        ClearMessages();

        if (outward is null)
        {
            saleReturnItem.OutwardSearchText = "";
            saleReturnItem.OutwardId = 0;
            return;
        }

        saleReturnItem.OutwardId = outward.Id;
        saleReturnItem.OutwardSearchText = outward.OutwardNo;
    }
    private async Task ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
    }

    private async Task HandleBarcode()
    {
        await ValidateBarcode(ItemsModel.BarCodeNo);
        if (errorMessage != string.Empty) return;
        await OnBarcodeVal.InvokeAsync();
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    public async Task Hide()
    {
        ResetUiState();
        try
        {
            await JS.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;
        await modal.HideAsync();
        SelectedSaleReturn = null;
        ItemsList.Clear();
    }
    public async Task RemoveUnSaveItem(SaleReturnItemsModel item)
    {
        hideAddNewButton = false;
        await RemoveItemRow.InvokeAsync(item);

    }
    private void ResetUiState()
    {
        showValidation = false;
        hideAddNewButton = false;
        errorMessage = "";
        successMessage = "";
    }

    private async Task StartCameraScan()
    {
        if (isScanning) return;

        try
        {
            isScanning = true;
            await Task.Yield();
            dotNetHelper?.Dispose();
            dotNetHelper = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("manageScanner.start", dotNetHelper);
        }
        catch (Exception)
        {
            isScanning = false;
            ShowError("Could not start camera");
        }
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string scannedBarcode)
    {
        errorMessage = string.Empty;
        if (dotNetHelper == null) return;

        if (string.IsNullOrWhiteSpace(scannedBarcode))
            return;

        ItemsModel.BarCodeNo = scannedBarcode;

        isScanning = false;

        await HandleBarcode();
        StateHasChanged();

    }

    public async Task CloseCamera()
    {
        try
        {
            await JS.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;

        if (barcodeInput != null &&
         barcodeInput.Element.HasValue)
        {
            await barcodeInput.Element.Value.FocusAsync();
        }
    }
    private void ShowError(string message)
    {
        errorMessage = message;
        //showErrorMessage = true;
        StateHasChanged();

        errorTimer?.Dispose();
        errorTimer = new System.Threading.Timer(_ =>
        {
            //     showErrorMessage = false;
            errorMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("manageScanner.stop");
        }
        catch
        {
        }

        dotNetHelper?.Dispose();
        dotNetHelper = null;

        isScanning = false;
    }
}
<style>
    .scanner-wrapper {
        width: 100%;
        max-width: 600px; /* camera width */
        height: 350px; /* camera height */
        margin: 0 auto;
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    #reader {
        width: 100%;
        height: 100%;
    }

        /* Force video to stay inside box */
        #reader video {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover;
        }

    /* Center scan box */
    #reader__scan_region {
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<script>
    let html5QrcodeScanner;

    window.manageScanner = {
        start: (dotNetHelper) => {
            if (html5QrcodeScanner) { return; }

            html5QrcodeScanner = new Html5Qrcode("reader");

            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrcodeScanner.start({ facingMode: "environment" }, config,
                (decodedText, decodedResult) => {
                    // SUCCESS:
                    // 1. Stop the camera immediately so it doesn't scan twice
                    // 2. Clear the variable and DOM
                    // 3. Send result to C#
                    window.manageScanner.stop().then(() => {
                        dotNetHelper.invokeMethodAsync('OnBarcodeScanned', decodedText)
                            .catch(err => console.log("Blazor component disposed", err));
                    });
                },
                (errorMessage) => {
                    // ignore errors
                })
            .catch(err => {
                console.error("Error starting scanner", err);
                alert("Could not start camera. Permissions?");
            });
        },

        stop: () => {
            return new Promise((resolve, reject) => {
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        html5QrcodeScanner.clear();
                        html5QrcodeScanner = null;
                        document.getElementById("reader").innerHTML = "";
                        resolve();
                    }).catch(err => {
                        console.log("Error stopping scanner", err);
                        html5QrcodeScanner = null;
                        resolve();
                    });
                } else {
                    resolve();
                }
            });
        },
        forceStop: () => {
            if (!html5QrcodeScanner) return;

            try
            {
                html5QrcodeScanner.stop();
                html5QrcodeScanner.clear();
            }
            catch (e)
            {
                console.warn("Scanner stop error", e);
            }

            html5QrcodeScanner = null;

            const reader = document.getElementById("reader");
            if (reader) reader.innerHTML = "";
        }
    };
</script>