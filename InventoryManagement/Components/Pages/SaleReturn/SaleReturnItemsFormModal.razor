

<Modal @ref="modal" Title="@Title" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div>
            <div class="d-flex gap-2 mb-3">
                <InputText class="form-control"
                           placeholder="Enter Barcode"
                           @bind-Value="ItemsModel.BarCodeNo" />

                <Button Class="btn btn-dark" @onclick="HandleBarcode">Validate</Button>
                @* <Button Class="btn btn-primary" type="submit">Save</Button> *@
            </div>
            <div class="table-responsive" style="height:450px;overflow-y:auto">
                @if (ItemsList.Any())
                {
                    <div class="table-responsive" style="height:450px; overflow-y:auto;">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="col-3 col-md-2">Product</th>
                                    <th class="col-2 col-md-1">Ship To</th>
                                    <th class="col-1 col-md-1">Unit</th>
                                    <th class="col-1 col-md-1">Qty</th>
                                    <th class="col-2 col-md-1">Lot No</th>
                                    <th class="col-2 col-md-1">Type</th>
                                    <th class="col-2 col-md-1">To Stock</th>
                                    <th class="col-3 col-md-2">Reason</th>
                                    <th class="col-1 col-md-1">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in ItemsList)
                                {
                                    <tr>

                                        <!-- PRODUCT -->
                                        <td>
                                            <InputSelect class="form-select" @bind-Value="@item.ProductId">
                                                <option value="0">Select</option>
                                                @foreach (var product in ProductList)
                                                {
                                                    <option value="@product.Id">@product.SKU</option>
                                                }
                                            </InputSelect>
                                        </td>

                                        <!-- SHIP TO -->
                                        <td>
                                            <InputSelect class="form-select" @bind-Value="@item.ShipToCompanyId">
                                                <option value="0">Select</option>
                                                @foreach (var ship in CompanyList)
                                                {
                                                    <option value="@ship?.Id">@ship?.Name</option>
                                                }
                                            </InputSelect>
                                        </td>

                                        <!-- UNIT -->
                                        <td>
                                            <InputSelect class="form-select" @bind-Value="@item.UnitId">
                                                <option value="0">Select</option>
                                                @foreach (var unit in Units)
                                                {
                                                    <option value="@unit.Id">@unit.Name</option>
                                                }
                                            </InputSelect>
                                        </td>

                                        <!-- QTY -->
                                        <td>
                                            <InputNumber class="form-control " min="1" @bind-Value="@item.ReturnQuantity" />
                                        </td>

                                        <!-- LOT NO -->
                                        <td>
                                            <InputSelect class="form-select" @bind-Value="@item.OutwardId">
                                                <option value="0">Select</option>
                                                @foreach (var outward in OutwardList)
                                                {
                                                    <option value="@outward?.Id">@outward?.OutwardNo</option>
                                                }
                                            </InputSelect>
                                        </td>

                                        <!-- RETURN TYPE -->
                                        <td>
                                            <InputSelect class="form-select" @bind-Value="item.ReturnType">
                                                <option value="">Select</option>
                                                @foreach (var type in Enum.GetValues(typeof(ReturnType)))
                                                {
                                                    <option value="@((int)type)">@type</option>
                                                }
                                            </InputSelect>
                                        </td>

                                        <!-- TAKE TO STOCK -->
                                        <td>
                                            <InputSelect class="form-select" @bind-Value="@item.IsTakeInStock">
                                                @foreach (var take in TakeToStock)
                                                {
                                                    <option value="@take?.Id">@take?.Name</option>
                                                }
                                            </InputSelect>
                                        </td>

                                        <!-- REASON -->
                                        <td>
                                            <InputText class="form-control" @bind-Value="@item.ReasonToReturn" />
                                        </td>

                                        <!-- ACTIONS -->
                                        <td>
                                            <Button Class="p-1" title="Save" @onclick="(() => HandleSubmit(item))">
                                                <Icon Name="IconName.Floppy" />
                                            </Button>

                                            <!-- DELETE -->
                                            <Button Class="p-1" title="Delete" @onclick="(() => HandleDelete(item.Id))">
                                                <Icon Name="IconName.Trash" />
                                            </Button>

                                            <!-- PDF -->
                                            <Button Class="p-1" title="Generate PDF">
                                                <Icon Name="IconName.FileEarmarkPdf" />
                                            </Button>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>



                    </div>
                
                }
            </div>
            <!-- ADD NEW ITEM BUTTON -->
            <div class="text-center mt-2">
                <button type="button"
                        class="btn btn-success btn-sm"
                        @onclick="HandleAddItem">
                    <i class="bi bi-plus-circle me-1"></i>Add New Item
                </button>
            </div>
        </div>

    </BodyTemplate>
</Modal>


@code {
    private Modal modal = new();
    [Parameter] public string Title { get; set; } = "Sale Return";
    private Grid<SaleReturnItemsModel> ItemsGrid { get; set; }

    // private EditContext editContext;
    // private ValidationMessageStore? validationMessage;

    [Parameter] public SaleReturnModel SelectedSaleReturn { get; set; } = new();
    [Parameter] public SaleReturnItemsModel ItemsModel { get; set; } = new();
    [Parameter] public List<SaleReturnItemsModel?> ItemsList { get; set; } = new();

    [Parameter] public List<ProductModel?> ProductList { get; set; } = new();
    [Parameter] public List<CompanyModel?> CompanyList { get; set; } = new();
    [Parameter] public List<OutwardModel?> OutwardList { get; set; } = new();

    public List<UnitModel> Units => CommonUtils.UnitList;
    public List<TakeToStockModel> TakeToStock => CommonUtils.TaskeToList;

    [Parameter] public EventCallback<SaleReturnItemsModel> OnSave { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback AddItemRow { get; set; }
    [Parameter] public EventCallback OnBarcodeVal { get; set; }


    // protected override void OnParametersSet()
    // {
    //     InitializeEditContext();
    // }

    // private void InitializeEditContext()
    // {
    //     editContext = new EditContext(ItemsModel);
    //     validationMessage = new ValidationMessageStore(editContext);
    // }

    public async Task Show()
    {
        if (ItemsList == null || ItemsList.Count==0)
        {
            await AddItemRow.InvokeAsync();
           // await HandleAddItem();
        }
        await modal.ShowAsync();
    }

    private async Task HandleSubmit(SaleReturnItemsModel item)
    {
        if (item.ProductId == 0)
        {
            return;
        }
        if (item.UnitId == 0)
        {
            return;
        }
        if (item.ReturnQuantity <= 0)
        {
            return;
        }
        if (item.ReturnType == 0)
        {
            return;
        }

        await OnSave.InvokeAsync(item);
    }

    private async Task HandleDelete(int itemId)
    {
        if (itemId == 0)
        {
            return;
        }
        await OnDelete.InvokeAsync(itemId);

    }

    private async Task HandleAddItem()
    {
        await AddItemRow.InvokeAsync();

    }

    private async Task HandleBarcode()
    {
        await OnBarcodeVal.InvokeAsync();
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    public async Task Hide()
    {
        await modal.HideAsync();
    }




}
