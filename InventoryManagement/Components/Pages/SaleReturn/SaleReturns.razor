@page "/sale-returns"
@inject ISaleReturnService SaleReturnService
@inject ICompanyService CompanyService
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IOutwardService OutwardService
@inject IPlatformService PlatformService
@using InventoryManagement.Services.DTO

@inject IJSRuntime JSRuntime

@inherits InventoryManagement.Components.Auth.AuthComponentBase
<PageTitle>Sale Return Management</PageTitle>
@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    <div>

        <div class="row mb-3">
            <div class="col">
                <h3>Sale Return Management</h3>
            </div>
            <div class="col-auto">
                @if (CanCreate(Route))
                {
                    <button class="btn btn-primary" @onclick="ShowAddModal">
                        <Icon Name="IconName.Plus" />  Add New Sale Return
                    </button>
                }
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div>
            <div class="spinner-border text-light" role="status"></div>
        </div>
    }
    else
    {
        <SaleReturnTable SaleReturns="saleReturnList"
        BillToCompanies="BillToCompanyList"
        OnEditSaleReturn="ShowEditModal"
        OnAddItems="OpenItemModel" CanEdit="CanEdit(Route)" CanDelete="CanDelete(Route)" CanCreate="CanCreate(Route)" />
    }

    <SaleReturnFormModal @ref="saleReturnFormModal"
    Title="@modalTitle"
    SaleReturnModel="saleReturn"
    BillToCompanyList="BillToCompanyList"
    OnSave="SaveSaleReturn"
    OnCancel="HideModal"
    OnEditMode="isEditMode" 
    Disablefields="disablefields"/>

    <SaleReturnItemsFormModal @ref="saleReturnItemsFormModal"
    Title="@itemTitle"
    SelectedSaleReturn="selectedSaleReturn"
    ItemsList="SaleReturnItems"
    ItemsModel="itemsModel"
    PlatformList="PlatformList"
    ProductList="ProductList"
    CompanyList="ShipToCompanyList"
    BillToCompanyList="BillToCompanyList"
    OutwardList="OutwardList"
    OnBarcodeVal="ValidateBarcode"
    OnClose="HideItemModal"
    OnDelete="DeleteSaleReturnItem"
    OnSave="SaveSaleReturnItem"
    OnSaveResponse="HandleResponse"
    AddItemRow="AddEmptyItemRow"
    RemoveItemRow="RemoveItemrow" 
    DisableFields="@disableitemfields"
    CanCreate = "CanCreate(Route)"
    CanDelete = "CanDelete(Route)"
    CanEdit = "CanEdit(Route)" />
}
@code
{
    private bool isLoading = true;
    private bool isEditMode = false;
    private string modalTitle = "Add Sale Return";
    private string itemTitle = "Sale Return Items";

    private SaleReturnModel saleReturn = new();
    private SaleReturnModel? selectedSaleReturn;
    private SaleReturnItemsModel itemsModel { get; set; } = new();
    private List<SaleReturnModel> saleReturnList = new();
    private List<SaleReturnItemsModel>? SaleReturnItems { get; set; } = new();

    private List<CompanyModel> BillToCompanyList = new();
    private List<CompanyModel> ShipToCompanyList = new();
    private List<ProductModel> ProductList = new();
    private List<ProductModel> FilteredProducts { get; set; } = new();
    private List<OutwardModel> OutwardList { get; set; } = new();
    private List<PlatformModel> PlatformList { get; set; } = new();

    private SaleReturnFormModal? saleReturnFormModal;
    private SaleReturnItemsFormModal? saleReturnItemsFormModal;
    private List<UnitModel> Units => CommonUtils.UnitList;

    private string validationMessage = string.Empty;
    private bool validationIsValid = false;
    private string Route = "/sale-returns";
    private bool disablefields;
    private bool disableitemfields;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await base.OnInitializedAsync();
        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }
        await LoadData();
        isLoading = false;
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            isAdmin = IsAdmin() || IsFactoryAdmin();

            saleReturnList = (await SaleReturnService.GetAllSaleReturnsAsync(isAdmin)).ToList();
            BillToCompanyList = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.BillTo)).ToList();
            ShipToCompanyList = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.ShipTo)).ToList();
            ProductList = (await ProductService.GetAllProductsAsync()).ToList();
            OutwardList = (await OutwardService.GetAllOutwardsAsync(true)).Where(o => o.IsFinished).ToList();
            PlatformList = (await PlatformService.GetAllPlatformAsync()).ToList();
            FilteredProducts = ProductList;
        }
        catch
        {
            //   ShowError("Connectivity issue happened, operation failed");
        }
        finally
        {
            isLoading = false;
        }
    }
    #region FormModal
    private void ShowAddModal()
    {
        modalTitle = "Add New Sale Return";
        isEditMode = false;
        disablefields = false;
        saleReturn = new SaleReturnModel
        {
            SaleReturnDate = DateTime.Now,
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.Now,
        };
        saleReturnFormModal?.Show();

    }

    private void ShowEditModal(SaleReturnModel editSaleReturn)
    {
        if (CanEdit(Route) == true)
        {
            modalTitle = $"Edit Sale Return - {editSaleReturn.SaleReturnNo}";
            isEditMode = true;
            disablefields = false;
        }
        else
        {
            modalTitle = $"View Sale Return - {editSaleReturn.SaleReturnNo}";
            isEditMode = true;
            disablefields = true;
        }
        saleReturn = new SaleReturnModel
        {
            Id = editSaleReturn.Id,
            SaleReturnDate = editSaleReturn.SaleReturnDate,
            BillToCompanyId = editSaleReturn.BillToCompanyId,
            IsActive = editSaleReturn.IsActive,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
            UpdatedOn = DateTime.Now
        };
        saleReturnFormModal?.Show();
    }

    private async Task SaveSaleReturn()
    {
        isLoading = true;

        if (isEditMode)
        {
            saleReturn.UpdatedBy = Convert.ToInt32(CurrentUserId);
            saleReturn.UpdatedOn = DateTime.Now;
            await SaleReturnService.UpdateSaleReturnAsync(saleReturn);
            await HideModal();
            await LoadData();
        }
        else
        {
            saleReturn.CreatedBy = Convert.ToInt32(CurrentUserId);
            saleReturn.CreatedOn = DateTime.Now;
            var SaleReturnId = await SaleReturnService.CreateSaleReturnAsync(saleReturn);

            await HideModal();
            await LoadData();

            if (SaleReturnId != 0)
            {
                saleReturn.Id = SaleReturnId;
                //   await OpenAddItemModal(saleReturn);
            }
        }
        isLoading = false;

    }
    private async Task HideModal()
    {
        await saleReturnFormModal.Hide();
    }
    #endregion
    #region ItemModal
    private async Task OpenItemModel(SaleReturnModel data)
    {
        if(CanCreate(Route))
        {
            disableitemfields = false;
        }
        else
        {
            disableitemfields = true;
        }
        itemsModel.BarCodeNo = string.Empty;
        selectedSaleReturn = saleReturnList.FirstOrDefault(s => s.Id == data.Id);
        if (selectedSaleReturn == null) return;
        itemTitle = $"Manage SaleReturn Items | SaleReturn No: {data?.SaleReturnNo}";
        modalTitle = "Sale Return  No:" + data.SaleReturnNo;

        SaleReturnItems = await SaleReturnService.GetSaleReturnItemsByReturnId(data.Id);
        await SyncSearchText();

        saleReturnItemsFormModal.ItemsList = SaleReturnItems;
        saleReturnItemsFormModal.SelectedSaleReturn = selectedSaleReturn;

        StateHasChanged();
        await saleReturnItemsFormModal.Show();

    }
    private async Task SaveSaleReturnItem(SaleReturnItemsModel item)
    {
        if (selectedSaleReturn == null || selectedSaleReturn.Id == 0)
        {
            await SendOperationResponse(false, "Sale Return is not selected");
            return;
        }
        bool isUpdate = item.Id > 0;
        item.SaleReturnId = selectedSaleReturn.Id;

        if (!isUpdate)
        {
            item.CreatedBy = Convert.ToInt32(CurrentUserId);
            item.CreatedOn = DateTime.Now;
        }
        else
        {
            item.UpdatedBy = Convert.ToInt32(CurrentUserId);
            item.UpdatedOn = DateTime.Now;
        }

        bool success = isUpdate
            ? await SaleReturnService.UpdateSaleReturnItem(item)
            : await SaleReturnService.CreateSaleReturnItem(item);

        if (!success)
        {
            await SendOperationResponse(false, "Operation failed");
            return;
        }

        SaleReturnItems = await SaleReturnService
            .GetSaleReturnItemsByReturnId(selectedSaleReturn.Id);
        await SyncSearchText();
        await SendOperationResponse(
            true,
            isUpdate ? "Updated successfully" : "Saved successfully"
        );
    }
    private async Task SendOperationResponse(bool isSuccess, string message)
    {
        var ResponseDto = new OperationResponse()
        {
            IsSuccess = isSuccess,
            Message = message
        };
        await HandleResponse(ResponseDto);
    }
    private async Task HandleResponse(OperationResponse Dto)
    {
        await saleReturnItemsFormModal.HandleResponse(Dto);
    }

    private async Task DeleteSaleReturnItem(int itemId)
    {
        var currentUserId = Convert.ToInt32(CurrentUserId);
        var result = await SaleReturnService.DeleteSaleReturnItem(itemId, currentUserId);
        SaleReturnItems = await SaleReturnService.GetSaleReturnItemsByReturnId(selectedSaleReturn.Id);
        await SyncSearchText();

        await SendOperationResponse(
           result,
           result ? "Deleted successfully" : "Task Failed "
        );
    }
    private async Task AddEmptyItemRow()
    {
        await AddNewItemRow(null);
    }
    private async Task SyncSearchText()
    {
        if (SaleReturnItems == null || SaleReturnItems.Count == 0)
            return;

        foreach (var item in SaleReturnItems)
        {
            // PRODUCT
            if (item.ProductId > 0)
            {
                item.ProductSearchText = ProductList
                    ?.FirstOrDefault(p => p.Id == item.ProductId)?.SKU ?? "";
            }

            // OUTWARD
            if (item.OutwardId > 0)
            {
                item.OutwardSearchText = OutwardList
                    ?.FirstOrDefault(o => o.Id == item.OutwardId)?.OutwardNo ?? "";
            }
        }
    }
    private async Task AddNewItemRow(SaleReturnValidationResult? data)
    {
        SaleReturnItems ??= new List<SaleReturnItemsModel>();
        var lastRow = SaleReturnItems.FirstOrDefault(x => x.Id == 0);
        bool isBarcodeScan = data != null && data.ProductId > 0;

        if (lastRow != null)
        {
            bool hasAnyData =
                lastRow.ProductId != 0 ||
                !string.IsNullOrWhiteSpace(lastRow.BarCodeNo);

            if (hasAnyData)
            {
                await SendOperationResponse(false, "Please save the previous item first.");
                return;
            }

            if (!hasAnyData && isBarcodeScan)
            {
                SaleReturnItems.Remove(lastRow);
            }

            if (!hasAnyData && !isBarcodeScan)
            {
                await SendOperationResponse(false, "Please fill or save the previous item first.");
                return;
            }
        }

        string productText = string.Empty;
        if (data?.ProductId > 0)
        {
            productText = ProductList?
                .FirstOrDefault(p => p.Id == data.ProductId)?
                .SKU ?? string.Empty;
        }

        string outwardText = string.Empty;
        if (data?.OutwardId > 0)
        {
            outwardText = OutwardList?
                .FirstOrDefault(o => o.Id == data.OutwardId)?
                .OutwardNo ?? string.Empty;
        }

        SaleReturnItems.Insert(0,new SaleReturnItemsModel
        {
            ProductId = data?.ProductId ?? 0,
            ProductSearchText = productText,
            ShipToCompanyId = data?.ShipToId ?? 0,
            BillToCompanyId = data?.BillToId ?? 0,
            UnitId = data?.UnitId ?? 0,
            OutwardId = data?.OutwardId ?? 0,
            OutwardSearchText = outwardText,
            BarCodeNo = data?.BarcodeNo ?? null,
            ReturnQuantity = data?.UnitId == (int)UnitType.BOX ? 0:1,
            ReturnType = (int)ReturnType.Excess,
            PlatformId = data?.PlatformId ?? 0,
            IsTakeInStock = true
        });

        if (data != null)
        {
            await SendOperationResponse(true, "Barcode validated successfully. Please save to confirm.");
        }
        StateHasChanged();
    }
    private async Task HideItemModal()
    {
        await saleReturnItemsFormModal.Hide();

    }
    private async Task RemoveItemrow(SaleReturnItemsModel item)
    {
        SaleReturnItems.Remove(item);
        StateHasChanged();
    }

    #endregion

    private async Task ValidateBarcode()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(itemsModel.BarCodeNo))
            {
                validationMessage = "Please enter a barcode first.";
                validationIsValid = false;
                return;
            }

            if (selectedSaleReturn?.BillToCompanyId == 0)
            {
                validationMessage = "Please select a company first.";
                validationIsValid = false;
                return;
            }

            var validationResult = await SaleReturnService.ValidateBarcodeForSaleReturnAsync(
                itemsModel.BarCodeNo,
                selectedSaleReturn.BillToCompanyId
            );

            validationIsValid = validationResult.IsValid;
            validationMessage = validationResult.IsValid
               ? $"Valid barcode. Product: {validationResult.ProductName}"
               : validationResult.ErrorMessage;
     
            if (validationResult.IsValid)
            {
                await AddNewItemRow(validationResult);
            }
            else
            {
                await SendOperationResponse(false, validationResult.ErrorMessage);
            }
            StateHasChanged();
        }
        catch
        {
            // validationMessage = "Connectivity issue happened, validation failed";
            // validationIsValid = false;
            StateHasChanged();
        }
    }
}
