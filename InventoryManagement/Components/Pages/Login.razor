@page "/login"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using InventoryManagement.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager

<PageTitle>Arna Technosoft - Login</PageTitle>

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <div class="logo-container">
                <img src="images/ArnaLogo.png" alt="Arna Technosoft" class="logo" />
            </div>
        </div>



        <div class="login-body">
            <p class="login-message">Sign in to start your session</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Envelope" />
                        </span>
                        <InputText @bind-Value="loginModel.Username"
                                   class="form-input"
                                   placeholder="User Name" autofocus />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Username)" class="text-danger small mt-1" />
                </div>

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Lock" />
                        </span>
                        <InputText @bind-Value="loginModel.Password"
                                   class="form-input"
                                   placeholder="Password"
                                   type="@passwordInputType" />
                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                            <i class="@passwordToggleIcon"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary login-btn" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        SIGN IN
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

</div>



@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;
    private string? returnUrl;
    private CancellationTokenSource _cts = new CancellationTokenSource();


    private string passwordInputType => showPassword ? "text" : "password";
    private string passwordToggleIcon => showPassword ? "bi bi-eye-slash" : "bi bi-eye";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await NavigateToReturnUrl();
                return;
            }
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogWarning(ex, "JSDisconnectedException occurred during login initialization.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking initial authentication state");
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            await Task.Yield();
            StateHasChanged();

            // Validate credentials
            var isValid = await UserService.AuthenticateAsync(loginModel.Username, loginModel.Password);

            if (isValid)
            {
                var user = await UserService.GetUserByUsernameAsync(loginModel.Username);
                if (user == null)
                {
                    errorMessage = "User account not found";
                    Logger.LogWarning("User authenticated but account not found for username: {Username}", loginModel.Username);
                    return;
                }

                // Mark user as authenticated using the AuthenticationStateProvider
                var authProvider = AuthStateProvider as CustomAuthStateProvider;
                if (authProvider != null)
                {
                    await authProvider.MarkUserAsAuthenticated(new AuthData
                    {
                        UserId = user.Id.ToString(),
                        UserName = user.UserName ?? loginModel.Username,
                        UserFullName = user.UserName + " " + user.LastName ?? loginModel.Username,
                        UserRoleId = user.RoleId.ToString(),
                        IsAuthenticated = true,
                        LoginTime = DateTime.UtcNow,
                        UserRoleLevel = user.RoleLevel.ToString()
                    });

                    Logger.LogInformation("User {Username} logged in successfully", loginModel.Username);
                    await NavigateToReturnUrl();
                }
                else
                {
                    errorMessage = "Authentication service not available";
                    Logger.LogError("Could not cast AuthStateProvider to CustomAuthStateProvider");
                }
            }
            else
            {
                errorMessage = "Invalid username or password";
                Logger.LogWarning("Failed login attempt for username: {Username}", loginModel.Username);
            }
        }
        catch (ObjectDisposedException ex)
        {
            Logger.LogError(ex, "DbContext disposed during login for user {Username}", loginModel.Username);
            errorMessage = "System error. Please try again.";
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Login operation was cancelled for user {Username}", loginModel.Username);
            errorMessage = "Login cancelled. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login failed for user {Username}", loginModel.Username);
            errorMessage = "Login failed. Please try again later.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NavigateToReturnUrl()
    {
        if (!string.IsNullOrEmpty(returnUrl))
        {
            // Validate the return URL to prevent open redirect attacks
            if (IsValidReturnUrl(returnUrl))
            {
                NavigationManager.NavigateTo(returnUrl, false);
            }
            else
            {
                Logger.LogWarning("Invalid return URL detected: {ReturnUrl}", returnUrl);
                NavigationManager.NavigateTo("/", false);
            }
        }
        else
        {
            NavigationManager.NavigateTo("/", false);
        }
    }

    private bool IsValidReturnUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
            return false;
        // Ensure the URL is relative and doesn't contain suspicious characters
        return url.StartsWith("/") &&
               !url.Contains("://") &&
               !url.Contains("..") &&
               !url.ToLower().Contains("<script") &&
               !url.ToLower().Contains("javascript:");
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    public void Dispose()
    {
        try
        {
            _cts?.Cancel();
            _cts?.Dispose();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error disposing Login component");
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";
    }

}