@page "/login"
@using Microsoft.AspNetCore.WebUtilities
@layout LoginLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Arna Technosoft</PageTitle>

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <div class="logo-container">
                <img src="images/ArnaLogo.png" alt="Arna Technosoft" class="logo" />
            </div>
        </div>

        <div class="login-body">
            <p class="login-message">Sign in to start your session</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">
                    <span>@errorMessage</span>
                </div>
            }

            <form action="account/login" method="post">
                <AntiforgeryToken />

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Envelope" />
                        </span>
                        <input type="text"
                               name="username"
                               class="form-input"
                               placeholder="User Name"
                               maxlength="50"
                               required />
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-container" style="position: relative;">
                        <span class="input-icon">
                            <Icon Name="IconName.Lock" />
                        </span>

                        <input type="@passwordInputType"
                               name="password"
                               class="form-input"
                               placeholder="Password"
                               maxlength="50"
                               required />

                        <button type="button"
                                class="toggle-password-btn"
                                @onclick="TogglePasswordVisibility"
                                style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none;">
                            @if (isPasswordVisible)
                            {
                                <Icon Name="IconName.EyeFill" />
                            }
                            else
                            {
                                <Icon Name="IconName.EyeSlash" />
                            }
                        </button>
                    </div>
                </div>


                <div class="form-group">
                    <button type="submit" class="login-button">Sign In</button>
                </div>

                <input type="hidden" name="returnUrl" value="@returnUrl" />
            </form>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private string? returnUrl;
    private bool isPasswordVisible = false;
    private string passwordInputType => isPasswordVisible ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }
    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        returnUrl = query.TryGetValue("returnUrl", out var url) ? url.ToString() : "/";
        errorMessage = query.TryGetValue("error", out var error) ? error.ToString() : null;
    }

    private void ClearError() => errorMessage = null;
}