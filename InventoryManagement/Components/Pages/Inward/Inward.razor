@page "/inward"
@using BlazorDownloadFile
@using InventoryManagement.Components.Auth
@inherits AuthComponentBase
@inject IInwardService InwardService
@inject ICompanyService CompanyService
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IBlazorDownloadFileService BlazorDownloadFileService
@inject IJSRuntime JS

<PageTitle>Inward Management</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>Inward Management</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowAddModal">
                <Icon Name="IconName.Plus" />  Add New Inward
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center bg-dark bg-opacity-50"
             style="z-index: 1050;">
            <div class="spinner-border text-light" role="status"></div>
        </div>
    }
    else
    {
        <InwardTable Inwards="inwards" ShipCompanies="shipCompanies" OnEdit="ShowEditModal" OnDelete="DeleteInward" OnAddItems="OpenAddItemModal" />
    }
</div>

<InwardFormModal @ref="inwardFormModal" Title="@modalTitle" Inward="inward" ShipCompanies="shipCompanies" Categories="categories"
                 Products="products" OnSave="SaveInward" OnCancel="HideModal" />

<InwardItemsModal @ref="itemsModal" Title="@itemTitle" SelectedInward="selectedInward" InwardItems="inwardItems" FilteredProducts="filteredProductsbyCategory" Brands="filteredBrandsByCategory"
                  OnSave="SaveInwardItems" OnSaveItem="SaveSingleItem" OnDeleteItem="DeleteSingleItem" OnDownloadPdf="DownloadSingleItemPdf" OnAddItem="AddNewItemRow"
                  OnRemoveUnsaved="RemoveUnsavedItem" OnClose="HideItemModal" />

@code {
    private List<InwardModel> inwards = new();
    private List<CompanyModel> shipCompanies = new();
    private List<CompanyModel> MakeCompanies = new();
    private List<CompanyModel> filteredBrandsByCategory = new();
    private List<ProductModel> products = new();
    private List<ProductModel> filteredProductsbyCategory = new();
    private List<ProductModel> filteredProducts = new();
    private List<CategoryModel> categories = new();
    private InwardModel inward = new();
    private List<InwardItemModel> inwardItems = new();
    private bool isLoading = true;
    private string modalTitle = "Add Inward";
    private string itemTitle = "Manage Inward Items";
    private bool isEditMode = false;
    private InwardFormModal inwardFormModal = new();
    private InwardItemsModal itemsModal = new();
    private InwardModel? selectedInward;
    private List<UnitModel> Units => CommonUtils.UnitList;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        StateHasChanged();
        inwards = (await InwardService.GetAllAsync()).ToList();
        shipCompanies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.ShipTo)).ToList();
        MakeCompanies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.MakeTo)).ToList();
        categories = (await CategoryService.GetAllCategoriesAsync()).ToList();
        products = (await ProductService.GetAllProductsAsync()).Where(e => e.IsActive == true).ToList();

        isLoading = false;
        StateHasChanged();
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Inward";
        isEditMode = false;
        inward = new InwardModel
        {
            InwardDate = DateTime.Now,
            InwardTime = DateTime.Now.TimeOfDay,
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.Now
        };
        inwardItems = new();
        inwardFormModal?.Show();
    }

    private async Task ShowEditModal(InwardModel edit)
    {
        modalTitle = $"Edit Inward {edit.InwardNo}";
        isEditMode = true;
        inward = edit;
        inward.InwardTime = inward.InwardDate.TimeOfDay;
        inward.UpdatedBy = Convert.ToInt32(CurrentUserId);
        inward.UpdatedOn = DateTime.Now;
        inwardItems = await InwardService.GetInwardItemsByInwardIdAsync(edit.Id);
        filteredProductsbyCategory = products;
        if (inward.CategoryId > 0 && inward.CategoryId != null)
        {
            filteredProductsbyCategory = products.Where(p => p.CategoryId == inward.CategoryId).ToList();
        }
        foreach (var item in inwardItems)
        {
            var product = filteredProductsbyCategory.FirstOrDefault(p => p.Id == item.ProductId);
            if (product != null)
            {
                item.ProductSearchText = product.SKU;
            }
        }
        inwardFormModal?.Show();
    }

    private async Task SaveInward()
    {
        isLoading = true;
        inward.InwardDate = inward.InwardDate.Date.Add(inward.InwardTime);
        inward.InwardItems = inwardItems;
        // Ensure user fields are set before saving
        if (isEditMode)
        {
            inward.UpdatedBy = Convert.ToInt32(CurrentUserId);
            inward.UpdatedOn = DateTime.Now;
            await InwardService.UpdateAsync(inward);
            await HideModal();
            await LoadData();
        }
        else
        {
            inward.CreatedBy = Convert.ToInt32(CurrentUserId);
            inward.CreatedOn = DateTime.Now;
            var inwardId = await InwardService.CreateAsync(inward);

            await HideModal();
            await LoadData();

            if (inwardId != 0)
            {
                inward.Id = inwardId;
                await OpenAddItemModal(inward);
            }
        }
    }

    private async Task DeleteInward(int id)
    {
        bool isConfirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete?");
        if (isConfirm)
        {
            var deletedBy = Convert.ToInt32(CurrentUserId);
            await InwardService.DeleteAsync(id, deletedBy);
            await LoadData();
        }
    }

    private async Task HideModal()
    {
        await inwardFormModal.Hide();
    }

    private async Task OpenAddItemModal(InwardModel inward)
    {
        selectedInward = inwards.FirstOrDefault(i => i.Id == inward.Id);
        if (selectedInward == null) return;
        itemTitle = $"Manage Inward Items | Inward No: {selectedInward?.InwardNo}";

        inwardItems = await InwardService.GetInwardItemsByInwardIdAsync(inward.Id);
        filteredProductsbyCategory = products;
        filteredBrandsByCategory = MakeCompanies;
        if (inward.CategoryId > 0 && inward.CategoryId != null)
        {
            filteredProductsbyCategory = products.Where(p => p.CategoryId == inward.CategoryId).ToList();
            var brandList = filteredProductsbyCategory.GroupBy(p => p.MakeCompanyId).Select(g => g.Key).ToList();
            filteredBrandsByCategory = MakeCompanies.Where(mc => brandList.Contains(mc.Id)).ToList();
        }
        StateHasChanged();
        await itemsModal.Show();
        isLoading = false;
    }

    private async Task HideItemModal()
    {
        await itemsModal.Hide();
    }

    private async Task SaveInwardItems()
    {
        if (selectedInward == null) return;

        selectedInward.UpdatedBy = Convert.ToInt32(CurrentUserId);
        selectedInward.UpdatedOn = DateTime.Now;
        selectedInward.InwardItems = inwardItems;

        await InwardService.UpdateAsync(selectedInward);
        await HideItemModal();
        await LoadData();
    }

    private void AddNewItemRow()
    {
        var hasBlankRow = inwardItems.Any(item => item.Id == 0 && (item.ProductId == 0 || item.ItemQuantity == 0));

        if (hasBlankRow)
        {
            return;
        }

        inwardItems.Add(new());
        StateHasChanged();
    }

    private async Task SaveSingleItem(InwardItemModel item)
    {
        if (selectedInward == null) return;

        item.InwardId = selectedInward.Id;
        item.InwardUnitName = Units.Where(u => u.Id == item.InwardUnitId).Select(u => u.Name).FirstOrDefault() ?? string.Empty;

        if (item.Id == 0)
        {
            item.CreatedBy = Convert.ToInt32(CurrentUserId);
            item.CreatedOn = DateTime.Now;
        }
        else
        {
            item.UpdatedBy = Convert.ToInt32(CurrentUserId);
            item.UpdatedOn = DateTime.Now;
        }

        bool success = item.Id == 0
            ? await InwardService.CreateInwardItemAsync(item)
            : await InwardService.UpdateInwardItemAsync(item);

        if (success)
        {
            inwardItems = await InwardService.GetInwardItemsByInwardIdAsync(selectedInward.Id);
            StateHasChanged();
        }
        else
        {
            throw new Exception("Failed to save item");
        }
    }

    private void RemoveUnsavedItem(InwardItemModel item)
    {
        inwardItems.Remove(item);
        StateHasChanged();
    }

    private async Task DeleteSingleItem(int itemId)
    {
        if (await InwardService.DeleteInwardItemAsync(itemId))
        {
            inwardItems = inwardItems.Where(i => i.Id != itemId).ToList();
            StateHasChanged();
        }
    }

    private async Task DownloadSingleItemPdf(InwardItemModel item)
    {
        try
        {
            var pdfBytes = await InwardService.GenerateItemBarcodePdfAsync(item.Id);

            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                string fileName = $"Item_{item.Id}_Barcodes.pdf";
                await BlazorDownloadFileService.DownloadFile(fileName, pdfBytes, "application/pdf");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "No barcodes found for this item.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await JS.InvokeVoidAsync("alert", "Error downloading PDF.");
        }
    }
}