@inject IJSRuntime JSRuntime
@inject IInwardService inwardService
<Modal @ref="modal" Title="@Title" Size="ModalSize.ExtraLarge" UseStaticBackdrop>
    <BodyTemplate>
        @if (SelectedInward != null)
        {
            <div class="modal-content-custom">
                <div class="modal-body-section">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                            <button type="button" class="btn-close" @onclick="@(() => successMessage = "")"></button>
                        </div>
                    }

                    @if (InwardItems.Any())
                    {
                        <div class="table-responsive" style="height: 750px; overflow-y: auto;">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="col-1 col-md-1">Brand</th>
                                        <th class="col-4 col-md-4">Product</th>
                                        <th class="col-1 col-md-1 text-center">Units</th>
                                        <th class="col-1 col-md-1 text-center">Item Qty</th>
                                        <th class="col-1 col-md-1 text-center">Box Qty</th>
                                        <th class="col-1 col-md-1 text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in InwardItems)
                                    {
                                        var brandClass = $"form-select form-select-sm {GetValidationClass(item, "brand")} w-auto";
                                        var productClass = $"form-select form-select-sm {GetValidationClass(item, "product")} w-100";
                                        var itemQuantityClass = $"form-control form-control-sm {GetValidationClass(item, "itemQuantity")} w-auto";
                                        var unitsClass = $"form-control form-control-sm {GetValidationClass(item, "units")} w-auto";
                                        var boxQuantityClass = $"form-control form-control-sm {GetValidationClass(item, "boxQuantity")} w-auto";
                                        var rowClasses = $"{(item.Id == 0 ? "table-warning" : "")} {(item.HasOutOfStockBarcodes ? "table-success opacity-30" : "")}";

                                        <tr class="@rowClasses"
                                            data-bs-toggle="@(item.HasOutOfStockBarcodes ? "tooltip" : null)"
                                            title="@(item.HasOutOfStockBarcodes ? "This item is used in outward and cannot be edited." : null)">
                                            <td>
                                                <select class="@brandClass"
                                                        value="@item.BrandId"
                                                        @onchange="(e => onChangeBrand(item, int.Parse(e.Value.ToString())))"
                                                        disabled="@item.HasOutOfStockBarcodes">
                                                    <option value="0">-- Select --</option>
                                                    @foreach (var brand in Brands)
                                                    {
                                                        <option value="@brand.Id">@brand.Name</option>
                                                    }
                                                </select>
                                                @if (showValidation && item.BrandId == 0 && IsLastUnsavedItem(item))
                                                {
                                                    <small class="text-danger">Brand required</small>
                                                }
                                            </td>
                                            <td>
                                                <SearchableDropdown TItem="ProductModel"
                                                                    Items="@item.ProductListForBrand"
                                                                    ItemTextSelector="@(p => p.SKU)"
                                                                    SelectedText="@item.ProductSearchText"
                                                                    Placeholder="Search product..."
                                                                    OnItemSelected="@(p => OnProductDropdownSelected(item, p))"
                                                                    ShowValidationMessage="@(showValidation && item.ProductId == 0 && IsLastUnsavedItem(item))"
                                                                    IsRequired="true" IsDisabled="@item.HasOutOfStockBarcodes" />

                                                @if (showValidation && item.ProductId == 0 && IsLastUnsavedItem(item))
                                                {
                                                    <small class="text-danger">Product is required</small>
                                                }
                                            </td>
                                            <td>
                                                <InputSelect class="@unitsClass"
                                                             @bind-Value="item.InwardUnitId"
                                                             disabled="@item.HasOutOfStockBarcodes">
                                                    <option value="0">-- Select --</option>
                                                    @foreach (var unit in Units)
                                                    {
                                                        <option value="@unit.Id">@unit.Name</option>
                                                    }
                                                </InputSelect>
                                                @if (showValidation && item.InwardUnitId == 0 && IsLastUnsavedItem(item))
                                                {
                                                    <small class="text-danger">Unit required</small>
                                                }
                                            </td>
                                            <td>
                                                <InputNumber class="@itemQuantityClass" min="1"
                                                             style="max-width: 80px;"
                                                             @bind-Value="item.ItemQuantity"
                                                             @onchange="@(() => ClearMessages())"
                                                             disabled="@item.HasOutOfStockBarcodes" />

                                                @if (showValidation && item.ItemQuantity == 0 && IsLastUnsavedItem(item))
                                                {
                                                    <small class="text-danger">Qty required.</small>
                                                }
                                                @if (showValidation && item.ItemQuantity < 0 && IsLastUnsavedItem(item))
                                                {
                                                    <small class="text-danger">Invalid Qty!</small>
                                                }
                                            </td>
                                            <td>
                                                @if (IsRequired(item))
                                                {
                                                    <InputNumber class="@boxQuantityClass"
                                                                 style="max-width: 80px;"
                                                                 @bind-Value="item.BoxQuantity"
                                                                 @onchange="@(() => ClearMessages())"
                                                                 disabled="@isRequired" />

                                                    @if (showValidation && item.BoxQuantity == 0 && IsRequired(item) && IsLastUnsavedItem(item))
                                                    {
                                                        <small class="text-danger">Qty required.</small>
                                                    }
                                                    @if (showValidation && item.BoxQuantity < 0 && IsRequired(item) && IsLastUnsavedItem(item))
                                                    {
                                                        <small class="text-danger">Invalid Qty!</small>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1 justify-content-start">
                                                    <button type="button"
                                                            class="btn btn-primary btn-sm"
                                                            @onclick="@(() => HandleSaveItem(item))"
                                                            disabled="@item.HasOutOfStockBarcodes">
                                                        Save
                                                    </button>
                                                    @if (item.Id > 0)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-danger btn-sm"
                                                                @onclick="@(() => HandleDeleteItem(item.Id))"
                                                                disabled="@item.HasOutOfStockBarcodes">
                                                            Delete
                                                        </button>

                                                        <button type="button"
                                                                class="btn btn-dark btn-md"
                                                                @onclick="@(() => OnDownloadPdf.InvokeAsync(item))">
                                                            <Icon Name="IconName.UpcScan" />
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-secondary btn-md"
                                                                @onclick="@(() => RemoveUnsavedItem(item))">
                                                            <Icon Name="IconName.XCircle" />
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="text-end mt-2">
                                <button type="button" disabled="@hideAddNewButton" class="btn btn-success btn-sm" @onclick="HandleAddItem">
                                    <i class="bi bi-plus-circle me-1"></i>Add New Item
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No items added yet. Click "Add Item" to get started.
                        </div>
                        <div class="text-center mt-2">
                            <button type="button"
                                    disabled="@hideAddNewButton"
                                    class="btn btn-success btn-sm"
                                    @onclick="HandleAddItem">
                                <i class="bi bi-plus-circle me-1"></i>Add New Item
                            </button>
                        </div>
                    }
                </div>

                <div class="modal-footer-section">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="HandleClose"
                            disabled="@isSaving">
                        Close
                    </button>
                </div>
            </div>
        }
    </BodyTemplate>
</Modal>

@code {
    private Modal modal = new();
    private string errorMessage = "";
    private string successMessage = "";
    private bool showValidation = false;
    private bool isSaving = false;
    private bool isRequired = false;
    private bool hideAddNewButton = false;
    private InwardItemModel? currentSavingItem = null;

    [Parameter] public string Title { get; set; } = "Manage Inward Items";
    [Parameter] public InwardModel? SelectedInward { get; set; }
    [Parameter] public List<InwardItemModel> InwardItems { get; set; } = new();
    [Parameter] public List<ProductModel> FilteredProducts { get; set; } = new();
    [Parameter] public List<CompanyModel> Brands { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback<InwardItemModel> OnSaveItem { get; set; }
    [Parameter] public EventCallback<int> OnDeleteItem { get; set; }
    [Parameter] public EventCallback OnAddItem { get; set; }
    [Parameter] public EventCallback<InwardItemModel> OnRemoveUnsaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<InwardItemModel> OnDownloadPdf { get; set; }

    public List<UnitModel> Units => CommonUtils.UnitList;
    public int brandId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initTooltips");
    }

    public async Task Show()
    {
        ResetUiState();
        showValidation = false;
        if (InwardItems == null || InwardItems.Count == 0)
        {
            await OnAddItem.InvokeAsync();
        }
        foreach (var item in InwardItems)
        {
            if (item.BrandId > 0)
            {
                item.ProductListForBrand = FilteredProducts
                    .Where(p => p.MakeCompanyId == item.BrandId)
                    .ToList();
            }
            else
            {
                // item.ProductListForBrand = new();
                item.ProductSearchText = string.Empty;
            }
        }

        await modal.ShowAsync();
    }

    public async Task Hide()
    {
        ResetUiState();
        await modal.HideAsync();
    }

    private async Task HandleSaveItem(InwardItemModel item)
    {
        ClearMessages();
        showValidation = true;

        //Validate Brand
        if (item.BrandId == 0)
        {
            errorMessage = "Please select a brand before saving.";
            StateHasChanged();
            return;
        }

        // Validate Product
        if (item.ProductId == 0)
        {
            errorMessage = "Please select a product before saving.";
            StateHasChanged();
            return;
        }

        // Validate Quantity
        if (item.ItemQuantity <= 0)
        {
            errorMessage = "Item Quantity must be greater than 0.";
            StateHasChanged();
            return;
        }

        // Validate Unit
        if (item.InwardUnitId <= 0)
        {
            errorMessage = "Unit is required.";
            StateHasChanged();
            return;
        }

        // Validate BoxQuantity
        if (IsRequired(item))
        {
            if (item.BoxQuantity <= 0)
            {
                errorMessage = "Box Quantity must be greater than 0.";
                StateHasChanged();
                return;
            }
        }

        if (item.HasOutOfStockBarcodes)
        {
            errorMessage = "This item is locked and cannot be edited.";
            StateHasChanged();
            return;
        }

        isSaving = true;
        currentSavingItem = item;
        StateHasChanged();

        try
        {
            await OnSaveItem.InvokeAsync(item);
            successMessage = item.Id == 0 ? "Item added successfully!" : "Item updated successfully!";
            showValidation = false;
            await HandleAddItem();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving item: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            currentSavingItem = null;
            StateHasChanged();
        }

        // Auto-hide success message after 3 seconds
        if (!string.IsNullOrEmpty(successMessage))
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                successMessage = "";
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task HandleDeleteItem(int itemId)
    {

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove item?");

        if (!confirmed) return;
        ClearMessages();
        await OnDeleteItem.InvokeAsync(itemId);
        successMessage = "Item deleted successfully!";
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            successMessage = "";
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task HandleAddItem()
    {
        ClearMessages();
        // Check if there's an unsaved item with no data
        var hasBlankUnsavedRow = InwardItems.Any(item =>
            item.Id == 0 && (item.ProductId == 0 || item.ItemQuantity == 0));

        if (hasBlankUnsavedRow)
        {
            errorMessage = "Please save or cancel the existing unsaved item before adding a new one.";
            showValidation = true;
            StateHasChanged();
            return;
        }

        showValidation = false;
        hideAddNewButton = true;
        await OnAddItem.InvokeAsync();
        StateHasChanged();
    }

    private void RemoveUnsavedItem(InwardItemModel item)
    {
        hideAddNewButton = false;
        ClearMessages();
        OnRemoveUnsaved.InvokeAsync(item);
        StateHasChanged();
    }

    private async Task HandleClose()
    {
        // Check for unsaved items before closing
        var hasUnsavedItems = InwardItems.Any(item => item.Id == 0);

        if (hasUnsavedItems)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
                "You have unsaved items. Are you sure you want to close?");

            if (!confirmed)
            {
                return;
            }
        }

        await OnClose.InvokeAsync();
    }

    private void ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
    }

    private string GetValidationClass(InwardItemModel item, string field)
    {
        if (!showValidation || !IsLastUnsavedItem(item))
            return "";

        return field switch
        {
            "brand" => item.BrandId == 0 ? "is-invalid" : "is-valid",
            "product" => item.ProductId == 0 ? "is-invalid" : "is-valid",
            "itemQuantity" => item.ItemQuantity <= 0 ? "is-invalid" : "is-valid",
            "units" => item.InwardUnitId == 0 ? "is-invalid" : "is-valid",
            "boxQuantity" => item.InwardUnitId == 0 || !IsRequired(item) || item.BoxQuantity > 0 ? "is-valid" : "is-invalid",
            _ => ""
        };
    }

    private bool IsLastUnsavedItem(InwardItemModel item)
    {
        return item.Id == 0;
    }

    private bool IsRequired(InwardItemModel item)
    {
        var inwardUnitName = Units.FirstOrDefault(u => u.Id == item.InwardUnitId)?.Name ?? string.Empty;
        var isrequired= inwardUnitName == "BOX";
        isRequired = isrequired;
        if(isrequired)
        {
            item.BoxQuantity = 1;
        }
        else
        {
            item.BoxQuantity = 0;
        }
        return isrequired;
    }

    private void OnProductDropdownSelected(InwardItemModel inwardItem, ProductModel product)
    {
        ClearMessages();

        if (product is null)
        {
            inwardItem.ProductSearchText = "";
            inwardItem.ProductId = 0;
            return;
        }

        inwardItem.ProductId = product.Id;
        inwardItem.ProductSearchText = product.SKU;
    }
    private void onChangeBrand(InwardItemModel item, int selectedId)
    {
        ClearMessages();

        item.BrandId = selectedId;

        item.ProductId = 0;
        item.ProductSearchText = "";

        // Filter only for this row
        item.ProductListForBrand = FilteredProducts
            .Where(p => p.MakeCompanyId == selectedId)
            .ToList();
        OnProductDropdownSelected(item, null);
        StateHasChanged();
    }
    private void ResetUiState()
    {
        showValidation = false;
        hideAddNewButton = false;
        errorMessage = "";
        successMessage = "";
    }
}
<script>
    window.initTooltips = () => {
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => {
            new bootstrap.Tooltip(el);
        });
    };
</script>