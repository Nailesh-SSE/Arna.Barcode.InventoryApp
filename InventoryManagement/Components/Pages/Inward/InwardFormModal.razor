<Modal @ref="modal" Title="@Title" Size="ModalSize.Large" UseStaticBackdrop>
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
                <div class="modal-content-custom">
                    <div class="modal-body-section">
            <fieldset disabled="@DisableFields">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Inward Date <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="Inward.InwardDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => Inward.InwardDate)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Inward Time</label>
                                <input type="time" class="form-control"
                                       value="@Inward.InwardTime.ToString(@"hh\:mm")"
                                       @onchange="OnTimeChanged" required />
                            </div>

                            <div class="col-md-6">
                                <fieldset disabled="@IsEditMode">
                                <label class="form-label">Ship Company <span class="text-danger">*</span></label>
                                <DropDown TItem="CompanyModel"
                                          Items="@ShipCompanies"
                                          SelectedId="@Inward.ShipMentCompanyId"
                                          ValueSelector="x => x.Id"
                                          TextSelector="x => x.Name"
                                          Placeholder="-- Select Company --"
                                          OnValueChanged="OnShipMentCompanySelected" />
                                <ValidationMessage For="@(() => Inward.ShipMentCompanyId)" />
                                </fieldset>
                            </div>

                            <div class="col-md-6">
                                <fieldset disabled="@IsEditMode">
                                <label class="form-label">Category</label>
                                <DropDown TItem="CategoryModel"
                                          Items="@Categories"
                                          SelectedId="@Inward.CategoryId"
                                          ValueSelector="x => x.Id"
                                          TextSelector="x => x.Name"
                                          Placeholder="-- All Categories --"
                                          OnValueChanged="OnCategorySelected" />
                                </fieldset>
                            </div>
                        </div>

                        <div class="col-md-12 mt-2">
                            <label class="form-label">Remarks</label>
                            <InputText class="form-control" @bind-Value="Inward.Remarks" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 ms-1">
                                @if (Inward.Id > 0)
                                {
                                    <div class="form-check mt-3">
                                        <InputCheckbox id="isActiveCheck" class="form-check-input" @bind-Value="Inward.IsActive" />
                                        <label class="form-check-label" for="isActiveCheck">Is Active</label>
                                    </div>
                                }

                            </div>
                        </div>
                        </fieldset>
                    </div>

                    <div class="modal-footer-section mt-3 text-end">
                        <button type="button" class="btn btn-secondary me-2" @onclick="HandleCancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@DisableFields"> @(Inward.Id > 0 ? "Update" : "Next")</button>
                    </div>
                </div>
        </EditForm>
    </BodyTemplate>
</Modal>

@code {
    private Modal modal = new();
    private EditContext? editContext;
    private ValidationMessageStore? validationMessage;
    private string? selectedCategoryId;

    [Parameter] public string Title { get; set; } = "Inward Form";
    [Parameter] public InwardModel Inward { get; set; } = new();
    [Parameter] public List<CompanyModel> ShipCompanies { get; set; } = new();
    [Parameter] public List<CategoryModel> Categories { get; set; } = new();
    [Parameter] public List<ProductModel> Products { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool DisableFields { get; set; }

    protected override void OnParametersSet()
    {
        InitializeEditContext();
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(Inward);
        validationMessage = new ValidationMessageStore(editContext);
        ShipCompanies = ShipCompanies.Where(c => c.IsActive || (IsEditMode && c.Id == Inward.ShipMentCompanyId)).ToList();
        Categories = Categories.Where(c => c.IsActive || (IsEditMode && c.Id == Inward.CategoryId)).ToList();
        Products = Products.Where(p => p.IsActive).ToList();
    }

    public async Task Show()
    {
        selectedCategoryId = null;
        InitializeEditContext();
        await modal.ShowAsync();
    }

    public async Task Hide()
    {
        await modal.HideAsync();
    }

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out TimeSpan time))
            Inward.InwardTime = time;
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategoryId = e.Value?.ToString();
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private void OnShipMentCompanySelected((int? Id, string Name) selected)
    {
        Inward.ShipMentCompanyId = selected.Id ?? 0;
    }

    private void OnCategorySelected((int? Id, string Name) selected)
    {
        Inward.CategoryId = selected.Id ?? 0;
    }
}