@page "/change-password"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using InventoryManagement.Components.Auth
@inject IUserService UserService
@inject ILogger<ChangePassword> Logger
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<PageTitle>Arna Technosoft - Change Password</PageTitle>

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <div class="logo-container">
                <img src="images/ArnaLogo.png" alt="Arna Technosoft" class="logo" />
            </div>
        </div>
        <div class="login-body">
            <p class="login-message">Change Password For <strong>@UserName</strong></p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            <EditForm Model="@changePasswordModel" OnValidSubmit="HandleChangePassword">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.ShieldLock" />
                        </span>
                        <InputText type="text"
                                   class="form-input"
                                   placeholder="Old Password"
                                   @bind-Value="@changePasswordModel.OldPassword" />
                    </div>
                    <ValidationMessage For="@(() => changePasswordModel.OldPassword)" class="text-danger small mt-1" />
                </div>

                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Lock" />
                        </span>
                        <InputText type="@newPasswordInputType"
                                   class="form-input"
                                   placeholder="New Password"
                                   @bind-Value="@changePasswordModel.NewPassword" />
                        <button type="button" class="password-toggle" @onclick="ToggleNewPasswordVisibility">
                            <i class="@newPasswordToggleIcon"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-danger small mt-1" />
                </div>
                <div class="form-group">
                    <div class="input-container">
                        <span class="input-icon">
                            <Icon Name="IconName.Lock" />
                        </span>
                        <InputText type="@confirmPasswordInputType"
                                   class="form-input"
                                   placeholder="Confirm Password"
                                   @bind-Value="@changePasswordModel.ConfirmPassword" />
                        <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                            <i class="@confirmPasswordToggleIcon"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changePasswordModel.ConfirmPassword)" class="text-danger small mt-1" />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary login-btn" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        CHANGE PASSWORD
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

</div>



@code {
    private ChangePasswordModel changePasswordModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showConfirmPassword;
    private bool showNewPassword;
    private string? returnUrl;
    private string? UserName;


    private string newPasswordInputType => showNewPassword ? "text" : "password";
    private string confirmPasswordInputType => showConfirmPassword ? "text" : "password";


    private string newPasswordToggleIcon => showNewPassword ? "bi bi-eye-slash" : "bi bi-eye";
    private string confirmPasswordToggleIcon => showConfirmPassword ? "bi bi-eye-slash" : "bi bi-eye";



    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        changePasswordModel = new ChangePasswordModel();
        var currentUserId = Convert.ToInt32(CurrentUserId);
        var userPasswordValid = await UserService.GetUserByUserIdAsync(currentUserId);
        UserName = userPasswordValid?.UserName;
    }

    private async Task HandleChangePassword()
    {
        try
        {
            var currentUserId = Convert.ToInt32(CurrentUserId);
            isLoading = true;
            errorMessage = null;
            await Task.Yield();
            StateHasChanged();

            var userPasswordValid = await UserService.GetUserByUserIdAsync(currentUserId);
            if (userPasswordValid == null || userPasswordValid.Password != changePasswordModel.OldPassword)
            {
                errorMessage = "Old Password is incorrect.";
                return;
            }

            if (changePasswordModel.NewPassword != changePasswordModel.ConfirmPassword)
            {
                errorMessage = "New Password and Confirm Password do not match.";
                return;
            }

            var isChangePassword = await UserService.ChangePasswordAsync(currentUserId, changePasswordModel.NewPassword);

            if (isChangePassword)
            {
                Logger.LogInformation("Password Change successfully");
                await Task.Delay(500);
                NavigationManager.NavigateTo("/", false);
            }

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "change password failed");
            errorMessage = "change password failed. Please try again later.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleNewPasswordVisibility()
    {
        showNewPassword = !showNewPassword;
    }
    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "Old Password is required")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "New Password is required")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Confirm Password is required")]
        public string ConfirmPassword { get; set; } = "";
    }

}