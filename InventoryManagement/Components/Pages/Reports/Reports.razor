@page "/reports"
@using InventoryManagement.Services.Interfaces
@using InventoryManagement.Services.Models.ReportModels
@inject IReportService ReportService
@inject NavigationManager NavigationManager


<PageTitle>Reports Dashboard</PageTitle>


<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h3><Icon Name="IconName.FileEarmarkBarGraph" /> Reports Dashboard</h3>
            <p class="text-muted">Generate and analyze comprehensive inventory reports</p>
        </div>
    </div>



    <!-- Report Cards -->
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <Icon Name="IconName.BoxSeam" class="text-primary" style="font-size: 3rem;" />
                    </div>
                    <h5 class="card-title">Instock Report</h5>
                    <p class="card-text text-muted">
                        Track current inventory levels, low stock alerts, and warehouse status
                    </p>
                    <ul class="list-unstyled text-start small mb-3">
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Current stock levels</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Low stock warnings</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Category-wise inventory</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Batch tracking</li>
                    </ul>
                    <Button Color="ButtonColor.Primary" @onclick="() => NavigateToReport(reportTypes.Instock.ToString())">
                        <Icon Name="IconName.ArrowRight" /> Generate Report
                    </Button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-success">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <Icon Name="IconName.Cart" class="text-success" style="font-size: 3rem;" />
                    </div>
                    <h5 class="card-title">Outstock Report</h5>
                    <p class="card-text text-muted">
                        Analyze sales patterns, customer behavior, and revenue trends
                    </p>
                    <ul class="list-unstyled text-start small mb-3">
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Sales analytics</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Customer insights</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Product performance</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Revenue tracking</li>
                    </ul>
                    <Button Color="ButtonColor.Success" @onclick="() => NavigateToReport(reportTypes.Outstock.ToString())">
                        <Icon Name="IconName.ArrowRight" /> Generate Report
                    </Button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-warning">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <Icon Name="IconName.ArrowReturnLeft" class="text-warning" style="font-size: 3rem;" />
                    </div>
                    <h5 class="card-title">Return Sale Report</h5>
                    <p class="card-text text-muted">
                        Monitor product returns, quality issues, and return patterns
                    </p>
                    <ul class="list-unstyled text-start small mb-3">
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Return analysis</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Reason tracking</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Quality insights</li>
                        <li><Icon Name="IconName.CheckCircle" class="text-success" /> Customer returns</li>
                    </ul>
                    <Button Color="ButtonColor.Warning" @onclick="() => NavigateToReport(reportTypes.ReturnSale.ToString())">
                        <Icon Name="IconName.ArrowRight" /> Generate Report
                    </Button>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><Icon Name="IconName.Speedometer2" /> Quick Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row" id="quickStats">
                        <div class="col-md-3 text-center">
                            <div class="mb-2">
                                <Icon Name="IconName.BoxSeam" class="text-primary" style="font-size: 2rem;" />
                            </div>
                            <h4 class="text-primary" id="totalProducts">-</h4>
                            <p class="text-muted mb-0">Total Products</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="mb-2">
                                <Icon Name="IconName.ExclamationTriangle" class="text-warning" style="font-size: 2rem;" />
                            </div>
                            <h4 class="text-warning" id="lowStockItems">-</h4>
                            <p class="text-muted mb-0">Low Stock Items</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="mb-2">
                                <Icon Name="IconName.Cart" class="text-success" style="font-size: 2rem;" />
                            </div>
                            <h4 class="text-success" id="todaySales">-</h4>
                            <p class="text-muted mb-0">Today's Sales</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="mb-2">
                                <Icon Name="IconName.ArrowReturnLeft" class="text-info" style="font-size: 2rem;" />
                            </div>
                            <h4 class="text-info" id="pendingReturns">-</h4>
                            <p class="text-muted mb-0">Pending Returns</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Reports -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><Icon Name="IconName.ClockHistory" /> Recent Reports</h5>
                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small">
                        <Icon Name="IconName.ArrowClockwise" /> Refresh
                    </Button>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-4">
                        <Icon Name="IconName.FileEarmarkText" style="font-size: 3rem;" />
                        <p class="mt-2">No recent reports generated</p>
                        <small class="text-muted">Generate your first report using the options above</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



@code {

    public enum reportTypes
    {
        Instock,
        Outstock,
        ReturnSale
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadQuickStats();
    }


    private void NavigateToReport(string reportType)
    {
        switch (reportType.ToLower())
        {
            case "instock":
                NavigationManager.NavigateTo("/reports/instock");
                break;
            case "outstock":
                NavigationManager.NavigateTo("/reports/outstock");
                break;
            case "returnsale":
                NavigationManager.NavigateTo("/reports/returnsale");
                break;
        }
    }

    private async Task LoadQuickStats()
    {
        try
        {
            // Generate quick stats using the report service
            var tasks = new[]
            {
            GetTotalProductsCount(),
            GetLowStockCount(),
            GetTodaySalesCount(),
            GetPendingReturnsCount()
        };

            var results = await Task.WhenAll(tasks);

            // Update UI (in a real app, you'd use StateHasChanged properly)
            // For demo purposes, we'll use JavaScript interop or update the UI
        }
        catch (Exception ex)
        {
            // Handle error
        }
    }

    private async Task<int> GetTotalProductsCount()
    {
        try
        {
            var filter = new InstockFilter { PageSize = 1 };
            var result = await ReportService.GenerateInstockReportAsync(filter);
            return result.UniqueProductsCount;
        }
        catch
        {
            return 0;
        }
    }

    private async Task<int> GetLowStockCount()
    {
        try
        {
            var filter = new InstockFilter { IncludeLowStock = true, PageSize = 1 };
            var result = await ReportService.GenerateInstockReportAsync(filter);
            return result.LowStockItemsCount;
        }
        catch
        {
            return 0;
        }
    }

    private async Task<int> GetTodaySalesCount()
    {
        try
        {
            var filter = new OutstockFilter
            {
                StartDate = DateTime.Today,
                EndDate = DateTime.Today,
                PageSize = 1
            };
            var result = await ReportService.GenerateOutstockReportAsync(filter);
            return result.TotalRecords;
        }
        catch
        {
            return 0;
        }
    }

    private async Task<int> GetPendingReturnsCount()
    {
        try
        {
            var filter = new ReturnSaleFilter { PendingOnly = true, PageSize = 1 };
            var result = await ReportService.GenerateReturnSaleReportAsync(filter);
            return result.TotalRecords;
        }
        catch
        {
            return 0;
        }
    }

}