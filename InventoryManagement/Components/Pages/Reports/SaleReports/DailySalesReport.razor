@using InventoryManagement.Services.Models

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <Icon Name="IconName.CalendarDay" /> Daily Sales Report
        </h5>
    </div>
    <div class="card-body">
        @if (DailySalesData.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Orders</th>
                            <th>Items Sold</th>
                            <th>Revenue</th>
                            <th>Avg Order Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in DailySalesData.OrderByDescending(d => d.Date))
                        {
                            var hasSales = day.OrderCount > 0;
                            <tr class="@(hasSales ? "" : "table-secondary")">
                                <td><strong>@day.Date.ToString("dd-MM-yyyy")</strong></td>
                                <td>@day.Date.DayOfWeek.ToString().Substring(0, 3)</td>
                                <td class="text-center">
                                    @if (hasSales)
                                    {
                                        <span class="badge bg-success">@day.OrderCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">@day.ItemsSold</td>
                                <td>@day.Revenue.ToString("C")</td>
                                <td>@day.AverageOrderValue.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <th colspan="2">Total</th>
                            <th>@DailySalesData.Sum(d => d.OrderCount)</th>
                            <th>@DailySalesData.Sum(d => d.ItemsSold)</th>
                            <th>@DailySalesData.Sum(d => d.Revenue).ToString("C")</th>
                            <th>@DailySalesData.Where(d => d.AverageOrderValue > 0).DefaultIfEmpty().Average(d => d.AverageOrderValue).ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            
            <!-- Summary Stats -->
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h6 class="card-title">Days with Sales</h6>
                            <h4 class="text-primary">@DailySalesData.Count(d => d.OrderCount > 0) / @DailySalesData.Count</h4>
                            <small class="text-muted">@(DailySalesData.Count > 0 ? (DailySalesData.Count(d => d.OrderCount > 0) * 100.0 / DailySalesData.Count):0):F1)% of days</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h6 class="card-title">Best Day</h6>
                            <h4 class="text-success">@DailySalesData.Where(d => d.OrderCount > 0).Max(d => d.OrderCount)</h4>
                            <small class="text-muted">Maximum orders</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h6 class="card-title">Daily Average</h6>
                            <h4 class="text-info">@(DailySalesData.Count > 0 ? DailySalesData.Average(d => d.OrderCount):0):F1)</h4>
                            <small class="text-muted">Orders per day</small>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <Icon Name="IconName.CalendarX" Size="IconSize.x3" />
                <p class="mt-2">No daily sales data available</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<DailySalesModel> DailySalesData { get; set; } = new();
}