@page "/reports/barcodetrack"
@using InventoryManagement.Components.Auth
@using InventoryManagement.Services.Models.ReportModels
@using InventoryManagement.Services.Reports.Interfaces
@inherits AuthComponentBase
@implements IAsyncDisposable
@inject IInwardReportService InwardReportService
@inject IBarcodeTrackingReportService BarcodeTrackingReportService
@inject ICompanyService CompanyService
@inject ICategoryService CategoryService
@inject IJSRuntime JS

<PageTitle>Track Barcode</PageTitle>
@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4 align-items-center">
            <div class="col">
                <h3>Track Barcode</h3>
                <p class="text-muted">Comprehensive reporting and insights for Barcode Tracking management</p>
            </div>
            <div class="col-auto">
                <div class="btn-group">
                    <button class="btn btn-outline-primary" @onclick="RefreshReport">
                        <Icon Name="IconName.ArrowClockwise" /> Refresh
                    </button>
                    @*     <button class="btn btn-outline-success" @onclick="ExportCurrentReport">
                    <Icon Name="IconName.Download" /> Export
                </button> *@
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                @alertMessage
                <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
            </div>
        }
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <Icon Name="IconName.Funnel" /> Filter Options
                        </h6>
                    </div>

                    <div class="card-body">
                        <EditForm Model="@filter" OnValidSubmit="GenerateReport">
                            <div class="row g-3">
                                <div class="position-relative">

                                    @if (isScanning)
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                                                title="Close Camera"
                                                style="z-index: 10;"
                                                @onclick="CloseCamera">
                                            <Icon Name="IconName.XCircle" />
                                        </button>
                                    }

                                    <div id="reader" class="border rounded" style="width: 100%;"></div>

                                </div>
                                <div class="col-12">
                                    <label class="form-label">Barcode No</label>
                                    <InputText class="form-control"
                                               @bind-Value="filter.barcode"
                                               @oninput="HandleInput" />
                                    <button type="button"
                                            class="btn btn-secondary d-flex align-items-center gap-1"
                                            @onclick="StartCameraScan"
                                            disabled="@isScanning">
                                        <Icon Name="IconName.Camera" /> Scan
                                    </button>
                                    @if (barcodeError != null)
                                    {
                                        <div class="text-danger small mt-1">
                                            @barcodeError
                                        </div>
                                    }
                                </div>
                                <div class="col-12 d-grid gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <Icon Name="IconName.Search" /> Generate Report
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">
                                        <Icon Name="IconName.XCircle" /> Clear
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
            <!-- Report Content -->
            <div class="col-md-9">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2"><strong>Generating report...</strong></div>
                        <div class="progress mt-2" style="height: 4px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @loadingProgress%;"></div>
                        </div>
                    </div>
                }
                else if (reportResult != null)
                {
                    <!-- Data Table -->
                    @if (reportResult.Items.Any())
                    {
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Detailed Results</h5>
                                @* <small class="text-muted">
                                    Page @reportResult.PageNumber of @reportResult.PageCount
                                    (@reportResult.TotalRecords total records)
                                </small> *@
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Transaction</th>
                                                <th>TransactionNo</th>
                                                <th>BarcodeNo</th>
                                                <th>TransactionTime</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in reportResult.Items)
                                            {
                                                <tr>
                                                    <td>@item.TransactionType</td>
                                                    <td>@item.TransactionNo</td>
                                                    <td>@item.BarCodeNo</td>
                                                    <td>@item.TransactionTime</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else if (!reportResult.Items.Any())
                    {
                        <div class="text-center py-5">
                            <Icon Name="IconName.Inbox" class="text-muted" style="font-size: 3rem;" />
                            <h5 class="mt-3 text-muted">No records found</h5>
                            <p class="text-muted">Try adjusting your filters to see results.</p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <Icon Name="IconName.FileText" class="text-muted" style="font-size: 3rem;" />
                        <h5 class="mt-3 text-muted">No Report Generated</h5>
                        <p class="text-muted">Configure your filters and click "Generate Report" to create a report.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}
@code {
    private BarcodeFilter filter = new();
    private BarCodeReportResult? reportResult;
    private List<CompanyModel> shipCompanies = new();
    private List<CategoryModel> categories = new();
    private bool isLoading;
    private int loadingProgress;
    private string? alertMessage;
    private string? barcodeError;
    private System.Threading.Timer? errorTimer;
    private bool isScanning = false;
    private string alertType = "info";
    private string Route = "/reports/barcodetrack";
    private DotNetObjectReference<BarcodeTrackReport>? dotNetHelper;
    private InputText barcodeInput = default!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadReferenceData();
        LoadDefaultFilters();
    }

    private async Task LoadReferenceData()
    {
        try
        {
            var companiesTask = await CompanyService.GetCompaniesByTypeAsync(CompanyType.ShipTo);

            shipCompanies = companiesTask.Where(c => c.IsActive).ToList();
            var categoriesTask = await CategoryService.GetAllCategoriesAsync();
            categories = categoriesTask.ToList();
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to load reference data: {ex.Message}");
        }
    }

    private async Task GenerateReport()
    {
        if (!ValidateBarcode())
        {
            ShowAlert("warning", barcodeError!);
            StateHasChanged();
            return;
        }
        var validationBarcode = await BarcodeTrackingReportService.ValidateBarcode(filter.barcode);

        if (!validationBarcode.IsValid)
        {
            barcodeError = validationBarcode.ErrorMessage;
            reportResult = new BarCodeReportResult();
            return;
        }
        isLoading = true;
        loadingProgress = 0;
        StateHasChanged();

        try
        {
            loadingProgress = 25;
            reportResult = await BarcodeTrackingReportService.GenerateBarcodeTarckReportAsync(filter);
            loadingProgress = 100;
            ShowAlert("success", "Report generated successfully.");

        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to generate report: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void LoadDefaultFilters()
    {
        filter = new()
        {
            StartDate = DateTime.Today.AddDays(-30),
            EndDate = DateTime.Today,
            PageNumber = 1,
            PageSize = 50,
            SortBy = "InwardDate",
            SortDescending = true,
            // IncludeInactive = false
        };
    }

    private async Task RefreshReport()
    {
        if (reportResult != null)
            await GenerateReport();
        else
            ShowAlert("warning", "No report to refresh.");
    }

    private void ClearFilters()
    {
        filter = new();
        reportResult = null;
        barcodeError = null;
        ShowAlert("info", "Filters cleared.");
        try
        {
            JS.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }
        isScanning = false;
        StateHasChanged();
    }
    private void ShowAlert(string type, string message)
    {
        alertType = type;
        alertMessage = message;
        _ = AutoHideAlertAsync();
    }
    private async Task AutoHideAlertAsync()
    {
        await Task.Delay(3000);
        alertMessage = null;
        await InvokeAsync(StateHasChanged);
    }
    private void HandleInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        value = new string(value.Where(char.IsDigit).ToArray());

        if (value.Length > 16)
            value = value[..16];

        filter.barcode = value;

        barcodeError = null;
    }
    private bool ValidateBarcode()
    {
        barcodeError = null;

        if (string.IsNullOrWhiteSpace(filter.barcode))
        {
            barcodeError = "Barcode is empty";
            reportResult = new BarCodeReportResult();
            return false;
        }

        if (filter.barcode.Length != 16)
        {
            barcodeError = "Barcode must be exactly 16 digits";
            reportResult = new BarCodeReportResult();
            return false;
        }

        return true;
    }
    private void ShowError(string message)
    {
        barcodeError = message;
        //showErrorMessage = true;
        StateHasChanged();

        errorTimer?.Dispose();
        errorTimer = new System.Threading.Timer(_ =>
        {
            //     showErrorMessage = false;
            barcodeError = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }
    private async Task StartCameraScan()
    {
        if (isScanning) return;

        try
        {
            isScanning = true;
            await Task.Yield();
            dotNetHelper?.Dispose();
            dotNetHelper = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("manageScanner.start", dotNetHelper);
        }
        catch (Exception)
        {
            isScanning = false;
            ShowError("Could not start camera");
        }
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string scannedBarcode)
    {
        barcodeError = string.Empty;
        if (dotNetHelper == null) return;

        if (string.IsNullOrWhiteSpace(scannedBarcode))
            return;

        filter.barcode = scannedBarcode;
        if (!ValidateBarcode())
        {
            ShowAlert("warning", barcodeError!);
            reportResult = null;
            isScanning = false;
            StateHasChanged();
        }
        else
        {
            isLoading = false;
            StateHasChanged();
            reportResult = await BarcodeTrackingReportService.GenerateBarcodeTarckReportAsync(filter); ;
            StateHasChanged();
        }
    }

    public async Task CloseCamera()
    {
        try
        {
            await JS.InvokeVoidAsync("manageScanner.forceStop");
        }
        catch { }

        if (dotNetHelper != null)
        {
            dotNetHelper.Dispose();
            dotNetHelper = null;
        }

        isScanning = false;

        if (barcodeInput != null &&
         barcodeInput.Element.HasValue)
        {
            await barcodeInput.Element.Value.FocusAsync();
        }
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("manageScanner.stop");
        }
        catch{}

        dotNetHelper?.Dispose();
        dotNetHelper = null;

        isScanning = false;
    }
}
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<script>
    let html5QrcodeScanner;

    window.manageScanner = {
        start: (dotNetHelper) => {
            if (html5QrcodeScanner) { return; }

            html5QrcodeScanner = new Html5Qrcode("reader");

            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrcodeScanner.start({ facingMode: "environment" }, config,
                (decodedText, decodedResult) => {
                    // SUCCESS:
                    // 1. Stop the camera immediately so it doesn't scan twice
                    // 2. Clear the variable and DOM
                    // 3. Send result to C#
                    window.manageScanner.stop().then(() => {
                        dotNetHelper.invokeMethodAsync('OnBarcodeScanned', decodedText)
                            .catch(err => console.log("Blazor component disposed", err));
                    });
                },
                (errorMessage) => {
                    // ignore errors
                })
            .catch(err => {
                console.error("Error starting scanner", err);
                alert("Could not start camera. Permissions?");
            });
        },

        stop: () => {
            return new Promise((resolve, reject) => {
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        html5QrcodeScanner.clear();
                        html5QrcodeScanner = null;
                        document.getElementById("reader").innerHTML = "";
                        resolve();
                    }).catch(err => {
                        console.log("Error stopping scanner", err);
                        html5QrcodeScanner = null;
                        resolve();
                    });
                } else {
                    resolve();
                }
            });
        },
        forceStop: () => {
            if (!html5QrcodeScanner) return;

            try
            {
                html5QrcodeScanner.stop();
                html5QrcodeScanner.clear();
            }
            catch (e)
            {
                console.warn("Scanner stop error", e);
            }

            html5QrcodeScanner = null;

            const reader = document.getElementById("reader");
            if (reader) reader.innerHTML = "";
        }
    };
</script>
