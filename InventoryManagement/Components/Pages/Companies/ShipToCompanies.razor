@page "/companies/ship-to"
@using InventoryManagement.Components.Auth
@inherits AuthComponentBase
@inject ICompanyService CompanyService
@inject IJSRuntime JS

<PageTitle>Ship To Companies</PageTitle>
@if (!CanView("/companies/ship-to"))
{
    <AccessDenied />
}
else
{
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><Icon Name="IconName.Truck" /> Ship To Companies</h3>
        </div>
        <div class="col-auto">
            <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                <Icon Name="IconName.Plus" /> Add New
            </Button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <Grid TItem="CompanyModel"
              Class="table table-hover table-bordered table-striped"
              Data="companyList"
              AllowPaging="true"
              PageSize="10"
              Responsive="true"
              @ref=shipToCompanyGrid>

            <GridColumn TItem="CompanyModel" HeaderText="No">
                @(companyList?.IndexOf(context) + 1)
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Name" PropertyName="Name">
                @context.Name
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Remark" PropertyName="Remark">
                @context.Remark
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Status" PropertyName="IsActive">
                @if (context.IsActive)
                {
                    <Badge Color="BadgeColor.Success">Active</Badge>
                }
                else
                {
                    <Badge Color="BadgeColor.Danger">Inactive</Badge>
                }
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Actions">
                <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                    <Icon Name="IconName.PencilSquare" /> Edit
                </Button>
                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteCompany(context.Id)">
                    <Icon Name="IconName.Trash" /> Delete
                </Button>
            </GridColumn>
        </Grid>
    }
</div>

<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="SaveCompany">
            <DataAnnotationsValidator />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="companyModel.Name" @oninput="(e) => HandleNameChangeAsync(e.Value?.ToString())" />
                    <ValidationMessage For="@(() => companyModel.Name)" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Remark </label>
                    <InputText class="form-control" @bind-Value="companyModel.Remark" />
                </div>
            </div>

            @if (companyModel.Id > 0)
            {
                <div class="mb-3">
                    <InputCheckbox @bind-Value="companyModel.IsActive" /> Active
                </div>
            }
            <div class="text-end">
                <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>
}

@code {
    private Modal modal;
    private bool isLoading = true;
    private string modalTitle = "Add Ship To Company";
    private bool isEditMode;
    private CompanyModel companyModel = new CompanyModel();
    private Grid<CompanyModel> shipToCompanyGrid;
    private List<CompanyModel> companyList = new List<CompanyModel>();
    private EditContext editContext;
    private ValidationMessageStore validationMessage;


    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        await base.OnInitializedAsync(); // This will call the base authentication check
       
        await LoadCompanies();

        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }

        isLoading = false;
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(companyModel);
        validationMessage = new ValidationMessageStore(editContext);
    }
    private async Task LoadCompanies()
    {
        companyList = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.ShipTo))?.ToList() ?? new List<CompanyModel>();
        isLoading = false;
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Ship To Company";
        isEditMode = false;
        companyModel = new CompanyModel 
        {
            CompanyType = CompanyType.ShipTo, IsActive = true ,
            CreatedBy = Convert.ToInt32(CurrentUserId),

        };        
            InitializeEditContext();
            modal?.ShowAsync();
    }

    private void ShowEditModal(CompanyModel editCompany)
    {
        modalTitle = "Edit Ship To Company";
        isEditMode = true;
        companyModel = new CompanyModel
        {
            Id = editCompany.Id,
            Code = editCompany.Code,
            Name = editCompany.Name,
            CompanyType = CompanyType.ShipTo,
            IsActive = editCompany.IsActive,
            Remark = editCompany.Remark,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
        };
        InitializeEditContext();
        modal?.ShowAsync();
    }

    private async Task SaveCompany()
    {
        try
        {
            companyModel.CompanyType = CompanyType.ShipTo;
            if (!editContext.Validate()) return;

            await ValidateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;

            await ValidateDuplicateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;

            if (isEditMode)
                await CompanyService.UpdateCompanyAsync(companyModel);
            else
                await CompanyService.CreateCompanyAsync(companyModel);

            await HideModal();
            await LoadCompanies();
            if (shipToCompanyGrid != null)
                await shipToCompanyGrid.RefreshDataAsync();
        }
        catch
        {
            // Exception handling omitted for brevity
        }
    }

    private async Task DeleteCompany(int id)
    {
        try
        {
            var isConfirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete?");
            if (isConfirm)
            {
                var deletedBy = Convert.ToInt32(CurrentUserId);
                await CompanyService.DeleteCompanyAsync(id, deletedBy);
                await LoadCompanies();
                if (shipToCompanyGrid != null)
                    await shipToCompanyGrid.RefreshDataAsync();
            }
        }
        catch
        {

        }
    }

    private async Task HideModal()
    {
        if (modal != null)
            await modal.HideAsync();
    }

    private async Task ValidateDuplicateNameAsync()
    {
        validationMessage.Clear();
        if (!string.IsNullOrEmpty(companyModel.Name))
        {
            var isCompanyNameUnique = await CompanyService.IsCompanyNameUniqueAsync(companyModel.Name, companyModel.CompanyType = CompanyType.ShipTo, companyModel.Id);
            if (!isCompanyNameUnique)
            {
                validationMessage.Add(() => companyModel.Name, "Name is Already Exist");
            }
            editContext.NotifyValidationStateChanged();
        }
    }

    private async Task ValidateNameAsync()
    {
        validationMessage.Clear();
        if (string.IsNullOrWhiteSpace(companyModel.Name))
        {
            validationMessage.Add(() => companyModel.Name, "Company name is required");
            editContext.NotifyValidationStateChanged();
        }
    }

    private async Task HandleNameChangeAsync(string newValue)
    {
        companyModel.Name = newValue;
        try
        {
            await ValidateNameAsync();
        }
        catch (Exception ex)
        {

        }
    }
}
