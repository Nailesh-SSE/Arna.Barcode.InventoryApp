 @page "/companies/bill-to"
@inject ICompanyService CompanyService
@inject IJSRuntime JS

<PageTitle>Bill To Companies</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><Icon Name="IconName.Receipt" /> Bill To Companies</h3>
        </div>
        <div class="col-auto">
            <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                <Icon Name="IconName.Plus" /> Add New
            </Button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <Grid TItem="CompanyModel"
              Class="table table-hover table-bordered table-striped"
              DataProvider="CompaniesDataProvider"
              AllowPaging="true"
              PageSize="10"
              Responsive="true"
              @ref=billToCompanyGrid>

            <GridColumn TItem="CompanyModel" HeaderText="Sequence" >
                @(companyList.IndexOf(context) + 1)
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Code" PropertyName="Code">
                @context.Code
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Name" PropertyName="Name">
                @context.Name
            </GridColumn>
            <GridColumn TItem="CompanyModel" HeaderText="Status" PropertyName="IsActive">
                @if (context.IsActive)
                {
                    <Badge Color="BadgeColor.Success">Active</Badge>
                }
                else
                {
                    <Badge Color="BadgeColor.Danger">Inactive</Badge>
                }
            </GridColumn>

            <GridColumn TItem="CompanyModel" HeaderText="Actions">
                <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                    <Icon Name="IconName.PencilSquare" /> Edit
                </Button>
                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteCompany(context.Id)">
                    <Icon Name="IconName.Trash" /> Delete
                </Button>
            </GridColumn>
        </Grid>
    }
</div>

<Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm EditContext="@editContext" OnValidSubmit="SaveCompany">
            <DataAnnotationsValidator />
            
            <div class="row">       
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="companyModel.Name" />
                    <ValidationMessage For="@(() => companyModel.Name)" />
                </div>   
                <div class="col-md-6 mb-3">
                    <label class="form-label">Remark </label>
                    <InputText class="form-control" @bind-Value="companyModel.Remark" />
                </div>
            </div>

            <div class="mb-3">
                <InputCheckbox @bind-Value="companyModel.IsActive" /> Active
            </div>

            <div class="text-end">
                <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>


@code {
    private Modal modal = default!;
    private bool isLoading = true;
    private string modalTitle = "Add Bill To Company";
    private bool isEditMode = false;

    private CompanyModel companyModel = new();
    private Grid<CompanyModel> billToCompanyGrid;
    private List<CompanyModel> companyList = new();
    private EditContext editContext;
    private ValidationMessageStore validationMessage;
    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();   
    }
    public void InitializeEditContextAsync()
    {
        editContext = new EditContext(companyModel);
        validationMessage = new ValidationMessageStore(editContext);

        editContext.OnFieldChanged += async (sender, args) =>
       {
           editContext.Validate();
           await CustomValidationAsync();
           editContext.NotifyValidationStateChanged();
       };
    }
    private async Task CustomValidationAsync()
    {
        validationMessage.Clear();
        if (!string.IsNullOrEmpty(companyModel.Name))
        {
            bool isCompanyNameUnique = await CompanyService.IsCompanyNameUniqueAsync(companyModel.Name, companyModel.Id);

            if (!isCompanyNameUnique)
            {
                validationMessage.Add(() => companyModel.Name, "Company is Already Exist");
            }
            editContext.NotifyValidationStateChanged();
        }
    }
    private async Task LoadCompanies()
    {
        isLoading = true;
        companyList = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.BillTo)).ToList();
        InitializeEditContextAsync();
        isLoading = false;
    }

    private async Task<GridDataProviderResult<CompanyModel>> CompaniesDataProvider(GridDataProviderRequest<CompanyModel> request)
    {
        if (companyList == null || !companyList.Any())
            return await Task.FromResult(new GridDataProviderResult<CompanyModel> { Data = new List<CompanyModel>(), TotalCount = 0 });

        return await Task.FromResult(new GridDataProviderResult<CompanyModel> { Data = companyList, TotalCount = companyList.Count });
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Bill To Company";
        isEditMode = false;
        companyModel = new CompanyModel { CompanyType = CompanyType.BillTo, IsActive = true };
        InitializeEditContextAsync();
        modal.ShowAsync();      
    }

    private void ShowEditModal(CompanyModel editCompany)
    {
        InitializeEditContextAsync();
        modalTitle = "Edit Bill To Company";
        isEditMode = true;
        companyModel = new CompanyModel
        {
            Id = editCompany.Id,
            Code = editCompany.Code,
            Name = editCompany.Name,
            CompanyType = CompanyType.BillTo,
            IsActive = editCompany.IsActive,
            Remark=editCompany.Remark
        };
        modal.ShowAsync();
    }

    private async Task SaveCompany()
    {
        try
        {
            InitializeEditContextAsync();
      
            companyModel.CompanyType = CompanyType.BillTo;

            if (isEditMode)
            {
                await CompanyService.UpdateCompanyAsync(companyModel);
                // Toast notification removed
            }
            else
            {
                await CompanyService.CreateCompanyAsync(companyModel);
                // Toast notification removed
            }

            await HideModal();
            await LoadCompanies();
            await billToCompanyGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            // Toast notification removed
        }
    }

    private async Task DeleteCompany(int id)
    {
        try
        {
            InitializeEditContextAsync();
            bool isConform = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete?");
            if (isConform)
            {
                await CompanyService.DeleteCompanyAsync(id);
                await LoadCompanies();
                await billToCompanyGrid.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            // Toast notification removed
        }
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }

} 