@page "/categories"
@inject IJSRuntime JS
@inject ICategoryService CategoryService
@using InventoryManagement.Components.Auth
@inherits AuthComponentBase

<PageTitle>Categories</PageTitle>

@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    @if (isLoading)
    {
        <div class="text-center">
            <Spinner Type="SpinnerType.Border" />
        </div>
    }
    else
    {
        <div class="container-fluid">
            <div class="row mb-3">
                <div class="col">
                    <h3><Icon Name="IconName.Tags" /> Categories</h3>
                </div>
                @if (CanCreate(Route))
                {
                    <div class="col-auto">
                        <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                            <Icon Name="IconName.Plus" /> Add New
                        </Button>
                    </div>
                }
            </div>

            <Grid TItem="CategoryModel"
                  @ref="categoryGrid"
                  Class="table table-hover table-bordered table-striped"
                  Data="categoryList"
                  AllowPaging="true"
                  PageSize="10"
                  Responsive="true"
                  AllowSorting="true"
                  AllowFiltering="true">


                <GridColumn TItem="CategoryModel" HeaderText="No" Filterable=false>
                    @(categoryList.IndexOf(context) + 1)
                </GridColumn>

                <GridColumn TItem="CategoryModel" HeaderText="Name" PropertyName="Name" SortString="Name" SortKeySelector="item => item.Name" FilterTextboxWidth="200">
                    @context.Name
                </GridColumn>

                <GridColumn TItem="CategoryModel" HeaderText="Description" PropertyName="Description" Filterable=false>
                    @context.Description
                </GridColumn>

                <GridColumn TItem="CategoryModel" HeaderText="Status" PropertyName="IsActive" SortString="IsActive" SortKeySelector="item => item.IsActive">
                    @if (context.IsActive)
                    {
                        <Badge Color="BadgeColor.Success">Active</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Danger">Inactive</Badge>
                    }
                </GridColumn>

                <GridColumn TItem="CategoryModel" HeaderText="Actions" Filterable=false>
                    <div class="d-flex gap-1 justify-content-start">
                        @if (CanEdit(Route))
                        {
                            <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                                <Icon Name="IconName.PencilSquare" /> Edit
                            </Button>
                        }
                        @if (CanDelete(Route))
                        {
                            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteCategory(context.Id)">
                                <Icon Name="IconName.Trash" /> Delete
                            </Button>
                        }
                    </div>
                </GridColumn>
            </Grid>
        </div>
    }

    <Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
        <BodyTemplate>
            <EditForm EditContext="editContext" OnValidSubmit="SaveCategory">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Category Name <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="categoryModel.Name" @oninput="(e) => HandleNameChangeAsync(e.Value?.ToString())" />
                    <ValidationMessage For="@(() => categoryModel.Name)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="categoryModel.Description" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Parent Category</label>
                    <DropDown TItem="CategoryModel"
                              Items="@parentCategoryList"
                              SelectedId="@categoryModel.ParentCategoryId"
                              ValueSelector="x => x.Id"
                              TextSelector="x => x.Name"
                              Placeholder="-- Select Parent Category --"
                              OnValueChanged="OnCategorySelected" />
                </div>
                @if (categoryModel.Id > 0)
                {
                    <div class="mb-3">
                        <InputCheckbox @bind-Value="categoryModel.IsActive" /> Active
                    </div>
                }

                <div class="text-end">
                    <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                    <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
                </div>
            </EditForm>
        </BodyTemplate>
    </Modal>
}
@code {
    private Modal modal = default!;
    private bool isLoading = true;
    private string modalTitle = "Add Category";
    private bool isEditMode = false;
    private Grid<CategoryModel> categoryGrid;
    private CategoryModel categoryModel = new();
    private List<CategoryModel> categoryList = new();
    private List<CategoryModel> parentCategoryList = new();
    private EditContext editContext;
    private ValidationMessageStore messageStore;
    private CancellationTokenSource _validationCts;
    private string Route = "/categories";
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        await base.OnInitializedAsync();
        await LoadCategories();

        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }
        isLoading = false;

    }

    private async Task LoadCategories()
    {
        categoryList = (await CategoryService.GetAllCategoriesAsync()).ToList();
        parentCategoryList = categoryList.Where(c => c.ParentCategoryId == null).ToList();
    }
    private void InitializeEditContext()
    {
        editContext = new EditContext(categoryModel);
        messageStore = new ValidationMessageStore(editContext);
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Category";
        isEditMode = false;
        categoryModel = new CategoryModel
        {
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.UtcNow
        };
        InitializeEditContext();
        modal.ShowAsync();
    }

    private void ShowEditModal(CategoryModel editCategory)
    {
        modalTitle = "Edit Category";
        isEditMode = true;
        categoryModel = new CategoryModel
        {
            Id = editCategory.Id,
            Name = editCategory.Name,
            Description = editCategory.Description,
            ParentCategoryId = editCategory.ParentCategoryId,
            IsActive = editCategory.IsActive,
            SerialNumber = editCategory.SerialNumber,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
            UpdatedOn = DateTime.UtcNow
        };
        InitializeEditContext();
        modal?.ShowAsync();
    }

    private async Task SaveCategory()
    {
        try
        {
            if (!editContext.Validate()) return;
            await ValidateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;

            await ValidateDuplicateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;
            if (isEditMode)
            {
                await CategoryService.UpdateCategoryAsync(categoryModel);
            }
            else
            {
                await CategoryService.CreateCategoryAsync(categoryModel);
            }

            await HideModal();
            await LoadCategories();
            await categoryGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
        }
    }

    private async Task DeleteCategory(int id)
    {
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm", "Do you want to delete this category?");
            if (!confirmed)
                return;
            var updatedbyuser = Convert.ToInt32(CurrentUserId);
            await CategoryService.DeleteCategoryAsync(id, updatedbyuser);
            await LoadCategories();
            await categoryGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
        }
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }
    private async Task ValidateDuplicateNameAsync()
    {
        messageStore.Clear();
        bool isNameUnique = await CategoryService.IsCategoryNameUniqueAsync(categoryModel.Name, categoryModel.Id);
        if (!isNameUnique)
        {
            messageStore.Add(() => categoryModel.Name, "Category name already exists.");
            editContext.NotifyValidationStateChanged();
        }
    }
    private async Task ValidateNameAsync()
    {
        messageStore.Clear();
        if (string.IsNullOrWhiteSpace(categoryModel.Name))
        {
            messageStore.Add(() => categoryModel.Name, "Category name is required.");
            editContext.NotifyValidationStateChanged();
        }

    }
    private async Task HandleNameChangeAsync(string newValue)
    {
        categoryModel.Name = newValue;
        try
        {
            await ValidateNameAsync();
        }
        catch (Exception ex)
        {
        }
    }
    private void OnCategorySelected((int? Id, string Name) selected)
    {
        categoryModel.ParentCategoryId = selected.Id;
        categoryModel.ParentCategoryName = selected.Name;
    }
}