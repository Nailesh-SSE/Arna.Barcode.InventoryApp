@page "/"
@layout Layout.MainLayout
@inherits InventoryManagement.Components.Auth.AuthComponentBase
@inject NavigationManager NavigationManager


<PageTitle>Dashboard - Inventory Management</PageTitle>


@if (IsLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="ms-2">authenticating user...</span>
    </div>
}
else if (IsAuthenticated)
{
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <div class="jumbotron bg-light p-5 rounded">
                    <h1 class="display-4">
                        <Icon Name="IconName.HouseDoorFill" /> Welcome to Inventory Management System
                    </h1>
                    <p class="lead">Manage your inventory efficiently with our comprehensive system</p>
                    <hr class="my-4">
                    <p>Track inward and outward movements, manage products, categories, and companies all in one place.</p>
                    <p class="text-muted">
                        <strong>Welcome back, @CurrentUserFullName</strong>
                    </p>
                </div>
            </div>
        </div>


        <!-- Dashboard Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <Card>
                    <CardBody class="text-center">
                        <Icon Name="IconName.Box" Color="IconColor.Primary" Size="IconSize.x2" />
                        <h5 class="card-title mt-2">Master Data</h5>
                        <p class="card-text">Manage companies, categories, and products</p>
                        <Button Color="ButtonColor.Primary" To="/categories" Size="ButtonSize.Small">
                            Manage
                        </Button>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-3">
                <Card>
                    <CardBody class="text-center">
                        <Icon Name="IconName.ArrowDownCircle" Color="IconColor.Success" Size="IconSize.x2" />
                        <h5 class="card-title mt-2">Inward Management</h5>
                        <p class="card-text">Track incoming inventory and shipments</p>
                        <Button Color="ButtonColor.Success" To="/inward" Size="ButtonSize.Small">
                            Inward
                        </Button>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-3">
                <Card>
                    <CardBody class="text-center">
                        <Icon Name="IconName.ArrowUpCircle" Color="IconColor.Warning" Size="IconSize.x2" />
                        <h5 class="card-title mt-2">Outward Management</h5>
                        <p class="card-text">Manage outgoing inventory and deliveries</p>
                        <Button Color="ButtonColor.Warning" To="/outward" Size="ButtonSize.Small">
                            Outward
                        </Button>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-3">
                <Card>
                    <CardBody class="text-center">
                        <Icon Name="IconName.ArrowReturnLeft" Color="IconColor.Danger" Size="IconSize.x2" />
                        <h5 class="card-title mt-2">Sales Return</h5>
                        <p class="card-text">Handle product returns and exchanges</p>
                        <Button Color="ButtonColor.Danger" To="/sale-returns" Size="ButtonSize.Small">
                            Returns
                        </Button>
                    </CardBody>
                </Card>
            </div>
        </div>

        <!-- Quick Actions Section -->
        <div class="row g-4">
            <div class="col-md-6">
                <Card>
                    <CardBody>
                        <h5 class="card-title">
                            <Icon Name="IconName.Building" Color="IconColor.Primary" />
                            Company Management
                        </h5>
                        <p class="card-text">Manage your company relationships and contacts</p>
                        <div class="d-grid gap-2">
                            <Button Color="ButtonColor.Secondary" To="/companies/shipto" Size="ButtonSize.Small">
                                <Icon Name="IconName.Truck" /> Ship To Companies
                            </Button>
                            <Button Color="ButtonColor.Secondary" To="/companies/maketo" Size="ButtonSize.Small">
                                <Icon Name="IconName.House" /> Make To Companies
                            </Button>
                            <Button Color="ButtonColor.Secondary" To="/companies/billto" Size="ButtonSize.Small">
                                <Icon Name="IconName.Receipt" /> Bill To Companies
                            </Button>
                        </div>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-6">
                <Card>
                    <CardBody>
                        <h5 class="card-title">
                            <Icon Name="IconName.BarChart" Color="IconColor.Info" />
                            Reports & Analytics
                        </h5>
                        <p class="card-text">View comprehensive reports and business analytics</p>
                        <div class="d-grid gap-2">
                            <Button Color="ButtonColor.Info" To="/sales-reports" Size="ButtonSize.Small">
                                <Icon Name="IconName.GraphUp" /> Sales Reports
                            </Button>
                            <Button Color="ButtonColor.Secondary" To="/inventory-reports" Size="ButtonSize.Small">
                                <Icon Name="IconName.Boxes" /> Inventory Reports
                            </Button>
                            <Button Color="ButtonColor.Secondary" To="/product-reports" Size="ButtonSize.Small">
                                <Icon Name="IconName.Tags" /> Product Reports
                            </Button>
                        </div>
                    </CardBody>
                </Card>
            </div>
        </div>

        <!-- Welcome Information -->
        <div class="row mt-4">
            <div class="col-12">
                <Card>
                    <CardBody>
                        <h5 class="card-title">
                            <Icon Name="IconName.InfoCircle" /> Getting Started
                        </h5>
                        <p class="card-text">
                            Welcome to your inventory management dashboard. Here's how to get started:
                        </p>
                        <div class="row">
                            <div class="col-md-4">
                                <h6><Icon Name="IconName.Dice1" /> Setup Master Data</h6>
                                <p class="small">Configure your companies, categories, and products first.</p>
                            </div>
                            <div class="col-md-4">
                                <h6><Icon Name="IconName.Dice2" /> Record Inward</h6>
                                <p class="small">Add incoming inventory with barcode generation.</p>
                            </div>
                            <div class="col-md-4">
                                <h6><Icon Name="IconName.Dice3" /> Process Outward</h6>
                                <p class="small">Manage sales, deliveries, and track inventory movement.</p>
                            </div>
                        </div>
                    </CardBody>
                </Card>
            </div>
        </div>
    </div>

}
else
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="text-center">
            <h3>Authentication Required</h3>
            <p class="text-muted">Please log in to access the dashboard.</p>
            <Button Color="ButtonColor.Primary" @onclick="@(() => NavigationManager.NavigateTo("/login"))">
                Go to Login
            </Button>
        </div>
    </div>
}