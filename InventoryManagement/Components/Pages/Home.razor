@page "/"
@layout Layout.MainLayout
@inject NavigationManager NavigationManager

<PageTitle>Dashboard - Inventory Management</PageTitle>

@if (IsLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="ms-2">authenticating user...</span>
    </div>
}
else if (IsAuthenticated)
{
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <div class="jumbotron bg-light p-5 rounded">
                    <h1 class="display-4">
                        <Icon Name="IconName.HouseDoorFill" /> Welcome to Inventory Management System
                    </h1>
                    <p class="lead">Manage your inventory efficiently with our comprehensive system</p>
                    <hr class="my-4">
                    <p>Track inward and outward movements, manage products, categories, and companies all in one place.</p>
                    <p class="text-muted">
                        <strong>Welcome back, @CurrentUserFullName</strong>
                    </p>
                </div>
            </div>
        </div>


        <!-- Dashboard Summary Cards -->
     
        <!-- Quick Actions Section -->
        <div class="row g-4">
            <div class="col-md-6">
                <Card>
                    <CardBody>
                        <h5 class="card-title">
                            <Icon Name="IconName.Building" Color="IconColor.Primary" />
                            Company Management
                        </h5>
                        <p class="card-text">Manage your company relationships and contacts</p>
                        <div class="d-grid gap-2">
                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" >
                                <NavLink class="nav-link"  href="companies/ship-to">
                                    <Icon Name="IconName.Truck" />&nbsp;  Ship To Companies
                                </NavLink>                
                            </Button>
                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small">
                                <NavLink class="nav-link text-white" href="companies/make-to">
                                    <Icon Name="IconName.House" />&nbsp; Make To Companies
                                </NavLink>
                                </Button>
                                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small">
                                    <NavLink class="nav-link text-white" href="companies/bill-to">
                                        <Icon Name="IconName.Receipt" />&nbsp; Bill To Companies
                                    </NavLink>
                                </Button>
                        </div>
                    </CardBody> 
                </Card>
            </div>

            <div class="col-md-6">
                <Card>
                    <CardBody>
                        <h5 class="card-title">
                            <Icon Name="IconName.BarChart" Color="IconColor.Info" />
                            Reports & Analytics
                        </h5>
                        <p class="card-text">View comprehensive reports and business analytics</p>
                        <div class="d-grid gap-2">
                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small">
                                <NavLink class="nav-link text-white" href="/inward">
                                    <Icon Name="IconName.BoxSeam" /> InStock
                                </NavLink>
                            </Button>
                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small">
                                <NavLink class="nav-link text-white" href="/outward">
                                    <Icon Name="IconName.CartDash" /> OutStock
                                </NavLink>
                            </Button>

                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small">
                                <NavLink class="nav-link text-white" href="/sale-returns">
                                    <Icon Name="IconName.GraphUp" /> Sales Reports
                                </NavLink>
                            </Button>
                        </div>
                    </CardBody>
                </Card>
            </div>
        </div>

        <!-- Welcome Information -->
        <div class="row mt-4">
            <div class="col-12">
                <Card>
                    <CardBody>
                        <h5 class="card-title">
                            <Icon Name="IconName.InfoCircle" /> Getting Started
                        </h5>
                        <p class="card-text">
                            Welcome to your inventory management dashboard. Here's how to get started:
                        </p>
                        <div class="row">
                            <div class="col-md-4">
                                <h6><Icon Name="IconName.Dice1" /> Setup Master Data</h6>
                                <p class="small">Configure your companies, categories, and products first.</p>
                            </div>
                            <div class="col-md-4">
                                <h6><Icon Name="IconName.Dice2" /> Record Inward</h6>
                                <p class="small">Add incoming inventory with barcode generation.</p>
                            </div>
                            <div class="col-md-4">
                                <h6><Icon Name="IconName.Dice3" /> Process Outward</h6>
                                <p class="small">Manage sales, deliveries, and track inventory movement.</p>
                            </div>
                        </div>
                    </CardBody>
                </Card>
            </div>
        </div>
    </div>

}
else
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="text-center">
            <h3>Authentication Required</h3>
            <p class="text-muted">Please log in to access the dashboard.</p>
            <Button Color="ButtonColor.Primary" @onclick="@(() => NavigationManager.NavigateTo("/login",true))">
                Go to Login
            </Button>
        </div>
    </div>
}