@page "/products"
@using InventoryManagement.Core.Enums
@inject IJSRuntime JS
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject ICompanyService CompanyService
@inject IColourService ColourService
@using InventoryManagement.Components.Auth
@using InventoryManagement.Services.Models;
@inherits AuthComponentBase
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

<PageTitle>Products</PageTitle>
@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <h3><Icon Name="IconName.Box" /> Products</h3>
            </div>
            @if (IsAdmin() || IsFactoryAdmin())
            {
                <div class="col-auto">
                    <button class="btn btn-outline-success"
                            disabled="@isExporting"
                            @onclick="ExportCurrentReport">
                        @if (isExporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Exporting...</span>
                        }
                        else
                        {
                            <Icon Name="IconName.Download" />
                            <span>Export</span>
                        }
                    </button>
                </div>
            }
            @if (CanCreate(Route))
            {
                <div class="col-auto">
                    <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                        <Icon Name="IconName.Plus" /> Add New
                    </Button>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                @alertMessage
                <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
            </div>
        }
        @if (isLoading)
        {
            <div class="text-center">
                <Spinner Type="SpinnerType.Border" />
            </div>
        }
        else
        {
            <Grid TItem="ProductModel"
                  @ref=productGrid
                  Class="table table-hover table-bordered table-striped"
                  Data="@products"
                  AllowPaging="true"
                  PageSize="10"
                  AllowFiltering="true"
                  AllowSorting="true"
                  Responsive="true">

                <GridColumn TItem="ProductModel" HeaderText="No" PropertyName="Id" Filterable=false>
                    @{
                        var index = products.IndexOf(context) + 1;
                    }
                    @index
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="SKU" PropertyName="SKU" SortKeySelector="item => item.SKU" SortString="SKU" FilterTextboxWidth="98">
                    @context.SKU
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Name" PropertyName="Name" SortKeySelector="item => item.Name" SortString="Name" FilterTextboxWidth="98">
                    @context.Name
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Category" PropertyName="CategoryName" SortKeySelector="item => item.CategoryName" SortString="CategoryName" FilterTextboxWidth="98">
                    @context.CategoryName
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Unit" PropertyName="Unit" Filterable="false">
                    @context.Unit
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Image" Filterable=false>
                    @if (!string.IsNullOrEmpty(context.ImagePath))
                    {
                        <img src="@context.ImagePath" alt="Product Image" style="max-height: 45px; max-width: 45px; object-fit: cover; border-radius: 4px; border: 1px solid #dee2e6;" />
                    }
                    else
                    {
                        <span class="text-muted small">No Image</span>
                    }
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Status" PropertyName="IsActive" SortKeySelector="item => item.IsActive" SortString="IsActive" Sortable=false>
                    @if (context.IsActive)
                    {
                        <Badge Color="BadgeColor.Success">Active</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Danger">Inactive</Badge>
                    }
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Actions" Filterable=false>
                    <div class="d-flex gap-1 justify-content-start">
                        @if (CanEdit(Route))
                        {
                            <Button class="text-nowrap" Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                                <Icon Name="IconName.PencilSquare" /> Edit
                            </Button>
                        }
                        @if (CanDelete(Route))
                        {
                            <LoadingButton class="text-nowrap" Color="ButtonColor.Danger" Size="ButtonSize.Small" onclick="() => DeleteProduct(context.Id)">
                                <Icon Name="IconName.Trash" /> Delete
                            </LoadingButton>
                        }
                    </div>
                </GridColumn>
            </Grid>
        }
    </div>

    <Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
        <BodyTemplate>
            <EditForm EditContext="@editContext" OnValidSubmit="SaveProduct">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Name <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="productModel.Name" @oninput="HandleNameChange" />
                        <ValidationMessage For="@(() => productModel.Name)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Brand <span class="text-danger">*</span></label>
                        <DropDown TItem="CompanyModel"
                                  Items="@companies"
                                  SelectedId="@productModel.MakeCompanyId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Brand--"
                                  OnValueChanged="OnBrandSelected" />
                        <ValidationMessage For="@(() => productModel.MakeCompanyId)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <DropDown TItem="CategoryModel"
                                  Items="@categories"
                                  SelectedId="@productModel.CategoryId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Category --"
                                  OnValueChanged="OnCategorySelected" />
                        <ValidationMessage For="@(() => productModel.CategoryId)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Unit <span class="text-danger">*</span></label>
                        <DropDown TItem="UnitModel"
                                  Items="@Units"
                                  SelectedId="@productModel.UnitId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Unit --"
                                  OnValueChanged="OnUnitSelected" />
                        <ValidationMessage For="@(() => productModel.UnitId)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3 position-relative">
                        <label class="form-label">Colour <span class="text-danger">*</span></label>

                        <SearchableDropdown TItem="ColourModel"
                                            Items="@Colours"
                                            ItemTextSelector="@(c => c.Name)"
                                            SelectedText="@productModel.ColourSearchText"
                                            Placeholder="Search Colour..."
                                            OnItemSelected="OnColourSelected"
                                            IsRequired="true"
                                            ShowValidationMessage="true" />

                        <ValidationMessage For="@(() => productModel.ColourId)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Product Image</label>
                        <InputFile class="form-control" OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" />
                        @if (isUploadingImage)
                        {
                            <div class="mt-2 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
                        }
                        @if (!string.IsNullOrEmpty(previewImageBase64) || !string.IsNullOrEmpty(productModel.ImagePath))
                        {
                            <div class="mt-2 position-relative d-inline-block">
                                <img src="@(!string.IsNullOrEmpty(previewImageBase64) ? previewImageBase64 : productModel.ImagePath)" alt="Preview" style="max-height: 100px; max-width: 100px; border: 1px solid #ccc; border-radius: 4px; object-fit: cover;" />
                                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0" @onclick="RemoveImage" style="padding: 0px 5px; font-size: 10px; line-height: 1.2; border-radius: 50%;">×</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="productModel.Description" />
                </div>

                @if (productModel.Id > 0)
                {
                    <div class="mb-3">
                        <InputCheckbox @bind-Value="productModel.IsActive" /> Active
                    </div>
                }
                <div class="text-end">
                    <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                    <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
                </div>
            </EditForm>
        </BodyTemplate>
    </Modal>
}
@code {
    private Modal modal = default!;
    private List<ProductModel> products = new();
    private List<CategoryModel> categories = new();
    private List<CompanyModel> companies = new();
    private List<ColourModel> Colours = new();
    private ProductModel productModel = new();
    private Grid<ProductModel> productGrid;
    private bool isLoading = true;
    private string modalTitle = "Add Product";
    private bool isEditMode = false;
    private EditContext editContext;
    private ValidationMessageStore messageStore;
    private List<UnitModel> Units => CommonUtils.UnitList;
    private string Route = "/products";
    private bool isSaveBtnLoading = false;
    private bool isExporting = false;
    private string? alertMessage;
    private string alertType = "info";
    private bool isUploadingImage = false;
    private IBrowserFile? selectedFile;
    private string? previewImageBase64;
    private bool imageRemoved = false;
    private byte[]? compressedImageBytes;
    private string? imageToDeletePath;



    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }

        await LoadData();
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(productModel);
        messageStore = new ValidationMessageStore(editContext);
    }

    private async Task LoadData()
    {
        isLoading = true;
        products = (await ProductService.GetAllProductsAsync()).ToList();
        categories = (await CategoryService.GetAllCategoriesAsync()).Where(x => x.IsActive).ToList();
        companies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.MakeTo)).Where(x => x.IsActive).ToList();
        Colours = (await ColourService.GetAllColourAsync()).Where(x => x.IsActive).ToList();
        foreach (var product in products)
        {
            product.CategoryName = categories.FirstOrDefault(c => c.Id == product.CategoryId)?.Name ?? string.Empty;
        }
        isLoading = false;
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Product";
        isEditMode = false;
        productModel = new ProductModel
        {
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.Now,
            UnitId = (int)UnitType.PCS
        };
        selectedFile = null;
        previewImageBase64 = null;
        imageRemoved = false;
        compressedImageBytes = null;
        imageToDeletePath = null;
        InitializeEditContext();
        modal.ShowAsync();
    }

    private void ShowEditModal(ProductModel editProduct)
    {
        modalTitle = "Edit Product";
        isEditMode = true;
        productModel = new ProductModel
        {
            Id = editProduct.Id,
            SKU = editProduct.SKU,
            Name = editProduct.Name.Trim(),
            Description = editProduct.Description,
            CategoryId = editProduct.CategoryId,
            CategoryName = editProduct.CategoryName,
            Unit = editProduct.Unit,
            UnitId = editProduct.UnitId,
            IsActive = editProduct.IsActive,
            MakeCompanyId = editProduct.MakeCompanyId,
            MakeCompany = editProduct.MakeCompany,
            SerialNumber = editProduct.SerialNumber,
            ColourId = editProduct.ColourId,
            ColourName = editProduct.ColourName,
            ColourSearchText = editProduct.ColourName,
            ImagePath = editProduct.ImagePath,
            UpdatedBy = Convert.ToInt32(CurrentUserId),
            UpdatedOn = DateTime.Now
        };
        selectedFile = null;
        previewImageBase64 = null;
        imageRemoved = false;
        compressedImageBytes = null;
        imageToDeletePath = null;
        InitializeEditContext();
        modal.ShowAsync();
    }

    private async Task SaveProduct()
    {
        if (isSaveBtnLoading) return;
        try
        {
            isSaveBtnLoading = true;
            if (!editContext.Validate()) return;
            await HandleAllFieldsAsync();
            if (editContext.GetValidationMessages().Any())
                return;
            await ValidateDuplicateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;
            productModel.Unit = Units.FirstOrDefault(u => u.Id == productModel.UnitId)?.Name ?? string.Empty;
            productModel.MakeCompany = companies.FirstOrDefault(m => m.Id == productModel.MakeCompanyId)?.Name ?? string.Empty;
            productModel.CategoryName = categories.FirstOrDefault(c => c.Id == productModel.CategoryId)?.Name ?? string.Empty;
            productModel.ColourName = Colours.FirstOrDefault(c => c.Id == productModel.ColourId)?.Name ?? string.Empty;

            if (isEditMode)
            {
                if (!string.IsNullOrEmpty(imageToDeletePath))
                {
                    DeletePhysicalImage(imageToDeletePath);
                    imageToDeletePath = null;
                }

                if (compressedImageBytes != null)
                {
                    var savedPath = await SaveCompressedFileAsync(compressedImageBytes);
                    if (savedPath != null)
                    {
                        if (!string.IsNullOrEmpty(productModel.ImagePath))
                        {
                            DeletePhysicalImage(productModel.ImagePath);
                        }
                        productModel.ImagePath = savedPath;
                    }
                }

                await ProductService.UpdateProductAsync(productModel);
            }
            else
            {
                if (compressedImageBytes != null)
                {
                    var savedPath = await SaveCompressedFileAsync(compressedImageBytes);
                    if (savedPath != null)
                    {
                        productModel.ImagePath = savedPath;
                    }
                }

                await ProductService.CreateProductAsync(productModel);
            }

            await HideModal();
            await LoadData();
            await productGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to save product: {ex.Message}");
        }
        finally
        {
            isSaveBtnLoading = false;
        }
    }

    private async Task DeleteProduct(int id)
    {
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm", "Do you really want to delete this product?");
            if (!confirmed) return;

            var userid = Convert.ToInt32(CurrentUserId);
            var product = products.FirstOrDefault(p => p.Id == id);
            if (product != null && !string.IsNullOrEmpty(product.ImagePath))
            {
                DeletePhysicalImage(product.ImagePath);
            }

            await ProductService.DeleteProductAsync(id, userid);
            await LoadData();
            await productGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to delete product: {ex.Message}");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
                var extension = Path.GetExtension(file.Name).ToLower();
                if (!allowedExtensions.Contains(extension))
                {
                    ShowAlert("danger", "Only JPG, JPEG, PNG, and WEBP files are allowed.");
                    return;
                }

                if (file.Size > 5 * 1024 * 1024) // 5MB limit for original upload before compression
                {
                    ShowAlert("danger", "Original image size must be less than 5MB.");
                    return;
                }

                isUploadingImage = true;
                StateHasChanged();

                using (var stream = file.OpenReadStream(5 * 1024 * 1024))
                using (var streamRef = new Microsoft.JSInterop.DotNetStreamReference(stream))
                {
                    // Call JS to compress image to max 1024x1024 and 75% quality (JPEG output)
                    var compressedBase64 = await JS.InvokeAsync<string>("compressImage", streamRef, file.ContentType, 1024, 1024, 0.75);

                    previewImageBase64 = compressedBase64;
                    var base64Data = compressedBase64.Substring(compressedBase64.IndexOf(",") + 1);
                    compressedImageBytes = Convert.FromBase64String(base64Data);
                    selectedFile = null;
                    imageRemoved = false;
                }
            }
            catch (Exception ex)
            {
                ShowAlert("danger", $"Failed to process and compress image: {ex.Message}");
            }
            finally
            {
                isUploadingImage = false;
                StateHasChanged();
            }
        }
    }

    private void RemoveImage()
    {
        if (!string.IsNullOrEmpty(productModel.ImagePath))
        {
            imageToDeletePath = productModel.ImagePath;
        }
        previewImageBase64 = null;
        selectedFile = null;
        compressedImageBytes = null;
        productModel.ImagePath = null;
        imageRemoved = true;
        StateHasChanged();
    }

    private async Task<string?> SaveCompressedFileAsync(byte[] bytes)
    {
        try
        {
            var uploadsDir = Path.Combine(WebHostEnvironment.WebRootPath, "images", "products");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var uniqueFileName = $"{DateTime.Now:ddMMyyyy_HHmmss}_{Guid.NewGuid().ToString("N")[..6]}.jpg";

            var filePath = Path.Combine(uploadsDir, uniqueFileName);

            await File.WriteAllBytesAsync(filePath, bytes);

            return $"/images/products/{uniqueFileName}";
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to save image file: {ex.Message}");
            return null;
        }
    }

    private void DeletePhysicalImage(string relativePath)
    {
        try
        {
            var absolutePath = Path.Combine(WebHostEnvironment.WebRootPath, relativePath.TrimStart('/'));
            if (File.Exists(absolutePath))
            {
                File.Delete(absolutePath);
            }
        }
        catch (Exception)
        {
            // Ignore deletion errors
        }
    }

    private async Task HideModal()
    {
        await modal.HideAsync();
    }
    private async Task HandleAllFieldsAsync()
    {
        try
        {
            await ValidateMakeCompany();
            await ValidateCategory();
            await ValidateName();
            await ValidateUnit();
            await ValidateColour();
        }
        catch (Exception ex)
        {

        }
    }
    private async Task ValidateName()
    {
        messageStore.Clear(() => productModel.Name);
        if (string.IsNullOrWhiteSpace(productModel.Name))
        {
            messageStore.Add(() => productModel.Name, "Product name is required.");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task ValidateMakeCompany()
    {
        messageStore.Clear(() => productModel.MakeCompanyId);
        if (productModel.MakeCompanyId == 0)
        {
            messageStore.Add(() => productModel.MakeCompanyId, "Please select Make company");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task ValidateUnit()
    {
        messageStore.Clear(() => productModel.UnitId);
        if (productModel.UnitId == 0)
        {
            messageStore.Add(() => productModel.UnitId, "Please select Unit");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task ValidateCategory()
    {
        messageStore.Clear(() => productModel.CategoryId);
        if (productModel.CategoryId == 0)
        {
            messageStore.Add(() => productModel.CategoryId, "Please select Category");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task ValidateColour()
    {
        messageStore.Clear(() => productModel.ColourId);
        if (productModel.ColourId == 0)
        {
            messageStore.Add(() => productModel.ColourId, "Please select Colour");
        }
        editContext.NotifyValidationStateChanged();
    }

    private async Task ValidateDuplicateNameAsync()
    {
        messageStore.Clear(() => productModel.Name);
        if (!string.IsNullOrEmpty(productModel.Name))
        {
            var company = companies.FirstOrDefault(c => c.Id == productModel.MakeCompanyId);
            var colour = Colours.FirstOrDefault(c => c.Id == productModel.ColourId);
            var isProductNameUnique = await ProductService.IsProductNameUniqueAsync(productModel.Name, productModel.MakeCompanyId, productModel.ColourId, productModel.Id);
            if (!isProductNameUnique)
            {
                var companyName = company?.Name ?? "this company";
                var colourName = colour?.Name ?? "this color";
                messageStore.Add(() => productModel.Name, $"Name is Already Exist in {companyName} with {colourName} colour ");
            }
        }
        editContext.NotifyValidationStateChanged();
    }

    private void HandleNameChange(ChangeEventArgs e)
    {
        productModel.Name = e.Value?.ToString();
        ValidateName();
    }

    private void HandleMakeCompanyChange(ChangeEventArgs e)
    {
        productModel.MakeCompanyId = Convert.ToInt32(e.Value);
        ValidateMakeCompany();
    }

    private void HandleCategoryChange(ChangeEventArgs e)
    {
        productModel.CategoryId = Convert.ToInt32(e.Value);
        ValidateCategory();
    }

    private void HandleUnitChange(ChangeEventArgs e)
    {
        productModel.UnitId = Convert.ToInt32(e.Value);
        ValidateUnit();
    }

    private void HandleColourChange(ChangeEventArgs e)
    {
        productModel.ColourId = Convert.ToInt32(e.Value);
        ValidateColour();
    }

    private void OnColourSelected(ColourModel colour)
    {
        if (colour == null)
        {
            productModel.ColourId = 0;
            productModel.ColourSearchText = "";
            productModel.ColourName = "";
        }
        else
        {
            productModel.ColourId = colour.Id;
            productModel.ColourName = colour.Name;
            productModel.ColourSearchText = colour.Name;
        }

        ValidateColour();
        StateHasChanged();
    }
    private void OnCategorySelected((int? Id, string Name) selected)
    {
        productModel.CategoryId = selected.Id ?? 0;
        productModel.CategoryName = selected.Name;

        ValidateCategory();
    }
    private void OnBrandSelected((int? Id, string Name) selected)
    {
        productModel.MakeCompanyId = selected.Id ?? 0;
        productModel.MakeCompany = selected.Name;

        ValidateMakeCompany();
    }
    private void OnUnitSelected((int? Id, string Name) selected)
    {
        productModel.UnitId = selected.Id ?? 0;
        productModel.Unit = selected.Name;

        ValidateUnit();
    }
    private async Task ExportCurrentReport()
    {
        isExporting = true;
        StateHasChanged();
        try
        {
            await Task.Delay(100);
            var excelData = await ProductService.ExportToExcelAsync();
            var fileName = $"Product_Report_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            var filePath = Path.Combine(Environment.CurrentDirectory, "wwwroot", "exports");

            if (!Directory.Exists(filePath))
                Directory.CreateDirectory(filePath);

            var fullPath = Path.Combine(filePath, fileName);
            await File.WriteAllBytesAsync(fullPath, excelData);

            // Browser downloads static file directly
            var downloadUrl = $"/exports/{fileName}";
            NavigationManager.NavigateTo(downloadUrl, forceLoad: true);

            ShowAlert("success", "Excel exported successfully. Check your Downloads folder.");
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to export excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
    private void ShowAlert(string type, string message)
    {
        alertType = type;
        alertMessage = message;
        _ = AutoHideAlertAsync();
    }
    private async Task AutoHideAlertAsync()
    {
        await Task.Delay(3000);
        alertMessage = null;
        await InvokeAsync(StateHasChanged);
    }
}
