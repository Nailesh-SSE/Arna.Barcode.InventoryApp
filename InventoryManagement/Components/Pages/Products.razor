@page "/products"
@using InventoryManagement.Core.Enums
@inject IJSRuntime JS
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject ICompanyService CompanyService
@inject IColourService ColourService
@using InventoryManagement.Components.Auth
@using InventoryManagement.Services.Models;
@inherits AuthComponentBase
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

<PageTitle>Products</PageTitle>
@if (!CanView(Route))
{
    <AccessDenied />
}
else
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <h3><Icon Name="IconName.Box" /> Products</h3>
            </div>
            @if (IsAdmin() || IsFactoryAdmin())
            {
                <div class="col-auto">
                    <button class="btn btn-outline-success"
                            disabled="@isExporting"
                            @onclick="ExportCurrentReport">
                        @if (isExporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Exporting...</span>
                        }
                        else
                        {
                            <Icon Name="IconName.Download" />
                            <span>Export</span>
                        }
                    </button>
                </div>
            }
            @if (CanCreate(Route))
            {
                <div class="col-auto">
                    <Button Color="ButtonColor.Primary" @onclick="ShowAddModal">
                        <Icon Name="IconName.Plus" /> Add New
                    </Button>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                @alertMessage
                <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
            </div>
        }
        @if (isLoading)
        {
            <div class="text-center">
                <Spinner Type="SpinnerType.Border" />
            </div>
        }
        else
        {
            <Grid TItem="ProductModel"
                  @ref=productGrid
                  Class="table table-hover table-bordered table-striped"
                  Data="@products"
                  AllowPaging="true"
                  PageSize="10"
                  AllowFiltering="true"
                  AllowSorting="true"
                  Responsive="true">

                <GridColumn TItem="ProductModel" HeaderText="No" PropertyName="Id" Filterable=false>
                    @{
                        var index = products.IndexOf(context) + 1;
                    }
                    @index
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="SKU" PropertyName="SKU" SortKeySelector="item => item.SKU" SortString="SKU" FilterTextboxWidth="98">
                    @context.SKU
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Name" PropertyName="Name" SortKeySelector="item => item.Name" SortString="Name" FilterTextboxWidth="98">
                    @context.Name
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Category" PropertyName="CategoryName" SortKeySelector="item => item.CategoryName" SortString="CategoryName" FilterTextboxWidth="98">
                    @context.CategoryName
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Unit" PropertyName="Unit" Filterable="false">
                    @context.Unit
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Price" PropertyName="Price" Filterable="false">
                    @context.Price.ToString("N2")
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="MRP" PropertyName="MRP" Filterable="false">
                    @context.MRP.ToString("N2")
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Image" Filterable=false>
                    @if (!string.IsNullOrEmpty(context.ImagePath))
                    {
                        <div class="position-relative d-inline-block">
                            <img src="@context.ImagePath" alt="Product Image" style="max-height: 45px; max-width: 45px; object-fit: cover; border-radius: 4px; border: 1px solid #dee2e6;" />
                            @if (context.Images != null && context.Images.Count(i => !i.IsMarkedForDeletion) > 1)
                            {
                                <span class="badge bg-secondary position-absolute bottom-0 end-0 m-0" style="font-size: 8px; padding: 2px 4px;">+@(context.Images.Count(i => !i.IsMarkedForDeletion) - 1)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">No Image</span>
                    }
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Status" PropertyName="IsActive" SortKeySelector="item => item.IsActive" SortString="IsActive" Sortable=false>
                    @if (context.IsActive)
                    {
                        <Badge Color="BadgeColor.Success">Active</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Danger">Inactive</Badge>
                    }
                </GridColumn>

                <GridColumn TItem="ProductModel" HeaderText="Actions" Filterable=false>
                    <div class="d-flex gap-1 justify-content-start">
                        @if (CanEdit(Route))
                        {
                            <Button class="text-nowrap" Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)">
                                <Icon Name="IconName.PencilSquare" /> Edit
                            </Button>
                        }
                        @if (CanDelete(Route))
                        {
                            <LoadingButton class="text-nowrap" Color="ButtonColor.Danger" Size="ButtonSize.Small" onclick="() => DeleteProduct(context.Id)">
                                <Icon Name="IconName.Trash" /> Delete
                            </LoadingButton>
                        }
                    </div>
                </GridColumn>
            </Grid>
        }
    </div>

    <Modal @ref="modal" Title="@modalTitle" Size="ModalSize.Large" UseStaticBackdrop>
        <BodyTemplate>
            <EditForm EditContext="@editContext" OnValidSubmit="SaveProduct">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Name <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="productModel.Name" @oninput="HandleNameChange" />
                        <ValidationMessage For="@(() => productModel.Name)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Brand <span class="text-danger">*</span></label>
                        <DropDown TItem="CompanyModel"
                                  Items="@companies"
                                  SelectedId="@productModel.MakeCompanyId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Brand--"
                                  OnValueChanged="OnBrandSelected" />
                        <ValidationMessage For="@(() => productModel.MakeCompanyId)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <DropDown TItem="CategoryModel"
                                  Items="@categories"
                                  SelectedId="@productModel.CategoryId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Category --"
                                  OnValueChanged="OnCategorySelected" />
                        <ValidationMessage For="@(() => productModel.CategoryId)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Unit <span class="text-danger">*</span></label>
                        <DropDown TItem="UnitModel"
                                  Items="@Units"
                                  SelectedId="@productModel.UnitId"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="-- Select Unit --"
                                  OnValueChanged="OnUnitSelected" />
                        <ValidationMessage For="@(() => productModel.UnitId)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3 position-relative">
                        <label class="form-label">Colour <span class="text-danger">*</span></label>

                        <SearchableDropdown TItem="ColourModel"
                                            Items="@Colours"
                                            ItemTextSelector="@(c => c.Name)"
                                            SelectedText="@productModel.ColourSearchText"
                                            Placeholder="Search Colour..."
                                            OnItemSelected="OnColourSelected"
                                            IsRequired="true"
                                            ShowValidationMessage="true" />

                        <ValidationMessage For="@(() => productModel.ColourId)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>
                        <InputNumber class="form-control" @bind-Value="productModel.Price" />
                        <ValidationMessage For="@(() => productModel.Price)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">MRP</label>
                        <InputNumber class="form-control" @bind-Value="productModel.MRP" />
                        <ValidationMessage For="@(() => productModel.MRP)" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label font-weight-bold">Product Images</label>
                        <InputFile class="form-control mb-2" OnChange="HandleFilesSelected" accept=".jpg,.jpeg,.png,.webp" multiple />
                        @if (isUploadingImage)
                        {
                            <div class="mb-2 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Uploading image(s)...</div>
                        }

                        @{
                            var activeImages = productModel.Images?.Where(i => !i.IsMarkedForDeletion).OrderBy(i => i.DisplayOrder).ToList() ?? new List<ImageMapperModel>();
                        }

                        @if (activeImages.Any())
                        {
                            if (currentSlideIndex >= activeImages.Count)
                            {
                                currentSlideIndex = Math.Max(0, activeImages.Count - 1);
                            }

                            var currentImg = activeImages[currentSlideIndex];
                            var imgSrc = !string.IsNullOrEmpty(currentImg.PreviewBase64) ? currentImg.PreviewBase64 : currentImg.ImagePath;

                            <!-- Image Slider Component -->
                            <div class="card overflow-hidden shadow-sm position-relative border-0 rounded-3 bg-dark text-white mt-2" style="min-height: 260px;">
                                <!-- Main Image Box -->
                                <div class="d-flex justify-content-center align-items-center position-relative p-2" style="height: 230px; background-color: #1e1e1e; cursor: pointer;" @onclick="() => OpenImagePreviewModal(currentSlideIndex)">
                                    <img src="@imgSrc" alt="Product Image" style="max-height: 215px; max-width: 100%; object-fit: contain; transition: transform 0.2s ease;" />
                                    
                                    @if (currentSlideIndex == 0)
                                    {
                                        <span class="badge bg-primary position-absolute top-0 start-0 m-2 shadow" style="font-size: 11px;">Primary Image (#1)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 start-0 m-2 shadow" style="font-size: 11px;">Image #@(currentSlideIndex + 1)</span>
                                    }

                                    <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2" style="font-size: 10px;">
                                        <Icon Name="IconName.ArrowsAngleExpand" /> Click to enlarge
                                    </span>
                                </div>

                                <!-- Navigation Arrows -->
                                @if (activeImages.Count > 1)
                                {
                                    <button type="button" class="btn btn-dark btn-sm position-absolute top-50 start-0 translate-middle-y ms-2 opacity-75 rounded-circle shadow"
                                            style="width: 36px; height: 36px; z-index: 10;"
                                            disabled="@(currentSlideIndex == 0)"
                                            @onclick="PrevSlide" @onclick:stopPropagation="true">
                                        ◀
                                    </button>
                                    <button type="button" class="btn btn-dark btn-sm position-absolute top-50 end-0 translate-middle-y me-2 opacity-75 rounded-circle shadow"
                                            style="width: 36px; height: 36px; z-index: 10;"
                                            disabled="@(currentSlideIndex == activeImages.Count - 1)"
                                            @onclick="NextSlide" @onclick:stopPropagation="true">
                                        ▶
                                    </button>
                                }

                                <!-- Control Bar (Reorder buttons + Dots + Delete) -->
                                <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-dark border-top border-secondary text-white">
                                    <!-- Index Change / Reorder Buttons -->
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-light btn-sm" disabled="@(currentSlideIndex == 0)" @onclick="() => MoveImageUp(currentImg)" title="Move Left / Decrease Index">
                                            ◀ Move Left
                                        </button>
                                        <button type="button" class="btn btn-outline-light btn-sm" disabled="@(currentSlideIndex == activeImages.Count - 1)" @onclick="() => MoveImageDown(currentImg)" title="Move Right / Increase Index">
                                            Move Right ▶
                                        </button>
                                    </div>

                                    <!-- Slider Dot Indicators -->
                                    <div class="d-flex align-items-center gap-1 bg-black bg-opacity-50 px-3 py-1 rounded-pill">
                                        @for (int i = 0; i < activeImages.Count; i++)
                                        {
                                            var dotIndex = i;
                                            <button type="button" class="btn p-0 border-0 @(dotIndex == currentSlideIndex ? "bg-light" : "bg-secondary") opacity-75 rounded-pill"
                                                    style="width: @(dotIndex == currentSlideIndex ? "18px" : "8px"); height: 8px; transition: all 0.3s ease;"
                                                    @onclick="() => GoToSlide(dotIndex)">
                                            </button>
                                        }
                                    </div>

                                    <!-- Delete Button -->
                                    <button type="button" class="btn btn-sm btn-danger d-flex align-items-center gap-1" @onclick="() => RemoveImageItem(currentImg)">
                                        <Icon Name="IconName.Trash" /> Delete
                                    </button>
                                </div>
                            </div>

                            <!-- Thumbnail Gallery Row -->
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @for (int i = 0; i < activeImages.Count; i++)
                                {
                                    var idx = i;
                                    var thumbImg = activeImages[idx];
                                    var thumbSrc = !string.IsNullOrEmpty(thumbImg.PreviewBase64) ? thumbImg.PreviewBase64 : thumbImg.ImagePath;

                                    <div class="position-relative cursor-pointer rounded overflow-hidden @(idx == currentSlideIndex ? "border border-2 border-primary shadow" : "border border-secondary opacity-75")"
                                         style="width: 55px; height: 55px; background: #f8f9fa;"
                                         @onclick="() => GoToSlide(idx)">
                                        <img src="@thumbSrc" alt="Thumb" style="width: 100%; height: 100%; object-fit: cover;" />
                                        @if (idx == 0)
                                        {
                                            <span class="badge bg-primary position-absolute top-0 start-0 m-0" style="font-size: 7px; padding: 1px 3px;">1st</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" maxlength="1000" @bind-Value="productModel.Description" />
                    <ValidationMessage For="@(() => productModel.Description)" />
                </div>

                @if (productModel.Id > 0)
                {
                    <div class="mb-3">
                        <InputCheckbox @bind-Value="productModel.IsActive" /> Active
                    </div>
                }
                <div class="text-end">
                    <Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
                    <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">Save</Button>
                </div>
            </EditForm>
        </BodyTemplate>
    </Modal>

    <Modal @ref="imagePreviewModal" Title="Product Image Viewer" Size="ModalSize.Large">
        <BodyTemplate>
            @{
                var activeImagesModal = productModel.Images?.Where(i => !i.IsMarkedForDeletion).OrderBy(i => i.DisplayOrder).ToList() ?? new List<ImageMapperModel>();
            }
            @if (activeImagesModal.Any())
            {
                if (currentSlideIndex >= activeImagesModal.Count)
                {
                    currentSlideIndex = Math.Max(0, activeImagesModal.Count - 1);
                }
                var currentImg = activeImagesModal[currentSlideIndex];
                var imgSrc = !string.IsNullOrEmpty(currentImg.PreviewBase64) ? currentImg.PreviewBase64 : currentImg.ImagePath;

                <div class="text-center position-relative bg-dark p-3 rounded-3" style="min-height: 380px;">
                    <img src="@imgSrc" alt="Product Image Full" style="max-height: 480px; max-width: 100%; object-fit: contain;" />

                    @if (activeImagesModal.Count > 1)
                    {
                        <button type="button" class="btn btn-dark btn-sm position-absolute top-50 start-0 translate-middle-y ms-3 opacity-75 rounded-circle shadow"
                                style="width: 42px; height: 42px; font-size: 18px;"
                                disabled="@(currentSlideIndex == 0)"
                                @onclick="PrevSlide">
                            ◀
                        </button>
                        <button type="button" class="btn btn-dark btn-sm position-absolute top-50 end-0 translate-middle-y me-3 opacity-75 rounded-circle shadow"
                                style="width: 42px; height: 42px; font-size: 18px;"
                                disabled="@(currentSlideIndex == activeImagesModal.Count - 1)"
                                @onclick="NextSlide">
                            ▶
                        </button>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary text-white">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-light" disabled="@(currentSlideIndex == 0)" @onclick="() => MoveImageUp(currentImg)">
                                ◀ Move Left
                            </button>
                            <button type="button" class="btn btn-outline-light" disabled="@(currentSlideIndex == activeImagesModal.Count - 1)" @onclick="() => MoveImageDown(currentImg)">
                                Move Right ▶
                            </button>
                        </div>

                        <!-- Dots -->
                        <div class="d-flex align-items-center gap-1 bg-black bg-opacity-50 px-3 py-1 rounded-pill">
                            @for (int i = 0; i < activeImagesModal.Count; i++)
                            {
                                var dotIndex = i;
                                <button type="button" class="btn p-0 border-0 @(dotIndex == currentSlideIndex ? "bg-light" : "bg-secondary") rounded-pill"
                                        style="width: @(dotIndex == currentSlideIndex ? "18px" : "8px"); height: 8px; transition: all 0.3s ease;"
                                        @onclick="() => GoToSlide(dotIndex)">
                                </button>
                            }
                        </div>

                        <button type="button" class="btn btn-sm btn-danger d-flex align-items-center gap-1" @onclick="() => DeleteCurrentSlideFromModal(currentImg)">
                            <Icon Name="IconName.Trash" /> Delete
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">No images to display</div>
            }
        </BodyTemplate>
    </Modal>
}
@code {
    private Modal modal = default!;
    private Modal imagePreviewModal = default!;
    private int currentSlideIndex = 0;
    private List<ProductModel> products = new();
    private List<CategoryModel> categories = new();
    private List<CompanyModel> companies = new();
    private List<ColourModel> Colours = new();
    private ProductModel productModel = new();
    private Grid<ProductModel> productGrid;
    private bool isLoading = true;
    private string modalTitle = "Add Product";
    private bool isEditMode = false;
    private EditContext editContext;
    private ValidationMessageStore messageStore;
    private List<UnitModel> Units => CommonUtils.UnitList;
    private string Route = "/products";
    private bool isSaveBtnLoading = false;
    private bool isExporting = false;
    private string? alertMessage;
    private string alertType = "info";
    private bool isUploadingImage = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (!IsAuthenticated)
        {
            NavigationManager.NavigateTo("/logout", forceLoad: true);
            return;
        }

        await LoadData();
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(productModel);
        messageStore = new ValidationMessageStore(editContext);
    }

    private async Task LoadData()
    {
        isLoading = true;
        products = (await ProductService.GetAllProductsAsync()).ToList();
        categories = (await CategoryService.GetAllCategoriesAsync()).Where(x => x.IsActive).ToList();
        companies = (await CompanyService.GetCompaniesByTypeAsync(CompanyType.MakeTo)).Where(x => x.IsActive).ToList();
        Colours = (await ColourService.GetAllColourAsync()).Where(x => x.IsActive).ToList();
        foreach (var product in products)
        {
            product.CategoryName = categories.FirstOrDefault(c => c.Id == product.CategoryId)?.Name ?? string.Empty;
        }
        isLoading = false;
    }

    private void ShowAddModal()
    {
        modalTitle = "Add Product";
        isEditMode = false;
        currentSlideIndex = 0;
        productModel = new ProductModel
        {
            IsActive = true,
            CreatedBy = Convert.ToInt32(CurrentUserId),
            CreatedOn = DateTime.Now,
            UnitId = (int)UnitType.PCS,
            Images = new List<ImageMapperModel>()
        };
        InitializeEditContext();
        modal.ShowAsync();
    }

    private void ShowEditModal(ProductModel editProduct)
    {
        modalTitle = "Edit Product";
        isEditMode = true;
        currentSlideIndex = 0;

        productModel = new ProductModel
        {
            Id = editProduct.Id,
            SKU = editProduct.SKU,
            Name = editProduct.Name.Trim(),
            Description = editProduct.Description,
            Price = editProduct.Price,
            MRP = editProduct.MRP,
            CategoryId = editProduct.CategoryId,
            CategoryName = editProduct.CategoryName,
            Unit = editProduct.Unit,
            UnitId = editProduct.UnitId,
            IsActive = editProduct.IsActive,
            MakeCompanyId = editProduct.MakeCompanyId,
            MakeCompany = editProduct.MakeCompany,
            SerialNumber = editProduct.SerialNumber,
            ColourId = editProduct.ColourId,
            ColourName = editProduct.ColourName,
            ColourSearchText = editProduct.ColourName,
            Images = editProduct.Images != null
                ? editProduct.Images.Select(img => new ImageMapperModel
                {
                    Id = img.Id,
                    ItemId = img.ItemId,
                    Type = img.Type,
                    ImagePath = img.ImagePath,
                    DisplayOrder = img.DisplayOrder,
                    IsActive = img.IsActive,
                    IsDeleted = img.IsDeleted
                }).OrderBy(i => i.DisplayOrder).ToList()
                : new List<ImageMapperModel>(),
            UpdatedBy = Convert.ToInt32(CurrentUserId),
            UpdatedOn = DateTime.Now
        };
        InitializeEditContext();
        modal.ShowAsync();
    }

    private async Task SaveProduct()
    {
        if (isSaveBtnLoading) return;
        try
        {
            isSaveBtnLoading = true;
            if (!editContext.Validate()) return;
            await HandleAllFieldsAsync();
            if (editContext.GetValidationMessages().Any())
                return;
            await ValidateDuplicateNameAsync();
            if (editContext.GetValidationMessages().Any())
                return;

            productModel.Unit = Units.FirstOrDefault(u => u.Id == productModel.UnitId)?.Name ?? string.Empty;
            productModel.MakeCompany = companies.FirstOrDefault(m => m.Id == productModel.MakeCompanyId)?.Name ?? string.Empty;
            productModel.CategoryName = categories.FirstOrDefault(c => c.Id == productModel.CategoryId)?.Name ?? string.Empty;
            productModel.ColourName = Colours.FirstOrDefault(c => c.Id == productModel.ColourId)?.Name ?? string.Empty;

            // Save new physical files
            foreach (var img in productModel.Images.Where(i => !i.IsMarkedForDeletion && i.CompressedBytes != null))
            {
                var savedPath = await SaveProductFileAsync(img.CompressedBytes);
                if (savedPath != null)
                {
                    img.ImagePath = savedPath;
                    img.CompressedBytes = null;
                }
            }

            // Delete physical files of removed images
            foreach (var img in productModel.Images.Where(i => i.IsMarkedForDeletion && !string.IsNullOrEmpty(i.ImagePath)))
            {
                DeletePhysicalImage(img.ImagePath);
            }

            if (isEditMode)
            {
                await ProductService.UpdateProductAsync(productModel);
            }
            else
            {
                await ProductService.CreateProductAsync(productModel);
            }

            await HideModal();
            await LoadData();
            await productGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to save product: {ex.Message}");
        }
        finally
        {
            isSaveBtnLoading = false;
        }
    }

    private async Task DeleteProduct(int id)
    {
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm", "Do you really want to delete this product?");
            if (!confirmed) return;

            var userid = Convert.ToInt32(CurrentUserId);
            var product = products.FirstOrDefault(p => p.Id == id);
            if (product != null && product.Images != null && product.Images.Any())
            {
                foreach (var img in product.Images)
                {
                    if (!string.IsNullOrEmpty(img.ImagePath))
                        DeletePhysicalImage(img.ImagePath);
                }
            }

            await ProductService.DeleteProductAsync(id, userid);
            await LoadData();
            await productGrid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to delete product: {ex.Message}");
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var files = e.GetMultipleFiles(10);
        if (files != null && files.Count > 0)
        {
            try
            {
                isUploadingImage = true;
                StateHasChanged();

                foreach (var file in files)
                {
                    var extension = Path.GetExtension(file.Name).ToLower();
                    if (!allowedExtensions.Contains(extension))
                    {
                        ShowAlert("danger", $"File '{file.Name}' is not allowed. Only JPG, JPEG, PNG, and WEBP files are allowed.");
                        continue;
                    }

                    if (file.Size > 5 * 1024 * 1024)
                    {
                        ShowAlert("danger", $"File '{file.Name}' exceeds 5MB limit.");
                        continue;
                    }

                    using var ms = new MemoryStream();
                    await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
                    var bytes = ms.ToArray();

                    // Commented out image compression code as requested by user:
                    // using (var stream = file.OpenReadStream(5 * 1024 * 1024))
                    // using (var streamRef = new Microsoft.JSInterop.DotNetStreamReference(stream))
                    // {
                    //     var compressedBase64 = await JS.InvokeAsync<string>("compressImage", streamRef, file.ContentType, 1024, 1024, 0.75);
                    //     var base64Data = compressedBase64.Substring(compressedBase64.IndexOf(",") + 1);
                    //     var bytes = Convert.FromBase64String(base64Data);
                    // }

                    var previewBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";

                    var activeCount = productModel.Images.Count(i => !i.IsMarkedForDeletion);
                    var imageItem = new ImageMapperModel
                    {
                        Id = 0,
                        Type = "Product",
                        PreviewBase64 = previewBase64,
                        CompressedBytes = bytes,
                        DisplayOrder = activeCount + 1,
                        IsNew = true
                    };
                    productModel.Images.Add(imageItem);
                }

                ReassignDisplayOrders();

                var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).ToList();
                if (activeImages.Any())
                {
                    currentSlideIndex = activeImages.Count - 1;
                }
            }
            catch (Exception ex)
            {
                ShowAlert("danger", $"Failed to process uploaded images: {ex.Message}");
            }
            finally
            {
                isUploadingImage = false;
                StateHasChanged();
            }
        }
    }

    private void RemoveImageItem(ImageMapperModel img)
    {
        if (img.Id > 0)
        {
            img.IsMarkedForDeletion = true;
        }
        else
        {
            productModel.Images.Remove(img);
        }
        ReassignDisplayOrders();
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).ToList();
        if (currentSlideIndex >= activeImages.Count)
        {
            currentSlideIndex = Math.Max(0, activeImages.Count - 1);
        }
        StateHasChanged();
    }

    private void MoveImageUp(ImageMapperModel img)
    {
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).OrderBy(i => i.DisplayOrder).ToList();
        int idx = activeImages.IndexOf(img);
        if (idx > 0)
        {
            var prev = activeImages[idx - 1];
            int temp = img.DisplayOrder;
            img.DisplayOrder = prev.DisplayOrder;
            prev.DisplayOrder = temp;
            ReassignDisplayOrders();
            currentSlideIndex = idx - 1;
            StateHasChanged();
        }
    }

    private void MoveImageDown(ImageMapperModel img)
    {
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).OrderBy(i => i.DisplayOrder).ToList();
        int idx = activeImages.IndexOf(img);
        if (idx >= 0 && idx < activeImages.Count - 1)
        {
            var next = activeImages[idx + 1];
            int temp = img.DisplayOrder;
            img.DisplayOrder = next.DisplayOrder;
            next.DisplayOrder = temp;
            ReassignDisplayOrders();
            currentSlideIndex = idx + 1;
            StateHasChanged();
        }
    }

    private void GoToSlide(int index)
    {
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).ToList();
        if (index >= 0 && index < activeImages.Count)
        {
            currentSlideIndex = index;
            StateHasChanged();
        }
    }

    private void PrevSlide()
    {
        if (currentSlideIndex > 0)
        {
            currentSlideIndex--;
            StateHasChanged();
        }
    }

    private void NextSlide()
    {
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).ToList();
        if (currentSlideIndex < activeImages.Count - 1)
        {
            currentSlideIndex++;
            StateHasChanged();
        }
    }

    private async Task OpenImagePreviewModal(int index)
    {
        currentSlideIndex = index;
        if (imagePreviewModal != null)
        {
            await imagePreviewModal.ShowAsync();
        }
    }

    private async Task DeleteCurrentSlideFromModal(ImageMapperModel img)
    {
        RemoveImageItem(img);
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).ToList();
        if (!activeImages.Any() && imagePreviewModal != null)
        {
            await imagePreviewModal.HideAsync();
        }
    }

    private void ReassignDisplayOrders()
    {
        var activeImages = productModel.Images.Where(i => !i.IsMarkedForDeletion).OrderBy(i => i.DisplayOrder).ToList();
        for (int i = 0; i < activeImages.Count; i++)
        {
            activeImages[i].DisplayOrder = i + 1;
        }
    }

    private async Task<string?> SaveProductFileAsync(byte[] bytes)
    {
        try
        {
            var uploadsDir = Path.Combine(WebHostEnvironment.WebRootPath, "images", "products");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var uniqueFileName = $"{DateTime.Now:ddMMyyyy_HHmmss}_{Guid.NewGuid().ToString("N")[..6]}.jpg";
            var filePath = Path.Combine(uploadsDir, uniqueFileName);

            await File.WriteAllBytesAsync(filePath, bytes);
            return $"/images/products/{uniqueFileName}";
        }
        catch (Exception ex)
        {
            ShowAlert("danger", $"Failed to save image file: {ex.Message}");
            return null;
        }
    }

    private void DeletePhysicalImage(string relativePath)
    {
        try
        {
            var absolutePath = Path.Combine(WebHostEnvironment.WebRootPath, relativePath.TrimStart('/'));
            if (File.Exists(absolutePath))
            {
                File.Delete(absolutePath);
            }
        }
        catch (Exception)
        {
            // Ignore deletion errors
        }
    }

