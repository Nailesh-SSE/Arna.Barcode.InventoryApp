@using InventoryManagement.Services.Auth
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage Storage
@inject NavigationManager NavigationManager

<PageTitle>Access Denied</PageTitle>

@if (sessionChecked && hasSession)
{
    <div class="container text-center mt-5">
        <h1 class="text-danger">Access Denied</h1>
        <p>You do not have permission to access this page.</p>

        <Button Color="ButtonColor.Primary" @onclick="GoHome">
            Go to Home
        </Button>
    </div>
}

@code {
    private const string SessionKey = "UserAuth";
    private bool sessionChecked;
    private bool hasSession;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var session = await Storage.GetAsync<AuthData>(SessionKey);

            hasSession = session.Success &&
                         session.Value?.IsAuthenticated == true;

            if (!hasSession)
            {
                NavigationManager.NavigateTo(
                    "/logout",
                    replace: true);

                return;
            }
        }
        catch
        {
            NavigationManager.NavigateTo(
                "/logout",
                replace: true);

            return;
        }

        sessionChecked = true;
        await InvokeAsync(StateHasChanged);
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}