@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

<div class="page">
    <div class="sidebar @(isCollapsed ? "collapsed" : "")">
        <NavMenu />
    </div>

    <main class="@(isCollapsed ? "expanded" : "")">
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <button class="navbar-toggler-main" @onclick="ToggleSidebar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="breadcrumb-container">
            </div>
            <div class="user-menu-container">
                <SimpleUserMenu />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div class="sidebar-overlay @(isCollapsed ? "" : "show")" @onclick="ToggleSidebar"></div>

@code {
    private bool isCollapsed = false;
    private Task<AuthenticationState>? _lastAuthStateTask;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            // Redirect to login page with force reload
            Navigation.NavigateTo("/login");
        }
        // Optionally, you can force a UI refresh here if needed
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (await IsMobileAsync())
            {
                isCollapsed = true;
                StateHasChanged();
            }
        }
    }
        
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (await IsMobileAsync())
        {
            isCollapsed = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> IsMobileAsync()
    {
        return await JS.InvokeAsync<bool>(
            "eval",
            "window.innerWidth <= 640"
        );
    }

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
